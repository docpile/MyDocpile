; Best practice additional settings for the cloud execution. 
; These settings only extend the default ones you already have in your php.ini

expose_php = off
mail.mixed_lf_and_crlf = Off
max_execution_time = 3600
max_file_uploads = 20
max_input_time = 3600
opcache.huge_code_pages=1
opcache.interned_strings_buffer=64
opcache.jit=1254
opcache.jit_buffer_size=32M
opcache.max_accelerated_files=1000
opcache.max_wasted_percentage=15
opcache.memory_consumption=128
opcache.revalidate_path=0

; Best practice: Use a dir on the very same partition as the actual data storage. Everything else is dramatically slower, including "/tmp/"
upload_tmp_dir = "/home/mydocpile/temp"

; First add your webroot. Then, the path of the app, and all paths used for the cloud data, and also the upload_tmp_dir path
open_basedir = "/var/www/vhosts/example.com/:/tmp/:/var/lib/mydocpile:/home/mydocpile:/dev/shm"

; You might change these according to your needs and your hardware
memory_limit = 4096M
post_max_size = 3G
upload_max_filesize = 3G
