# These are the necessary settings for the onlyoffice server. 
# Add them to your current settings.
# Edit the port if needed

# 1. Simulate the global 'map' directive for WebSockets inside the server block
    set $connection_upgrade "upgrade";
    if ($http_upgrade = "") {
        set $connection_upgrade "close";
    }

# 2. Block the Root path (which normally redirects to /welcome)
    location = / {
        return 444;
    }

    # 2. Block the Welcome page directory
    location ^~ /welcome/ {
        return 404;
    }

    # 3. Block the Test Example suite (just in case it was left enabled)
    location ^~ /example/ {
        return 404;
    }
    
    # 4. Block the info panel
    location = /info.json {
        return 404;
    }
	
	# 5. Block the favicon
    location = /favicon.ico {
        return 404;
        log_not_found off;
        access_log off;
    }

    # 3. Main Proxy Location
    location / {
        # Point directly to the Docker container port (replacing the 'upstream' block)
        proxy_pass http://127.0.0.1:8380;
        proxy_http_version 1.1;

        # Disable buffering to allow real-time WebSocket frames to pass instantly
        proxy_buffering off;

        # STRICT WEBSOCKET FORWARDING
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # X-FORWARDED HEADERS (Crucial for ONLYOFFICE to know its public URL)
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;

        # EXTENDED TIMEOUTS
        # Prevents 504 Gateway Timeouts during massive document saves or long-polling
        proxy_read_timeout 3600s;
        proxy_connect_timeout 3600s;
        proxy_send_timeout 3600s;
    }