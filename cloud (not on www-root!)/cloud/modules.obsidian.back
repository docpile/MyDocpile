<?php
/**
 * ============================================================================
 * MODULE: Obsidian Vault & Zero-Trust WYSIWYG / Code Editor Engine
 * ============================================================================
 * Features:
 * - O(1) Vault root lookup (zero lag on folder navigation)
 * - Hides .md extensions inside Obsidian vaults
 * - Strict on-demand lazy loading of /script/obsidian_edit/* libraries
 * - Zero-Trust HTML Sanitizer + Shadow DOM encapsulation (prevents CSS/DOM bleed & XSS)
 * - Clean HTML tag unwrapping when resetting font size, color, or highlight to default
 * - Two-line structured rubber toolbar (Row 1: Nav/Undo/Insert, Row 2: Styles)
 * - Instant modern floating tooltips & scroll hint indicators for mobile/tablet
 * - Formatting-agnostic Find & Replace across styled DOM nodes
 * - Server-proxied CSP-safe Translation popup & external Google Search
 * 
 * THIS IS PART OF THE PSEUDO "JS FILE" - NO PHP CODE IN THIS FILE!
 */
?>
<script>
window.myCloudObsidian = {

    vaults: new Set(),

    resetState: function() {
        this.hideInstantTooltip();
        this.abortPendingFetches();
        clearTimeout(this.idleSaveTimer);
        clearTimeout(this.forceSaveTimer);
        this.idleSaveTimer = null;
        this.forceSaveTimer = null;

        if (this._colorSaveTimers) {
            Object.values(this._colorSaveTimers).forEach(t => clearTimeout(t));
            this._colorSaveTimers = {};
        }

        if (this.blobCache) {
            Object.values(this.blobCache).forEach(url => {
                if (typeof url === 'string' && url.startsWith('blob:')) {
                    try { URL.revokeObjectURL(url); } catch (e) {}
                }
            });
        }

        this.vaults = new Set();
		this.vaultNames = {};
        this.pluginConfigs = {};
        this.blobCache = {};
        this.activeFile = null;
        this.activeContent = '';
        this.originalContent = '';
        this.frontmatterRaw = '';
        this.isDirty = false;
        this.shadowRoot = null;
        this.treeAutoHidden = false;
        this.noteHistory = [];
        this.noteHistoryIdx = -1;
        this._isHistoryNav = false;
        this._vaultFullLoaded = new Set();
        this._wikiSelectedIndex = 0;
    },

    getTargetDirForNoteAttachments: function(destNoteDir) {
        const vaultRoot = this.getVaultRoot(destNoteDir) || this.getVaultRoot(myCloudState.currentDir) || '/';
        const appCfg = this.getAppConfig(destNoteDir) || this.getAppConfig(vaultRoot) || {};
        const rawSetting = (appCfg.attachmentFolderPath !== undefined) ? String(appCfg.attachmentFolderPath).trim() : './z_attachments';

        if (rawSetting === '' || rawSetting === '/') {
            return { targetDir: vaultRoot, parentToCreateIn: null, folderToCreate: null };
        }
        if (rawSetting === '.' || rawSetting === './') {
            return { targetDir: destNoteDir, parentToCreateIn: null, folderToCreate: null };
        }
        if (rawSetting.startsWith('./')) {
            const subName = rawSetting.substring(2).replace(/^\/+|\/+$/g, '');
            const targetDir = (destNoteDir === '/' ? '' : destNoteDir) + '/' + subName;
            return { targetDir, parentToCreateIn: destNoteDir, folderToCreate: subName };
        }
        const cleanRel = rawSetting.replace(/^\/+|\/+$/g, '');
        const targetDir = (vaultRoot === '/' ? '' : vaultRoot) + '/' + cleanRel;
        const lastSlash = targetDir.lastIndexOf('/');
        const parentToCreateIn = targetDir.substring(0, lastSlash) || '/';
        const folderToCreate = targetDir.substring(lastSlash + 1);
        return { targetDir, parentToCreateIn, folderToCreate };
    },

    fetchPlainNoteContent: async function(notePath) {
        try {
            const isEnc = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(notePath);
            if (isEnc) {
                const root = myCloudCrypto.getCryptoRoot(notePath);
                if (!myCloudCrypto.isDirUnlocked(root)) return '';
                const fd = new URLSearchParams({
                    myCloud_action: 'get_download_token',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: notePath,
                    filename: notePath.split('/').pop(),
                    preview: '0'
                });
                const tRes = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                if (tRes.status === 'OK') {
                    const encBlob = await fetch('?myCloud_token=' + tRes.token).then(r => r.blob());
                    const decBlob = await myCloudCrypto.decryptFile(root, encBlob);
                    return await decBlob.text();
                }
            } else {
                const fd = new URLSearchParams({
                    myCloud_action: 'edit-fetch',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: notePath
                });
                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                if (res.status === 'OK' && res.content) return res.content;
            }
        } catch (e) {}
        return '';
    },

    findActualAttachmentItem: async function(resolvedCandidatePath, plainFileName) {
        let item = (myCloudState.allItems || []).find(i => i.name === resolvedCandidatePath);
        if (item) return item.name;

        const parentDir = resolvedCandidatePath.substring(0, resolvedCandidatePath.lastIndexOf('/')) || '/';
        if (!myCloudState.loadedDirs.includes(parentDir) && typeof myCloudFetchDirectory === 'function') {
            await myCloudFetchDirectory(parentDir, 1, true);
        }
        item = (myCloudState.allItems || []).find(i => i.name === resolvedCandidatePath);
        if (item) return item.name;

        const matchEnc = (myCloudState.allItems || []).find(i => {
            const p = i.name.substring(0, i.name.lastIndexOf('/')) || '/';
            if (p !== parentDir) return false;
            const dName = i.displayName || (myCloudState.pathNames && myCloudState.pathNames[i.name]) || i.name.split('/').pop().replace(/\.enc$/, '');
            return dName === plainFileName;
        });
        return matchEnc ? matchEnc.name : null;
    },

    prepareAttachmentsForAction: async function(action, notePaths, currentDir, targetDir) {
        if (!['delete', 'move', 'copy'].includes(action)) return { deletePaths: [], executeTransfer: null };
        const vaultRoot = this.getVaultRoot(currentDir);
        if (!vaultRoot) return { deletePaths: [], executeTransfer: null };

        if (targetDir && this.isDirInVault(targetDir)) {
            await this.loadVaultPlugins(this.getVaultRoot(targetDir));
        }
        await this.loadVaultPlugins(vaultRoot);

        const attachmentsMap = new Map();

        for (let path of notePaths) {
            const dName = (myCloudState.pathNames && myCloudState.pathNames[path]) ? myCloudState.pathNames[path] : path.split('/').pop().replace(/\.enc$/, '');
            if (!dName.toLowerCase().endsWith('.md')) continue;

            const content = await this.fetchPlainNoteContent(path);
            if (!content) continue;

            const regex1 = /!\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|[^\]]+)?\]\]/g;
            const regex2 = /!?\[[^\]]*\]\(([^)]+)\)/g;
            let m;
            const rawLinks = [];
            while ((m = regex1.exec(content)) !== null) rawLinks.push(m[1].trim());
            while ((m = regex2.exec(content)) !== null) {
                const link = m[1].trim();
                if (!link.startsWith('http://') && !link.startsWith('https://') && !link.startsWith('#') && !link.startsWith('mailto:')) {
                    rawLinks.push(link);
                }
            }

            for (let rawLink of rawLinks) {
                const candidate = this.resolveAttachmentPath(rawLink, path);
                const plainBase = rawLink.split('/').pop();
                const actualPath = await this.findActualAttachmentItem(candidate, plainBase);
                if (actualPath && !notePaths.includes(actualPath)) {
                    attachmentsMap.set(actualPath, plainBase);
                }
            }
        }

        if (attachmentsMap.size === 0) return { deletePaths: [], executeTransfer: null };

        const usedElsewhere = new Set();
        if (action === 'delete' || action === 'move') {
            const otherNotes = (myCloudState.allItems || []).filter(i => {
                if (i.size === 'DIR' || notePaths.includes(i.name)) return false;
                if (!i.name.startsWith(vaultRoot === '/' ? '/' : vaultRoot + '/')) return false;
                const nName = (i.displayName || (myCloudState.pathNames && myCloudState.pathNames[i.name]) || i.name.split('/').pop()).replace(/\.enc$/, '');
                return nName.toLowerCase().endsWith('.md');
            });

            for (let note of otherNotes) {
                const c = await this.fetchPlainNoteContent(note.name);
                if (!c) continue;
                for (let [attPath, plainName] of attachmentsMap.entries()) {
                    if (c.includes(plainName)) {
                        usedElsewhere.add(attPath);
                    }
                }
                if (usedElsewhere.size === attachmentsMap.size) break;
            }
        }

        if (action === 'delete') {
            const safeToDelete = Array.from(attachmentsMap.keys()).filter(k => !usedElsewhere.has(k));
            return { deletePaths: safeToDelete, executeTransfer: null };
        }

        const { targetDir: destAttDir, parentToCreateIn, folderToCreate } = this.getTargetDirForNoteAttachments(targetDir);

        const executeTransfer = async (preserveRights = true) => {
            if (parentToCreateIn && folderToCreate) {
                let finalFolderName = folderToCreate;
                const isEncDest = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(parentToCreateIn);
                if (isEncDest && myCloudCrypto.isDirUnlocked(parentToCreateIn)) {
                    await myCloudFetchDirectory(parentToCreateIn, 1, true);
                    const existingFolder = (myCloudState.allItems || []).find(i => {
                        if (i.size !== 'DIR') return false;
                        const p = i.name.substring(0, i.name.lastIndexOf('/')) || '/';
                        if (p !== parentToCreateIn) return false;
                        const dN = i.displayName || (myCloudState.pathNames && myCloudState.pathNames[i.name]) || i.name.split('/').pop().replace(/\.enc$/, '');
                        return dN === folderToCreate;
                    });
                    if (existingFolder) {
                        finalFolderName = existingFolder.name.split('/').pop();
                    } else {
                        finalFolderName = await myCloudCrypto.encryptName(parentToCreateIn, folderToCreate);
                    }
                }
                const mkdirFd = new URLSearchParams({
                    myCloud_action: 'mkdir',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    parent: parentToCreateIn,
                    name: finalFolderName
                });
                await fetch('', { method: 'POST', body: mkdirFd }).catch(() => {});
            }

            const sourceRoot = typeof myCloudCrypto !== 'undefined' ? myCloudCrypto.getCryptoRoot(currentDir) : null;
            const targetRoot = typeof myCloudCrypto !== 'undefined' ? myCloudCrypto.getCryptoRoot(destAttDir) : null;
            const isCrossBoundary = (sourceRoot !== targetRoot);

            for (let [attPath, plainName] of attachmentsMap.entries()) {
                const currentAttParent = attPath.substring(0, attPath.lastIndexOf('/')) || '/';
                if (currentAttParent === destAttDir) continue;

                const effectiveOp = (action === 'move' && !usedElsewhere.has(attPath)) ? 'move' : 'copy';

                if (isCrossBoundary && typeof window.myCloudE2ETransfer === 'function') {
                    await window.myCloudE2ETransfer(attPath, destAttDir, effectiveOp, sourceRoot, targetRoot, plainName);
                } else {
                    const fd = new URLSearchParams({
                        myCloud_action: effectiveOp,
                        myCloud_key: myCloudState.key,
                        myCloud_token: window.myCloudCsrfToken || '',
                        src: attPath,
                        dest: destAttDir,
                        preserve_rights: preserveRights ? '1' : '0',
                        resolution: 'keep_both'
                    });
                    await fetch('', { method: 'POST', body: fd }).catch(() => {});
                }
            }
        };

        return { deletePaths: [], executeTransfer };
    },

    convertMarkdownInsideHTML: function(mdString) {
        let inHtml = 0;
        let result = '';
        const tagRegex = /<([a-zA-Z0-9\-]+)(?:\s+[^>]*)?>|<\/([a-zA-Z0-9\-]+)\s*>/gi;
        let lastIndex = 0;
        let match;
        
        while ((match = tagRegex.exec(mdString)) !== null) {
            let chunk = mdString.substring(lastIndex, match.index);
            if (inHtml > 0) {
                chunk = chunk
                    .replace(/\*\*([\s\S]*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*([\s\S]*?)\*/g, '<em>$1</em>')
                    .replace(/==([\s\S]*?)==/g, '<mark>$1</mark>')
                    .replace(/~~([\s\S]*?)~~/g, '<del>$1</del>');
            }
            result += chunk + match[0];
            if (match[0].startsWith('</')) {
                inHtml = Math.max(0, inHtml - 1);
            } else if (!match[0].endsWith('/>')) {
               inHtml++;
            }
            lastIndex = tagRegex.lastIndex;
        }
        let chunk = mdString.substring(lastIndex);
        if (inHtml > 0) {
            chunk = chunk
                .replace(/\*\*([\s\S]*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*([\s\S]*?)\*/g, '<em>$1</em>')
                .replace(/==([\s\S]*?)==/g, '<mark>$1</mark>')
                .replace(/~~([\s\S]*?)~~/g, '<del>$1</del>');
        }
        result += chunk;
        return result;
    },	
	
    activeFile: null,
    activeContent: '',
    originalContent: '',
    isDirty: false,
    viewMode: 'wysiwyg', // 'wysiwyg' or 'code'
    pluginConfigs: {},   // Cached per vaultRoot: { colors: {}, icons: {}, app: {} }
    blobCache: {},       // Cached decrypted/token URLs for attachments
    frontmatterRaw: '',  // Preserves YAML frontmatter during WYSIWYG editing
    lastTextColor: '#e81123',
    lastBgColor: '#fff3cd',
    zoomScale: parseFloat(localStorage.getItem('myCloudObsidianZoom')) || 1.0, // Text display zoom (0.5 to 2.5)
    treeAutoHidden: false, // Tracks if tree was auto-hidden on mobile/tablet when entering a note
    idleSaveTimer: null,
    forceSaveTimer: null,
    tipTimer: null,
    shadowRoot: null,    // Isolated Shadow DOM for zero-trust WYSIWYG rendering
    abortController: null, // Cancels in-flight note & attachment fetches when switching notes
    noteHistory: [],
    noteHistoryIdx: -1,
    _isHistoryNav: false,
    _vaultFullLoaded: new Set(),
    _wikiSelectedIndex: 0,

    L: function(key, fallback) {
        return (typeof myCloud_LANG !== 'undefined' && myCloud_LANG && myCloud_LANG[key]) ? myCloud_LANG[key] : fallback;
    },

    // ------------------------------------------------------------------------
    // 1. O(1) VAULT DETECTION & CACHED VAULT CONFIG (.obsidian/app.json)
    // ------------------------------------------------------------------------
    isDirInVault: function(dirPath) {
        if (!dirPath || this.vaults.size === 0) return false;
        return this.getVaultRoot(dirPath) !== null;
    },

    getVaultRoot: function(path) {
        if (!path || this.vaults.size === 0) return null;
        let bestMatch = null;
        for (let v of this.vaults) {
            if (v === '/' || path === v || path.startsWith(v + '/')) {
                if (!bestMatch || v.length > bestMatch.length) bestMatch = v;
            }
        }
        return bestMatch;
    },

    getAppConfig: function(path) {
        const vaultRoot = this.getVaultRoot(path || this.activeFile || myCloudState.currentDir);
        if (vaultRoot && this.pluginConfigs[vaultRoot] && this.pluginConfigs[vaultRoot].app) {
            return this.pluginConfigs[vaultRoot].app;
        }
        return {};
    },

    loadVaultPlugins: async function(vaultRoot) {
        if (!vaultRoot) return;
        if (this.pluginConfigs[vaultRoot] && this.pluginConfigs[vaultRoot]._loaded) return;
        if (this.pluginConfigs[vaultRoot] && this.pluginConfigs[vaultRoot]._loadingPromise) {
            return this.pluginConfigs[vaultRoot]._loadingPromise;
        }

        if (!this.pluginConfigs[vaultRoot]) {
            this.pluginConfigs[vaultRoot] = { icons: {}, app: {} };
        }

        const fetchJson = async (relPath) => {
            const fullPath = (vaultRoot === '/' ? '' : vaultRoot) + relPath;
            try {
                const fd = new URLSearchParams({
                    myCloud_action: 'edit-fetch',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: fullPath
                });
                const res = await fetch('', { method: 'POST', body: fd, priority: 'low' }).then(r => r.json());
                if (res.status === 'OK' && res.content) return JSON.parse(res.content);
            } catch (e) {}
            return null;
        };

        this.pluginConfigs[vaultRoot]._loadingPromise = (async () => {
            const cfg = this.pluginConfigs[vaultRoot];
            const hasIcons  = cfg.icons && Object.keys(cfg.icons).length > 0;
            const hasApp    = cfg.app && Object.keys(cfg.app).length > 0;
            const hasCloudColors = cfg._cloudColorsFetched === true;
			const hasHiddenFolders = cfg._hiddenFoldersFetched === true;

            const [iconData, appData, cloudColorData, hiddenData] = await Promise.all([
                hasIcons  ? Promise.resolve(cfg.icons)  : fetchJson('/.obsidian/plugins/obsidian-icon-folder/data.json'),
                hasApp    ? Promise.resolve(cfg.app)    : fetchJson('/.obsidian/app.json'),
                hasCloudColors ? Promise.resolve(null) : fetchJson('/.obsidian/cloud-colors.json'),
                hasHiddenFolders ? Promise.resolve(null) : fetchJson('/.obsidian/cloud-hidden-folders.json')
            ]);

            if (iconData)  cfg.icons  = iconData;
            if (appData)   cfg.app    = appData;
            if (!hasCloudColors) {
                cfg.cloudColors = Object.assign({}, cfg.cloudColors || {}, cloudColorData || {});
                if (Array.isArray(cfg.cloudColors._presets) && myCloudState.settings) {
                    const existingPresets = Array.isArray(myCloudState.settings.obsSavedColors) ? myCloudState.settings.obsSavedColors : [];
                    myCloudState.settings.obsSavedColors = Array.from(new Set([...existingPresets, ...cfg.cloudColors._presets]));
                }
                cfg._cloudColorsFetched = true;
            }
            if (!hasHiddenFolders) {
                cfg.hiddenFolders = Array.isArray(hiddenData) ? hiddenData : [];
                cfg._hiddenFoldersFetched = true;
            }
            cfg._loaded = true;
            delete cfg._loadingPromise;
        })();

        return this.pluginConfigs[vaultRoot]._loadingPromise;
    },

    queueCloudColorSave: function(vaultRoot) {
        if (!this._colorSaveTimers) this._colorSaveTimers = {};
        if (this._colorSaveTimers[vaultRoot]) clearTimeout(this._colorSaveTimers[vaultRoot]);
        this._colorSaveTimers[vaultRoot] = setTimeout(() => {
            if (!this.pluginConfigs[vaultRoot]) return;
            if (myCloudState.settings && Array.isArray(myCloudState.settings.obsSavedColors)) {
                this.pluginConfigs[vaultRoot].cloudColors._presets = myCloudState.settings.obsSavedColors;
            }
            const fd = new URLSearchParams({
                myCloud_action: 'edit-save',
                myCloud_key: myCloudState.key,
                myCloud_token: window.myCloudCsrfToken || '',
                path: (vaultRoot === '/' ? '' : vaultRoot) + '/.obsidian/cloud-colors.json',
                content: JSON.stringify(this.pluginConfigs[vaultRoot].cloudColors, null, 2)
            });
            fetch('', { method: 'POST', body: fd }).catch(()=>{});
        }, 1200);
    },

    getFolderColorStyles: function(baseHex, depth) {
        if (!baseHex || !baseHex.startsWith('#')) return null;
        let r = parseInt(baseHex.slice(1, 3), 16);
        let g = parseInt(baseHex.slice(3, 5), 16);
        let b = parseInt(baseHex.slice(5, 7), 16);

        const effectiveDepth = Math.min(Math.max(0, depth), 2);
        let lightenFactor = effectiveDepth * 0.26;
        r = Math.round(r + (255 - r) * lightenFactor);
        g = Math.round(g + (255 - g) * lightenFactor);
        b = Math.round(b + (255 - b) * lightenFactor);

        let yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
        let textColor = (yiq >= 135) ? '#151515' : '#ffffff';

        return { bg: `rgb(${r}, ${g}, ${b})`, text: textColor };
    },
	
    applyVaultRootStyles: function(liEl, vaultRoot) {
        if (!liEl || !vaultRoot) return;
        const appCfg = this.getAppConfig(vaultRoot);
        const hex = (appCfg && appCfg.vaultBgColor) ? appCfg.vaultBgColor : null;
        if (!hex || !/^#[0-9a-fA-F]{6}$/.test(hex)) {
            liEl.style.removeProperty('--vault-border');
            liEl.style.removeProperty('--vault-accent');
            liEl.style.removeProperty('--vault-bg-start');
            liEl.style.removeProperty('--vault-bg-end');
            liEl.style.removeProperty('--vault-dark-border');
            liEl.style.removeProperty('--vault-dark-bg-start');
            liEl.style.removeProperty('--vault-dark-bg-end');
            return;
        }
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        liEl.style.setProperty('--vault-accent', hex);
        liEl.style.setProperty('--vault-border', `rgba(${r}, ${g}, ${b}, 0.35)`);
        liEl.style.setProperty('--vault-bg-start', `rgba(${r}, ${g}, ${b}, 0.22)`);
        liEl.style.setProperty('--vault-bg-end', `rgba(${r}, ${g}, ${b}, 0.08)`);
        liEl.style.setProperty('--vault-dark-border', `rgba(${r}, ${g}, ${b}, 0.38)`);
        liEl.style.setProperty('--vault-dark-bg-start', `rgba(${r}, ${g}, ${b}, 0.16)`);
        liEl.style.setProperty('--vault-dark-bg-end', `rgba(${r}, ${g}, ${b}, 0.04)`);
    },


    isHiddenFolder: function(fullPath) {
        const vaultRoot = this.getVaultRoot(fullPath);
        if (!vaultRoot || fullPath === vaultRoot) return false;
        const cfg = this.pluginConfigs[vaultRoot];
        if (!cfg || !cfg.hiddenFolders || !Array.isArray(cfg.hiddenFolders)) return false;
        const parts = fullPath.substring(vaultRoot === '/' ? 1 : vaultRoot.length + 1).split('/');
        return parts.some(p => cfg.hiddenFolders.includes(p));
    },

    promptVaultSettings: function(vaultRoot) {
        const cfg = this.pluginConfigs[vaultRoot];
        if (!cfg) return;
        
        const appCfg = cfg.app || {};
        const hiddenFolders = cfg.hiddenFolders || [];
        const currentVaultBg = (appCfg.vaultBgColor && /^#[0-9a-fA-F]{6}$/.test(appCfg.vaultBgColor)) ? appCfg.vaultBgColor : '#d1c4e9';
        
        const dirs = new Set();
        myCloudState.allItems.forEach(i => {
            if (i.size === 'DIR' && i.name.startsWith(vaultRoot) && i.name !== vaultRoot) {
                if (i.name.includes('/.obsidian')) return;
                dirs.add(i.name.split('/').pop());
            }
        });
        const uniqueDirs = Array.from(dirs).sort();

        const overlay = document.getElementById('myCloudModalOverlay');
        const modal = document.getElementById('myCloudModal');
        if (typeof myCloudResetModal === 'function') myCloudResetModal();
        
        overlay.style.display = 'flex';
        overlay.style.zIndex = '85000';
        modal.className = 'myCloudModal'; 
        modal.style.maxWidth = '450px';

        const rawVaultLabel = (vaultRoot === '/' && this.vaultNames && this.vaultNames['/'])
            ? this.vaultNames['/']
            : (vaultRoot.split('/').pop() || 'Root Vault');
        const safeName = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(rawVaultLabel) : rawVaultLabel;

        const vaultPresets = ['#d1c4e9', '#bbdefb', '#c8e6c9', '#ffe0b2', '#ffcdd2', '#f8bbd0', '#b2dfdb', '#cfd8dc'];
        const presetsHtml = vaultPresets.map(c => `<span class="ce-obs-vault-bg-swatch" data-color="${c}" style="width:20px; height:20px; border-radius:4px; background:${c}; border:1px solid var(--border-medium); cursor:pointer; display:inline-block;" title="${c}"></span>`).join('');
        
        let html = '<div class="myCloudModalHeader" style="background:var(--gray-10); color:var(--text-primary); padding:12px 16px; font-size:15px; font-weight:600; border-bottom:1px solid var(--border-default);">' +
            '<span>' + this.L('obs_settings_title', 'Obsidian Settings:') + ' <span style="font-weight:400; color:var(--text-secondary);">' + safeName + '</span></span>' +
            '<span class="myCloudClose" style="color:var(--text-secondary); font-size:18px; cursor:pointer;" onclick="if(typeof myCloudCloseModal===\'function\')myCloudCloseModal()">✕</span>' +
        '</div>' +
        '<div class="myCloudModalBody" style="padding: 0; display:flex; flex-direction:column; font-family:var(--font-family, sans-serif); box-sizing:border-box;">' +
            
            '<div class="ce-settings-tabs" style="margin-top: 0px; flex-shrink:0; overflow-x:auto; display:flex; flex-wrap:nowrap; scrollbar-width:none; -ms-overflow-style:none; background:var(--gray-10); border-bottom:1px solid var(--border-default);">' +
                '<button type="button" class="ce-tab-btn active" id="ceObsTabBtnGen" style="flex: 1 0 auto; white-space: nowrap; border: none; background: transparent; padding: 10px 16px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--accent-primary); border-bottom: 2px solid var(--accent-primary); transition: color 0.15s, border-color 0.15s;">' + this.L('obs_tab_general', 'General') + '</button>' +
                '<button type="button" class="ce-tab-btn" id="ceObsTabBtnHid" style="flex: 1 0 auto; white-space: nowrap; border: none; background: transparent; padding: 10px 16px; font-size: 13px; font-weight: 500; cursor: pointer; color: var(--text-secondary); border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;">' + this.L('obs_tab_hidden', 'Hidden Folders') + '</button>' +
            '</div>' +
            
            '<div style="padding: 20px; overflow-y:auto; max-height:60vh;">' +
            
                '<div id="ceObsTabGenContent" style="display:flex; flex-direction:column; gap:12px;">' +
                    '<div>' +
                        '<label style="display:block; margin-bottom:4px; font-size:13px; font-weight:500; color:var(--text-primary);">' + this.L('obs_vault_bg_color', 'Vault Background Color:') + '</label>' +
                        '<div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">' +
                            `<input type="color" id="ceObsVaultBgPicker" value="${currentVaultBg}" style="width:36px; height:28px; padding:0; border:1px solid var(--border-default); border-radius:4px; cursor:pointer; background:transparent;">` +
                            `<input type="text" id="ceObsVaultBgHex" class="myCloudInlineInput" value="${appCfg.vaultBgColor || ''}" placeholder="${this.L('obs_default_lilac', 'Default (Light Lilac)')}" style="width:135px; height:28px; padding:0 8px; font-size:12px; font-family:monospace; margin:0;">` +
                            `<button type="button" id="ceObsVaultBgReset" style="height:28px; padding:0 8px; font-size:12px; border:1px solid var(--border-default); background:var(--gray-05); color:var(--text-primary); border-radius:4px; cursor:pointer;">${this.L('reset', 'Reset')}</button>` +
                        '</div>' +
                        `<div style="display:flex; gap:6px; margin-top:6px; align-items:center;">${presetsHtml}</div>` +
                    '</div>' +
                    '<div>' +
                        '<label style="display:block; margin-bottom:4px; font-size:13px; font-weight:500; color:var(--text-primary);">' + this.L('obs_att_folder_path', 'Attachment Folder Path:') + '</label>' +
                        `<input type="text" id="ceObsAppAtt" class="myCloudInlineInput" value="${appCfg.attachmentFolderPath || ''}" style="width:100%; box-sizing:border-box; padding:8px 10px; font-size:14px; margin:0;">` +
                    '</div>' +
                    '<div>' +
                        '<label style="display:block; margin-bottom:4px; font-size:13px; font-weight:500; color:var(--text-primary);">' + this.L('obs_new_file_loc', 'New File Location:') + '</label>' +
                        `<select id="ceObsAppNewLoc" class="myCloudInlineInput" style="width:100%; box-sizing:border-box; padding:8px 10px; font-size:14px; margin:0; height:36px;">
                    <option value="root" ${appCfg.newFileLocation==='root'?'selected':''}>${this.L('obs_loc_root', 'Vault Root')}</option>
                    <option value="current" ${appCfg.newFileLocation==='current'?'selected':''}>${this.L('obs_loc_current', 'Current Folder')}</option>
                    <option value="folder" ${appCfg.newFileLocation==='folder'?'selected':''}>${this.L('obs_loc_folder', 'Specific Folder')}</option>
                </select>` +
                    '</div>' +
                    '<div>' +
                        '<label style="display:block; margin-bottom:4px; font-size:13px; font-weight:500; color:var(--text-primary);">' + this.L('obs_new_file_path', 'New File Folder Path:') + '</label>' +
                        `<input type="text" id="ceObsAppNewPath" class="myCloudInlineInput" value="${appCfg.newFileFolderPath || ''}" style="width:100%; box-sizing:border-box; padding:8px 10px; font-size:14px; margin:0;">` +
                    '</div>' +
                    '<div style="display:flex; flex-direction:column; gap:8px; margin-top:4px;">' +
                        '<label style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-primary); cursor:pointer;"><input type="checkbox" id="ceObsAppBreaks" ' + (appCfg.strictLineBreaks ? 'checked' : '') + ' style="accent-color:var(--accent-primary); width:15px; height:15px;"> ' + this.L('obs_strict_breaks', 'Strict Line Breaks') + '</label>' +
                        '<label style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-primary); cursor:pointer;"><input type="checkbox" id="ceObsAppFm" ' + (appCfg.showFrontmatter !== false ? 'checked' : '') + ' style="accent-color:var(--accent-primary); width:15px; height:15px;"> ' + this.L('obs_show_yaml', 'Show YAML Frontmatter') + '</label>' +
                    '</div>' +
                '</div>' +

                '<div id="ceObsTabHidContent" style="display:none; flex-direction:column;">' +
                    '<div style="font-size:12px; color:var(--text-secondary); margin-bottom:12px;">' + this.L('obs_hidden_desc', 'Select folders to exclude from the tree and file list views:') + '</div>' +
                    '<div style="display:flex; flex-direction:column; gap:4px; background:var(--gray-05); padding:8px; border-radius:6px; border:1px solid var(--border-default);">';
        
        if (uniqueDirs.length === 0) {
            html += '<div style="text-align:center; color:var(--text-secondary); font-size:12px; padding:10px;">' + this.L('obs_no_subfolders', 'No subfolders found') + '</div>';
        } else {
            uniqueDirs.forEach(d => {
                const isChecked = hiddenFolders.includes(d) ? 'checked' : '';
                const safeD = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(d) : d;
                html += `<label style="font-size:13px; display:flex; align-items:center; gap:10px; background:var(--gray-00); padding:7px 10px; border-radius:4px; border:1px solid var(--border-default); cursor:pointer; user-select:none;" onmouseover="this.style.borderColor='var(--accent-primary)'" onmouseout="this.style.borderColor='var(--border-default)'">` +
                    `<input type="checkbox" class="ce-obs-hidden-cb" value="${d}" ${isChecked} style="accent-color:var(--accent-primary); width:15px; height:15px; cursor:pointer;">` +
                    `<span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-primary); font-weight:500;">${safeD}</span>` +
                `</label>`;
            });
        }
        
        html += '</div></div>' +

            '</div>' +
            '<div class="myCloudButtons" style="justify-content: flex-end; flex-shrink:0; padding:12px 20px; border-top:1px solid var(--border-default); margin-top:0; background:var(--gray-05); border-radius:0 0 8px 8px;">' +
                '<button onclick="if (typeof myCloudCloseModal === \'function\') myCloudCloseModal();" style="padding:6px 14px; font-size:13px;">' + this.L('cancel', 'Cancel') + '</button>' +
                '<button id="ceVaultBtnSave" style="background:var(--accent-primary); color:#fff; border:none; padding:6px 16px; font-size:13px; font-weight:500;">' + this.L('save', 'Save') + '</button>' +
            '</div>' +
        '</div>';

        modal.innerHTML = html;

        const bgPicker = document.getElementById('ceObsVaultBgPicker');
        const bgHex = document.getElementById('ceObsVaultBgHex');
        const bgReset = document.getElementById('ceObsVaultBgReset');
        bgPicker.oninput = () => { bgHex.value = bgPicker.value.toUpperCase(); };
        bgHex.oninput = () => {
            const v = bgHex.value.trim();
            if (/^#[0-9a-fA-F]{6}$/.test(v)) bgPicker.value = v;
        };
        bgReset.onclick = () => {
            bgHex.value = '';
            bgPicker.value = '#d1c4e9';
        };
        modal.querySelectorAll('.ce-obs-vault-bg-swatch').forEach(sw => {
            sw.onclick = () => {
                bgPicker.value = sw.dataset.color;
                bgHex.value = sw.dataset.color.toUpperCase();
            };
        });

        // Tab Switching Logic
        const btnGen = document.getElementById('ceObsTabBtnGen');
        const btnHid = document.getElementById('ceObsTabBtnHid');
        const conGen = document.getElementById('ceObsTabGenContent');
        const conHid = document.getElementById('ceObsTabHidContent');

        btnGen.onclick = () => {
            btnGen.classList.add('active');
            btnGen.style.color = 'var(--accent-primary)';
            btnGen.style.borderBottomColor = 'var(--accent-primary)';
            btnHid.classList.remove('active');
            btnHid.style.color = 'var(--text-secondary)';
            btnHid.style.borderBottomColor = 'transparent';
            conGen.style.display = 'flex';
            conHid.style.display = 'none';
        };

        btnHid.onclick = () => {
            btnHid.classList.add('active');
            btnHid.style.color = 'var(--accent-primary)';
            btnHid.style.borderBottomColor = 'var(--accent-primary)';
            btnGen.classList.remove('active');
            btnGen.style.color = 'var(--text-secondary)';
            btnGen.style.borderBottomColor = 'transparent';
            conHid.style.display = 'flex';
            conGen.style.display = 'none';
        };

        document.getElementById('ceVaultBtnSave').onclick = () => {
            const hidden = [];
            document.querySelectorAll('.ce-obs-hidden-cb').forEach(cb => {
                if (cb.checked) hidden.push(cb.value);
            });
            cfg.hiddenFolders = hidden;

            const chosenBg = bgHex.value.trim();
            if (/^#[0-9a-fA-F]{6}$/.test(chosenBg)) {
                cfg.app.vaultBgColor = chosenBg.toLowerCase();
            } else {
                delete cfg.app.vaultBgColor;
            }

            cfg.app.attachmentFolderPath = document.getElementById('ceObsAppAtt').value;
            cfg.app.newFileLocation = document.getElementById('ceObsAppNewLoc').value;
            cfg.app.newFileFolderPath = document.getElementById('ceObsAppNewPath').value;
            cfg.app.strictLineBreaks = document.getElementById('ceObsAppBreaks').checked;
            cfg.app.showFrontmatter = document.getElementById('ceObsAppFm').checked;

            const tkn = typeof myCloudCsrfToken !== 'undefined' ? myCloudCsrfToken : '';
            const key = myCloudState.key;
            
            const p1 = fetch('', { method: 'POST', body: new URLSearchParams({
                myCloud_action: 'edit-save', myCloud_key: key, myCloud_token: tkn,
                path: (vaultRoot === '/' ? '' : vaultRoot) + '/.obsidian/cloud-hidden-folders.json',
                content: JSON.stringify(hidden, null, 2)
            })});
            
            const p2 = fetch('', { method: 'POST', body: new URLSearchParams({
                myCloud_action: 'edit-save', myCloud_key: key, myCloud_token: tkn,
                path: (vaultRoot === '/' ? '' : vaultRoot) + '/.obsidian/app.json',
                content: JSON.stringify(cfg.app, null, 2)
            })});

            Promise.all([p1, p2]).then(() => {
                if (typeof myCloudCloseModal === 'function') myCloudCloseModal();
                if (typeof myCloudRenderUI === 'function') myCloudRenderUI();
            });
        };
    },
	
	promptVaultSearchReplace: function(contextPath = null, initialSearch = '', initialReplace = '') {
        if (!window.myCloudActionAllowed('edit_file')) return;

        const targetDir = contextPath || this.activeFile || myCloudState.currentDir;
        let folderTarget = targetDir;
        const item = myCloudState.allItems.find(i => i.name === folderTarget);
        if (item && item.size !== 'DIR') {
            folderTarget = folderTarget.substring(0, folderTarget.lastIndexOf('/')) || '/';
        }

        const vaultRoot = this.getVaultRoot(folderTarget) || '/';

        if (!this.vaults.has(vaultRoot)) return;

        // Flush any unsaved changes in the active note before scanning the vault on disk
        if (this.isDirty) {
            this.flushPendingSave();
        }

        const overlay = document.getElementById('myCloudModalOverlay');
        const modal = document.getElementById('myCloudModal');
        if (typeof myCloudResetModal === 'function') myCloudResetModal();

        overlay.style.display = 'flex';
        overlay.style.zIndex = '85000';
        modal.className = 'myCloudModal';
        modal.style.width = '780px';
        modal.style.maxWidth = '95vw';

        let defaultFilter = '';
        if (folderTarget !== vaultRoot && folderTarget.startsWith(vaultRoot)) {
            defaultFilter = folderTarget.substring(vaultRoot === '/' ? 1 : vaultRoot.length + 1) + '/*';
        }

        const rawVaultLabel = (vaultRoot === '/' && this.vaultNames && this.vaultNames['/'])
            ? this.vaultNames['/']
            : (vaultRoot.split('/').pop() || 'Root Vault');
        const safeVaultName = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(rawVaultLabel) : rawVaultLabel;
        const safeInitSearch = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(initialSearch) : initialSearch;
        const safeInitReplace = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(initialReplace) : initialReplace;
        const safeInitFilter = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(defaultFilter) : defaultFilter;

        const phSearch = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(this.L('obs_vr_ph_search', 'e.g. <span class="old"> or [[OldLink]]')) : this.L('obs_vr_ph_search', 'e.g. <span class="old"> or [[OldLink]]');
        const phReplace = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(this.L('obs_vr_ph_replace', 'Replacement (supports $1 in Regex mode)')) : this.L('obs_vr_ph_replace', 'Replacement...');

        modal.innerHTML = `
            <div class="myCloudModalHeader" style="background:var(--gray-10); color:var(--text-primary); padding:12px 16px; font-size:15px; font-weight:600; border-bottom:1px solid var(--border-default);">
                <span>🔍 ${this.L('obs_vault_replace_title', 'Vault Raw Markdown Search & Replace:')} <span style="font-weight:400; color:var(--text-secondary);">${safeVaultName}</span></span>
                <span class="myCloudClose" style="color:var(--text-secondary); font-size:18px; cursor:pointer;" onclick="myCloudCloseModal()">✕</span>
            </div>
            <div class="myCloudModalBody" style="padding:18px 20px; display:flex; flex-direction:column; gap:12px; max-height:80vh; overflow:hidden; box-sizing:border-box;">
                <div style="font-size:12px; color:var(--text-secondary); background:rgba(122,85,203,0.08); border-inline-start:3px solid #7a55cb; padding:6px 10px; border-radius:4px;">
                    ${this.L('obs_vault_replace_hint', 'Operates directly on raw Markdown (.md) files on disk (including HTML & Markdown syntax tags) without using the search index.')}
                </div>
                <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:10px;">
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">${this.L('obs_find_next', 'Find')}:</label>
                        <input type="text" id="ceObsVrSearch" class="myCloudInlineInput" value="${safeInitSearch}" placeholder="${phSearch}" style="width:100%; height:32px; padding:0 10px; font-family:monospace; font-size:13px; margin:0; box-sizing:border-box;">
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">${this.L('obs_replace_placeholder', 'Replace with...')}</label>
                        <input type="text" id="ceObsVrReplace" class="myCloudInlineInput" value="${safeInitReplace}" placeholder="${phReplace}" style="width:100%; height:32px; padding:0 10px; font-family:monospace; font-size:13px; margin:0; box-sizing:border-box;">
                    </div>
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; background:var(--gray-05); padding:8px 12px; border-radius:6px; border:1px solid var(--border-default);">
                    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; font-size:12.5px;">
                        <label style="display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="ceObsVrCase" style="accent-color:var(--accent-primary);"> ${this.L('obs_vr_case', 'Case sensitive')}</label>
                        <label style="display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="ceObsVrWord" style="accent-color:var(--accent-primary);"> ${this.L('obs_vr_word', 'Whole word')}</label>
                        <label style="display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="ceObsVrRegex" style="accent-color:var(--accent-primary);"> ${this.L('obs_vr_regex', 'Regular Expression')}</label>
                        <label style="display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="ceObsVrExFm" checked style="accent-color:var(--accent-primary);"> ${this.L('obs_vr_ex_fm', 'Skip YAML Frontmatter')}</label>
                        <label style="display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="ceObsVrExCode" style="accent-color:var(--accent-primary);"> ${this.L('obs_vr_ex_code', 'Skip Code Blocks')}</label>
                    </div>
                    <div style="display:flex; align-items:center; gap:6px; flex:1 1 180px; justify-content:flex-end;">
                        <input type="text" id="ceObsVrPathFilter" class="myCloudInlineInput" value="${safeInitFilter}" placeholder="${this.L('obs_vr_path_filter', 'Subfolder / glob filter (optional)')}" style="width:100%; max-width:210px; height:26px; padding:0 8px; font-size:12px; margin:0;">
                        <button type="button" id="ceObsVrPreviewBtn" style="height:28px; padding:0 14px; background:var(--accent-primary); color:#fff; border:none; border-radius:4px; font-size:12.5px; font-weight:600; cursor:pointer; white-space:nowrap;">${this.L('obs_vr_scan', 'Scan Vault')}</button>
                    </div>
                </div>
                <div id="ceObsVrStatus" style="font-size:12px; font-weight:600; color:var(--text-secondary); display:none; justify-content:space-between; align-items:center;"></div>
                <div id="ceObsVrResults" style="flex:1; min-height:180px; max-height:320px; overflow-y:auto; border:1px solid var(--border-default); border-radius:6px; background:var(--gray-05); padding:10px;">
                    <div style="text-align:center; color:var(--text-secondary); padding:40px 10px; font-size:13px;">${this.L('obs_vr_empty_prompt', 'Enter a search pattern and click "Scan Vault" to preview matches across all Markdown files.')}</div>
                </div>
                <div class="myCloudButtons" style="justify-content:space-between; align-items:center; margin-top:4px;">
                    <span style="font-size:11.5px; color:var(--danger, #e81123); font-weight:500;"> ️ ${this.L('obs_vr_warn_irreversible', 'Batch replacements across vault files cannot be undone.')}</span>
                    <div style="display:flex; gap:8px;">
                        <button type="button" onclick="myCloudCloseModal()">${this.L('cancel', 'Cancel')}</button>
                        <button type="button" id="ceObsVrExecBtn" disabled style="background:var(--danger, #e81123); color:#fff; border:none; padding:6px 16px; font-weight:600; opacity:0.5;">${this.L('obs_replace_all', 'Replace All')}</button>
                    </div>
                </div>
            </div>
        `;

        const searchInp = document.getElementById('ceObsVrSearch');
        const replaceInp = document.getElementById('ceObsVrReplace');
        const caseCb = document.getElementById('ceObsVrCase');
        const wordCb = document.getElementById('ceObsVrWord');
        const regexCb = document.getElementById('ceObsVrRegex');
        const exFmCb = document.getElementById('ceObsVrExFm');
        const exCodeCb = document.getElementById('ceObsVrExCode');
        const pathInp = document.getElementById('ceObsVrPathFilter');
        const scanBtn = document.getElementById('ceObsVrPreviewBtn');
        const execBtn = document.getElementById('ceObsVrExecBtn');
        const resultsEl = document.getElementById('ceObsVrResults');
        const statusEl = document.getElementById('ceObsVrStatus');

        let lastScanFiles = [];

        const updateExecState = () => {
            const checkedBoxes = resultsEl.querySelectorAll('.ce-obs-vr-file-cb:checked');
            const hasSelection = checkedBoxes.length > 0;
            execBtn.disabled = !hasSelection;
            execBtn.style.opacity = hasSelection ? '1' : '0.5';
        };

        const runScan = async () => {
            const q = searchInp.value;
            if (!q) return;
            scanBtn.disabled = true;
            resultsEl.innerHTML = `<div class="myCloud-loading-container" style="padding:30px 0;"><div class="myCloud-spinner dark"></div></div>`;
            statusEl.style.display = 'none';

            try {
                const fd = new URLSearchParams({
                    myCloud_action: 'obs_vault_replace_preview',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    vault_root: vaultRoot,
                    search: q,
                    replace: replaceInp.value,
                    case_sensitive: caseCb.checked ? '1' : '0',
                    whole_word: wordCb.checked ? '1' : '0',
                    use_regex: regexCb.checked ? '1' : '0',
                    exclude_fm: exFmCb.checked ? '1' : '0',
                    exclude_code: exCodeCb.checked ? '1' : '0',
                    path_filter: pathInp.value.trim()
                });
                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                scanBtn.disabled = false;

                if (res.status !== 'OK') {
                    resultsEl.innerHTML = `<div style="color:var(--danger); padding:16px; text-align:center;">${myCloudEscapeHtml(res.msg || 'Error')}</div>`;
                    return;
                }

                lastScanFiles = res.files || [];
                statusEl.style.display = 'flex';


                let foundMsg = this.L('obs_vr_found_hits', 'Found <b>%s1</b> match(es) across <b>%s2</b> note(s)');
                foundMsg = foundMsg.replace('%s1', res.total_matches).replace('%s2', res.total_files);

                statusEl.innerHTML = `
                    <span>${foundMsg}</span>
                    ${lastScanFiles.length > 0 ? `<label style="cursor:pointer; display:flex; align-items:center; gap:5px;"><input type="checkbox" id="ceObsVrToggleAll" checked> ${this.L('obs_vr_select_all', 'Select All')}</label>` : ''}
                `;

                if (lastScanFiles.length === 0) {
                    resultsEl.innerHTML = `<div style="text-align:center; color:var(--text-secondary); padding:30px;">${this.L('obs_vr_no_matches', 'No matches found in this vault.')}</div>`;
                    updateExecState();
                    return;
                }

                let listHtml = '';
                lastScanFiles.forEach((f, idx) => {
                    const safeRel = myCloudEscapeHtml(f.rel_vault);
                    const samplesHtml = (f.samples || []).slice(0, 4).map(s => `
                        <div style="font-family:monospace; font-size:11.5px; padding:4px 8px; background:var(--gray-00); border:1px solid var(--border-subtle); border-radius:4px; margin-top:4px; overflow-x:auto;">
                            <div style="color:var(--text-secondary); font-size:10.5px;">${this.L('obs_vr_line', 'Line %s:').replace('%s', s.line)}</div>
                            <div style="color:#c93b2b; text-decoration:line-through; white-space:pre-wrap; word-break:break-all;">- ${myCloudEscapeHtml(s.before)}</div>
                            <div style="color:#107c10; font-weight:600; white-space:pre-wrap; word-break:break-all;">+ ${myCloudEscapeHtml(s.after)}</div>
                        </div>
                    `).join('');

                    listHtml += `
                        <div style="background:var(--gray-00); border:1px solid var(--border-default); border-radius:6px; padding:8px 10px; margin-bottom:8px;">
                            <label style="display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:600; cursor:pointer;">
                                <span style="display:flex; align-items:center; gap:8px; min-width:0;">
                                    <input type="checkbox" class="ce-obs-vr-file-cb" data-path="${myCloudEscapeHtml(f.path)}" checked style="accent-color:var(--accent-primary);">
                                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">📄 ${safeRel}</span>
                                </span>
                                <span style="font-size:11px; background:rgba(122,85,203,0.12); color:#7a55cb; padding:2px 8px; border-radius:10px; flex-shrink:0;">${f.count}${this.L('obs_vr_matches', 'matches')}</span>
                            </label>
                            ${samplesHtml}
                        </div>
                    `;
                });
                resultsEl.innerHTML = listHtml;

                const toggleAll = document.getElementById('ceObsVrToggleAll');
                if (toggleAll) {
                    toggleAll.onchange = () => {
                        resultsEl.querySelectorAll('.ce-obs-vr-file-cb').forEach(cb => { cb.checked = toggleAll.checked; });
                        updateExecState();
                    };
                }
                resultsEl.querySelectorAll('.ce-obs-vr-file-cb').forEach(cb => {
                    cb.onchange = updateExecState;
                });
                updateExecState();
            } catch (err) {
                scanBtn.disabled = false;
                resultsEl.innerHTML = `<div style="color:var(--danger); padding:16px; text-align:center;">${this.L('obs_vr_err_net', 'Network error while scanning vault.')}</div>`;
            }
        };

        scanBtn.onclick = runScan;
        searchInp.onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); runScan(); } };
        replaceInp.onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); runScan(); } };

        execBtn.onclick = () => {
            const selectedPaths = Array.from(resultsEl.querySelectorAll('.ce-obs-vr-file-cb:checked')).map(cb => cb.dataset.path);
            if (selectedPaths.length === 0) return;

            const warnMsg = `${this.L('obs_vr_confirm_msg', 'Are you sure you want to permanently replace matches in')} <b>${selectedPaths.length}</b> ${this.L('files_lc', 'file(s)')}?<br><br><span style="color:var(--danger); font-weight:600;">${this.L('obs_vr_warn_irreversible', 'This action modifies raw Markdown files directly and cannot be undone!')}</span>`;

            myCloudShowAlert(
                this.L('obs_replace_all', 'Replace All'),
                warnMsg,
                async () => {
                    execBtn.disabled = true;
                    const fd = new URLSearchParams({
                        myCloud_action: 'obs_vault_replace_exec',
                        myCloud_key: myCloudState.key,
                        myCloud_token: window.myCloudCsrfToken || '',
                        vault_root: vaultRoot,
                        search: searchInp.value,
                        replace: replaceInp.value,
                        case_sensitive: caseCb.checked ? '1' : '0',
                        whole_word: wordCb.checked ? '1' : '0',
                        use_regex: regexCb.checked ? '1' : '0',
                        exclude_fm: exFmCb.checked ? '1' : '0',
                        exclude_code: exCodeCb.checked ? '1' : '0',
                        files: JSON.stringify(selectedPaths)
                    });

                    try {
                        const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                        if (res.status === 'OK') {
                            myCloudCloseModal();
                            if (typeof myCloudNotify === 'function') {
                                myCloudNotify(`Replaced ${res.total_replaced} occurrence(s) across ${res.modified_files} note(s).`);
                            }
                            if (this.activeFile && selectedPaths.includes(this.activeFile)) {
                                await this.openFileInRightPane(this.activeFile);
                            }
                        } else {
                            myCloudShowAlert(this.L('error_lbl', 'Error'), res.msg || 'Replacement failed.');
                        }
                    } catch (e) {
                        myCloudShowAlert(this.L('error_lbl', 'Error'), 'Network error during replacement.');
                    }
                }
            );
        };

        setTimeout(() => {
            searchInp.focus();
            if (initialSearch) runScan();
        }, 50);
    },

    promptFolderColor: function(fullPath) {
        const vaultRoot = this.getVaultRoot(fullPath);
        if (!vaultRoot) return;
        const relPath = vaultRoot === '/' ? fullPath.substring(1) : fullPath.substring(vaultRoot.length + 1);
        const relParts = relPath.split('/').filter(p => p);
        const topLevel = relParts[0];
        if (!topLevel) return;

        const cfg = this.pluginConfigs[vaultRoot];
        let currentColor = '#83C5BE';
        if (cfg && cfg.cloudColors && cfg.cloudColors[topLevel]) currentColor = cfg.cloudColors[topLevel];

        const overlay = document.getElementById('myCloudModalOverlay');
        const modal = document.getElementById('myCloudModal');
        if (typeof myCloudResetModal === 'function') myCloudResetModal();
        
        overlay.style.display = 'flex';
        overlay.style.zIndex = '85000';
        modal.className = 'myCloudModal'; 
        
        const safeName = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(topLevel) : topLevel;

        let savedColors = [];
        try {
            const fromProfile = (myCloudState.settings && Array.isArray(myCloudState.settings.obsSavedColors)) ? myCloudState.settings.obsSavedColors : [];
            const fromVault = (cfg && cfg.cloudColors && Array.isArray(cfg.cloudColors._presets)) ? cfg.cloudColors._presets : [];
            const fromLocal = JSON.parse(localStorage.getItem('myCloudObsidianSavedColors') || '[]') || [];
            savedColors = Array.from(new Set([...fromProfile, ...fromVault, ...fromLocal]));
        } catch(e){}

        const persistSavedColors = () => {
            if (!myCloudState.settings) myCloudState.settings = {};
            myCloudState.settings.obsSavedColors = savedColors;
            try { localStorage.setItem('myCloudObsidianSavedColors', JSON.stringify(savedColors)); } catch (e) {}
            if (cfg) {
                if (!cfg.cloudColors) cfg.cloudColors = {};
                cfg.cloudColors._presets = savedColors;
                this.queueCloudColorSave(vaultRoot);
            }
            if (typeof myCloudSaveSettings === 'function') myCloudSaveSettings();
        };

        modal.innerHTML = 
            '<div class="myCloudModalHeader">Folder Color: ' + safeName + '</div>' +
            '<div class="myCloudModalBody" style="padding: 20px;">' +
                '<label style="display:block; margin-bottom:8px; font-weight:600; font-size:13px; color:var(--text-primary);">Select base color for this structure:</label>' +
                '<div style="display:flex; gap:10px; margin-bottom:15px; align-items:center;">' +
                    '<input type="color" id="ceFolderColorPicker" value="' + currentColor + '" style="height:32px; width:50px; cursor:pointer; padding:0; border:1px solid var(--border-default); border-radius:4px;">' +
                    '<input type="text" id="ceFolderColorHex" class="myCloudInlineInput" value="' + currentColor + '" style="width:100px; padding:0 10px; font-family:monospace; text-transform:uppercase; margin:0; height:32px;">' +
                    '<button id="ceColorBtnSavePreset" title="Save to presets" style="padding:0 12px; height:32px;">Save Preset</button>' +
                '</div>' +
                '<label style="display:block; margin-bottom:8px; font-weight:600; font-size:13px; color:var(--text-primary);">Saved Presets (Right-click to remove):</label>' +
                '<div id="ceFolderSavedColors" style="display:flex; flex-wrap:wrap; gap:6px; min-height:24px; margin-bottom:15px;"></div>' +
                '<div class="myCloudButtons" style="justify-content: flex-end; margin-top:20px;">' +
                    '<button onclick="if (typeof myCloudCloseModal === \'function\') myCloudCloseModal();" style="margin-right:10px;">Cancel</button>' +
                    '<button id="ceColorBtnReset" style="margin-right:10px;">Reset</button>' +
                    '<button id="ceColorBtnSave" style="background:var(--accent-primary); color:#fff; border:none;">Save</button>' +
                '</div>' +
            '</div>';

        const picker = document.getElementById('ceFolderColorPicker');
        const hexInp = document.getElementById('ceFolderColorHex');
        const presetsContainer = document.getElementById('ceFolderSavedColors');

        const renderPresets = () => {
            presetsContainer.innerHTML = '';
            if (savedColors.length === 0) {
                presetsContainer.innerHTML = '<span style="color:var(--text-secondary); font-size:12px;">No saved presets</span>';
                return;
            }
            savedColors.forEach((c, idx) => {
                const dot = document.createElement('div');
                dot.style.cssText = `width:24px; height:24px; border-radius:4px; background-color:${c}; border:1px solid var(--border-medium); cursor:pointer;`;
                dot.title = c;
                dot.onclick = () => { picker.value = c; hexInp.value = c.toUpperCase(); };
                dot.oncontextmenu = (e) => {
                    e.preventDefault();
                    savedColors.splice(idx, 1);
                    persistSavedColors();
                    renderPresets();
                };
                presetsContainer.appendChild(dot);
            });
        };
        renderPresets();

        picker.oninput = () => { hexInp.value = picker.value.toUpperCase(); };
        hexInp.oninput = () => { 
            let val = hexInp.value.trim();
            if (val.match(/^#[0-9a-fA-F]{6}$/)) picker.value = val; 
        };

        document.getElementById('ceColorBtnSavePreset').onclick = () => {
            const c = picker.value.toLowerCase();
            if (!savedColors.includes(c)) {
                savedColors.push(c);
                persistSavedColors();
                renderPresets();
            }
        };

        document.getElementById('ceColorBtnSave').onclick = () => {
            const newColor = picker.value;
            if (!cfg.cloudColors) cfg.cloudColors = {};
            cfg.cloudColors[topLevel] = newColor;
            const lowerNew = newColor.toLowerCase();
            if (!savedColors.includes(lowerNew)) {
                savedColors.push(lowerNew);
            }
            persistSavedColors();
            this.queueCloudColorSave(vaultRoot);
            if (typeof myCloudCloseModal === 'function') myCloudCloseModal();
            if (typeof myCloudRenderUI === 'function') myCloudRenderUI();
        };
        document.getElementById('ceColorBtnReset').onclick = () => {
            if (cfg.cloudColors && cfg.cloudColors[topLevel]) {
                delete cfg.cloudColors[topLevel];
                this.queueCloudColorSave(vaultRoot);
            }
            if (typeof myCloudCloseModal === 'function') myCloudCloseModal();
            if (typeof myCloudRenderUI === 'function') myCloudRenderUI();
        };
    },

    getNodeDecorations: function(fullPath, isFileNode = false) {
        const vaultRoot = this.getVaultRoot(fullPath);
        if (!vaultRoot) return { color: null, icon: null };

        // Ensure configs object exists to prevent intermittent rendering missing colors
        if (!this.pluginConfigs[vaultRoot]) {
            this.pluginConfigs[vaultRoot] = { icons: {}, app: {}, cloudColors: {} };
            this.loadVaultPlugins(vaultRoot).then(() => {
                if (typeof myCloudRenderUI === 'function') myCloudRenderUI();
            });
        }

        const relPath = vaultRoot === '/' ? fullPath.substring(1) : fullPath.substring(vaultRoot.length + 1);
        const cfg = this.pluginConfigs[vaultRoot];
        let color = null, icon = null;

        const relParts = relPath.split('/').filter(p => p);
        const topLevel = relParts[0];
        const isRootItem = relParts.length === 1;

        if (topLevel && !(isRootItem && isFileNode)) {
            if (cfg.cloudColors && cfg.cloudColors[topLevel]) {
                color = cfg.cloudColors[topLevel];
            } else {
                const CHAOTIC = ['#D49A89', '#A3B18A', '#83C5BE', '#FFD166', '#118AB2', '#06D6A0', '#EF476F', '#B5838D', '#E5989B', '#6D6875', '#457B9D', '#E07A5F', '#3D5A80', '#98C1D9', '#81B29A', '#E29578'];
                let hash = 0;
                for (let i = 0; i < topLevel.length; i++) hash = topLevel.charCodeAt(i) + ((hash << 5) - hash);
                color = CHAOTIC[Math.abs(hash) % 16];
                if (!cfg.cloudColors) cfg.cloudColors = {};
                cfg.cloudColors[topLevel] = color;
                this.queueCloudColorSave(vaultRoot);
            }
        }

        if (cfg.icons) {
            const rawIcon = cfg.icons[relPath] || cfg.icons[fullPath];
            if (typeof rawIcon === 'string') icon = rawIcon;
            else if (rawIcon && rawIcon.iconName) icon = rawIcon.iconName;
        }

        return { color, icon };
    },
	
	buildStandaloneDocumentHTML: async function() {
        const titleInput = document.querySelector('.ce-obs-title-input');
        let docTitle = titleInput ? titleInput.value.trim() : '';
        if (!docTitle && this.activeFile) {
            docTitle = ((myCloudState.pathNames && myCloudState.pathNames[this.activeFile]) ? myCloudState.pathNames[this.activeFile] : this.activeFile.split('/').pop().replace(/\.enc$/, '')).replace(/\.md$/i, '');
        }
        if (!docTitle) docTitle = 'Document';

        let bodyHtml = '';
        if (this.viewMode === 'wysiwyg' && this.shadowRoot) {
            const pane = this.shadowRoot.querySelector('#ceObsWysiwygPane');
            if (pane) {
                const clone = pane.cloneNode(true);
                const imgs = Array.from(clone.querySelectorAll('img'));
                for (let img of imgs) {
                    const src = img.getAttribute('src') || '';
                    if (src.startsWith('blob:')) {
                        try {
                            const blob = await fetch(src).then(r => r.blob());
                            const dataUrl = await new Promise((res) => {
                                const reader = new FileReader();
                                reader.onloadend = () => res(reader.result);
                                reader.readAsDataURL(blob);
                            });
                            if (dataUrl) img.setAttribute('src', dataUrl);
                        } catch (e) {}
                    }
                }
                clone.querySelectorAll('.ce-obs-code-copy').forEach(b => b.remove());
                bodyHtml = clone.innerHTML;
            }
        } else {
            const textarea = document.getElementById('ceObsTextarea');
            if (textarea) this.activeContent = textarea.value;
            bodyHtml = this.sanitizeUntrustedHTML(this.parseBasicMarkdown(this.activeContent || ''));
        }

        const safeTitle = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(docTitle) : docTitle;
        const fullHtml = `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>${safeTitle}</title>
<style>
    @page { margin: 18mm; }
    body { font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #1e1e1e; background: #ffffff; margin: 0; padding: 0; }
    h1.doc-title { font-size: 26px; font-weight: 700; margin: 0 0 18px 0; padding-bottom: 8px; border-bottom: 1px solid #ddd; }
    h1, h2, h3, h4, h5 { margin: 0.8em 0 0.4em 0; line-height: 1.3; color: #111; }
    p, div { margin: 0 0 0.55em 0; }
    ul, ol { margin: 0.4em 0 0.6em 0; padding-inline-start: 24px; }
    a { color: #0078d4; text-decoration: underline; }
    mark, .ce-obs-highlight { background-color: #fff3a8; padding: 1px 4px; border-radius: 3px; }
    .ce-obs-callout { margin: 12px 0; padding: 10px 14px; border-left: 4px solid #0078d4; background: #f4f9fd; border-radius: 4px; }
    .ce-obs-callout-title { font-weight: 700; margin-bottom: 4px; }
    .ce-obs-multicol { display: flex; gap: 16px; margin: 10px 0; width: 100%; }
    .ce-obs-col { flex: 1; background: #f9f9f9; padding: 10px; border-radius: 4px; border: 1px solid #e0e0e0; }
    .ce-obs-code-block, pre { margin: 10px 0; padding: 10px; border-radius: 6px; border: 1px solid #ccc; background: #f6f8fa; color: #1f2328; font-family: Consolas, monospace; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
    .ce-obs-code-header { font-weight: bold; margin-bottom: 6px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
    .ce-obs-line-num { color: #888; padding-right: 10px; user-select: none; }
    table, .ce-obs-table { border-collapse: collapse; width: 100%; margin: 12px 0; }
    table th, table td, .ce-obs-table th, .ce-obs-table td { border: 1px solid #bbb; padding: 6px 10px; text-align: left; }
    table th, .ce-obs-table th { background: #f0f0f0; font-weight: 600; }
    img { max-width: 100%; height: auto; page-break-inside: avoid; }
</style>
</head>
<body>
    <h1 class="doc-title">${safeTitle}</h1>
    ${bodyHtml}
</body>
</html>`;

        return { title: docTitle, html: fullHtml };
    },

    promptPrintOrPdf: function() {
        const overlay = document.getElementById('myCloudModalOverlay');
        const modal = document.getElementById('myCloudModal');
        if (typeof myCloudResetModal === 'function') myCloudResetModal();

        overlay.style.display = 'flex';
        overlay.style.zIndex = '85000';
        modal.className = 'myCloudModal';
        modal.style.maxWidth = '380px';

        const canPrint = window.myCloudActionAllowed('print');
        const canDownload = window.myCloudActionAllowed('download');
        const canUpload = window.myCloudActionAllowed('upload') || window.myCloudActionAllowed('edit_file');
        const canShare = !!navigator.share; // Detect Native Share Support

        modal.innerHTML =
            `<div class="myCloudModalHeader">
                <span>${this.L('obs_print', 'Print / Export PDF')}</span>
                <span class="myCloudClose" style="cursor:pointer; font-size:18px;" onclick="myCloudCloseModal()">✕</span>
            </div>
            <div class="myCloudModalBody" style="padding: 20px; display:flex; flex-direction:column; gap:10px;">
                <div style="font-size:13px; color:var(--text-secondary); margin-bottom:6px;">
                    ${this.L('obs_print_desc', 'Choose how you want to output this note:')}
                </div>
                ${canPrint ? `<button type="button" id="ceObsBtnPrintLocal" style="padding:10px 14px; font-size:14px; font-weight:500; border-radius:6px; border:1px solid var(--border-default); background:var(--gray-05); color:var(--text-primary); cursor:pointer; display:flex; align-items:center; gap:10px; text-align:start;">
                    <span style="font-size:18px;">🖨️</span>
                    <span>${this.L('obs_print_local', 'Print to Local Printer')}</span>
                </button>` : ''}
                ${canDownload ? `<button type="button" id="ceObsBtnPdfDownload" style="padding:10px 14px; font-size:14px; font-weight:500; border-radius:6px; border:1px solid var(--border-default); background:var(--gray-05); color:var(--text-primary); cursor:pointer; display:flex; align-items:center; gap:10px; text-align:start;">
                    <span style="font-size:18px;">⬇️</span>
                    <span>${this.L('obs_pdf_download', 'Download as PDF')}</span>
                </button>` : ''}
                ${canShare ? `<button type="button" id="ceObsBtnPdfShare" style="padding:10px 14px; font-size:14px; font-weight:500; border-radius:6px; border:1px solid var(--border-default); background:var(--gray-05); color:var(--text-primary); cursor:pointer; display:flex; align-items:center; gap:10px; text-align:start;">
                    <span style="font-size:18px;">📤</span>
                    <span>${this.L('obs_pdf_share', 'Share PDF...')}</span>
                </button>` : ''}
                ${canUpload ? `<button type="button" id="ceObsBtnPdfCloud" style="padding:10px 14px; font-size:14px; font-weight:500; border-radius:6px; border:1px solid var(--border-default); background:var(--gray-05); color:var(--text-primary); cursor:pointer; display:flex; align-items:center; gap:10px; text-align:start;">
                    <span style="font-size:18px;">☁️</span>
                    <span>${this.L('obs_pdf_cloud', 'Save PDF to Cloud...')}</span>
                </button>` : ''}
                <div class="myCloudButtons" style="margin-top:12px;">
                    <button type="button" onclick="myCloudCloseModal()">${this.L('cancel', 'Cancel')}</button>
                </div>
            </div>`;

        // 1. Print to Local Printer
        const btnLocal = document.getElementById('ceObsBtnPrintLocal');
        if (btnLocal) {
            btnLocal.onclick = async () => {
                myCloudCloseModal();
                const { html } = await this.buildStandaloneDocumentHTML();
                const iframe = document.createElement('iframe');
                iframe.style.cssText = 'position:fixed; right:0; bottom:0; width:0; height:0; border:0;';
                document.body.appendChild(iframe);
                const doc = iframe.contentWindow.document;
                doc.open();
                doc.write(html);
                doc.close();
                setTimeout(() => {
                    try {
                        iframe.contentWindow.focus();
                        iframe.contentWindow.print();
                    } catch (e) {}
                    setTimeout(() => iframe.remove(), 60000);
                }, 450);
            };
        }

        // 2. Download as PDF
        const btnDl = document.getElementById('ceObsBtnPdfDownload');
        if (btnDl) {
            btnDl.onclick = async () => {
                const titleInput = document.querySelector('.ce-obs-title-input');
                const suggestedName = ((titleInput ? titleInput.value.trim() : '') || 'Document') + '.pdf';

                let fileHandle = null;
                if (typeof window.showSaveFilePicker === 'function') {
                    try {
                        fileHandle = await window.showSaveFilePicker({
                            suggestedName: suggestedName,
                            types: [{ description: 'PDF Document', accept: { 'application/pdf': ['.pdf'] } }]
                        });
                    } catch (err) {
                        if (err && err.name === 'AbortError') return; // User cancelled dialog
                    }
                }

                myCloudCloseModal();
                if (typeof myCloudCreateProgressUI === 'function') myCloudCreateProgressUI(this.L('obs_generating_pdf', 'Generating PDF...'));

                try {
                    const { title, html } = await this.buildStandaloneDocumentHTML();
                    const fd = new URLSearchParams({
                        myCloud_action: 'obs_export_pdf',
                        myCloud_key: myCloudState.key,
                        myCloud_token: window.myCloudCsrfToken || '',
                        title: title,
                        html: html
                    });
                    const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                    if (res.status !== 'OK' || !res.token) throw new Error(res.msg || 'PDF conversion failed.');

                    const dlUrl = '?myCloud_token=' + res.token;
                    const pdfBlob = await fetch(dlUrl).then(r => r.blob());

                    if (typeof myCloudUpdateProgressUI === 'function') myCloudUpdateProgressUI(100);
                    setTimeout(() => { if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI(); }, 500);

                    if (fileHandle) {
                        const writable = await fileHandle.createWritable();
                        await writable.write(pdfBlob);
                        await writable.close();
                    } else {
                        const blobUrl = URL.createObjectURL(pdfBlob);
                        const a = document.createElement('a');
                        a.href = blobUrl;
                        a.download = res.filename || suggestedName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);
                    }
                } catch (e) {
                    if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI();
                    myCloudShowAlert(this.L('error_lbl', 'Error'), e.message);
                }
            };
        }
        
        // 3. Native Share as PDF (Mobile / Modern OS)
        const btnShare = document.getElementById('ceObsBtnPdfShare');
        if (btnShare) {
            btnShare.onclick = async () => {
                const titleInput = document.querySelector('.ce-obs-title-input');
                const suggestedName = ((titleInput ? titleInput.value.trim() : '') || 'Document') + '.pdf';
                
                myCloudCloseModal();
                if (typeof myCloudCreateProgressUI === 'function') myCloudCreateProgressUI(this.L('obs_generating_pdf', 'Generating PDF...'));
                
                try {
                    const { title, html } = await this.buildStandaloneDocumentHTML();
                    const fd = new URLSearchParams({
                        myCloud_action: 'obs_export_pdf',
                        myCloud_key: myCloudState.key,
                        myCloud_token: window.myCloudCsrfToken || '',
                        title: title,
                        html: html
                    });
                    const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                    if (res.status !== 'OK' || !res.token) throw new Error(res.msg || 'PDF conversion failed.');

                    const dlUrl = '?myCloud_token=' + res.token;
                    const pdfBlob = await fetch(dlUrl).then(r => r.blob());

                    if (typeof myCloudUpdateProgressUI === 'function') myCloudUpdateProgressUI(100);
                    setTimeout(() => { if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI(); }, 500);

                    const shareFile = new File([pdfBlob], res.filename || suggestedName, { type: 'application/pdf' });
                    if (navigator.canShare && navigator.canShare({ files: [shareFile] })) {
                        await navigator.share({ files: [shareFile] });
                    } else {
                        throw new Error("Sharing not supported for this file type.");
                    }
                } catch (e) {
                    if (e.name !== 'AbortError') { // Ignore user backing out of share sheet
                        if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI();
                        myCloudShowAlert(this.L('error_lbl', 'Error'), e.message);
                    } else {
                        setTimeout(() => { if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI(); }, 500);
                    }
                }
            };
        }

        // 4. Save PDF to Cloud
        const btnCloud = document.getElementById('ceObsBtnPdfCloud');
        if (btnCloud) {
            btnCloud.onclick = () => {
                    myCloudShowTreeSelector(
                        this.L('obs_pdf_cloud', 'Save PDF to Cloud...'),
                        this.L('save', 'Save'),
                        async (targetDir) => {
                            if (typeof myCloudCreateProgressUI === 'function') myCloudCreateProgressUI(this.L('obs_generating_pdf', 'Generating PDF...'));
                            try {
                                const { title, html } = await this.buildStandaloneDocumentHTML();
                                const isEncTarget = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(targetDir);

                                const fd = new URLSearchParams({
                                    myCloud_action: 'obs_export_pdf',
                                    myCloud_key: myCloudState.key,
                                    myCloud_token: window.myCloudCsrfToken || '',
                                    title: title,
                                    html: html,
                                    save_dir: isEncTarget ? '' : targetDir
                                });
                                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                                if (res.status !== 'OK') throw new Error(res.msg || 'PDF generation failed.');

                                if (isEncTarget && res.token) {
                                    const pdfBlob = await fetch('?myCloud_token=' + res.token).then(r => r.blob());
                                    const pdfFile = new File([pdfBlob], res.filename || (title + '.pdf'), { type: 'application/pdf' });
                                    
                                    if (typeof myCloudUpdateProgressUI === 'function') myCloudUpdateProgressUI(100);
                                    setTimeout(() => { if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI(); }, 500);
                                    
                                    await myCloudUploadFile(pdfFile, targetDir);
                                } else {
                                    if (typeof myCloudUpdateProgressUI === 'function') myCloudUpdateProgressUI(100);
                                    setTimeout(() => { if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI(); }, 500);
                                    
                                    await myCloudFetchDirectory(targetDir, 1, true);
                                    if (typeof myCloudNotify === 'function') myCloudNotify(this.L('obs_pdf_saved', 'PDF saved to ') + targetDir);
                                }
                            } catch (e) {
                                if (typeof myCloudCloseProgressUI === 'function') myCloudCloseProgressUI();
                                myCloudShowAlert(this.L('error_lbl', 'Error'), e.message);
                            }
                        }
                    );
            };
        }
    },

    // ------------------------------------------------------------------------
    // 1.5 NEW NOTE CREATION (RESPECTS .obsidian/app.json newFileLocation)
    // ------------------------------------------------------------------------
    getNewNoteTargetDir: function(explicitFolder = null) {
        if (explicitFolder) return explicitFolder;
        const refPath = this.activeFile || myCloudState.currentDir || '/';
        const vaultRoot = this.getVaultRoot(refPath) || '/';
        const appCfg = this.getAppConfig(refPath);
        const loc = appCfg.newFileLocation || 'current';

        if (loc === 'root') {
            return vaultRoot;
        } else if (loc === 'folder' && appCfg.newFileFolderPath) {
            const cleanSub = appCfg.newFileFolderPath.replace(/^\/+|\/+$/g, '');
            return cleanSub ? (vaultRoot === '/' ? '/' + cleanSub : vaultRoot + '/' + cleanSub) : vaultRoot;
        }
        if (this.activeFile) {
            return this.activeFile.substring(0, this.activeFile.lastIndexOf('/')) || '/';
        }
        return myCloudState.currentDir || vaultRoot;
    },

    promptNewNote: function(explicitFolder = null) {
        if (!window.myCloudActionAllowed('newfile')) return;
        const targetDir = this.getNewNoteTargetDir(explicitFolder);

        myCloudShowInputModal(
            this.L('obs_new_note', 'New Note'),
            this.L('obs_note_title', 'Note Title:'),
            this.L('obs_untitled', 'Untitled'),
            async (rawTitle) => {
                let title = rawTitle.trim();
                if (!title) return;
                if (!title.toLowerCase().endsWith('.md')) title += '.md';

                let finalName = title;
                const isEnc = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(targetDir);
                if (isEnc) {
                    const root = myCloudCrypto.getCryptoRoot(targetDir);
                    if (!myCloudCrypto.isDirUnlocked(root)) {
                        return myCloudAction_EncryptPrompt(root, true, () => this.promptNewNote(targetDir));
                    }
                    finalName = await myCloudCrypto.encryptName(root, title);
                }

                const fd = new URLSearchParams({
                    myCloud_action: 'mkfile',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    parent: targetDir,
                    name: finalName
                });

                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                if (res.status === 'OK') {
                    const newFilePath = (targetDir === '/' ? '' : targetDir) + '/' + finalName;
                    if (isEnc) {
                        if (!myCloudState.pathNames) myCloudState.pathNames = {};
                        myCloudState.pathNames[newFilePath] = title;
                    }
                    if (!myCloudState.openDirs.includes(targetDir)) {
                        myCloudState.openDirs.push(targetDir);
                    }
                    await myCloudFetchDirectory(targetDir, 2, true);
                    await this.openFileInRightPane(newFilePath);
                    myCloudRenderUI();
                } else {
                    myCloudShowAlert(this.L('error_lbl', 'Error'), res.msg || this.L('obs_create_failed', 'Failed to create note.'));
                }
            },
            true
        );
    },

    // ------------------------------------------------------------------------
    // 2. STRICT GRANULAR LAZY LOADER (/script/obsidian_edit/...)
    // ------------------------------------------------------------------------
    loadScriptOnce: function(src) {
        return new Promise((res) => {
            const existing = document.querySelector(`script[src="${src}"]`);
            if (existing) {
                if (existing.dataset.loaded === 'true') return res();
                existing.addEventListener('load', res, { once: true });
                existing.addEventListener('error', res, { once: true });
                return;
            }
            const s = document.createElement('script');
            s.src = src;
            s.onload = () => { s.dataset.loaded = 'true'; res(); };
            s.onerror = () => res();
            document.head.appendChild(s);
        });
    },

    loadCssOnce: function(href, targetRoot = document.head) {
        if (!targetRoot.querySelector(`link[href="${href}"]`)) {
            const l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = href;
            targetRoot.appendChild(l);
        }
    },

    ensureDependenciesForContent: async function(markdownText = '') {
        if (typeof window.marked === 'undefined') {
            await this.loadScriptOnce('/script/obsidian_edit/marked.min.js');
        }
        if (markdownText.includes('```') && typeof window.hljs === 'undefined') {
            this.loadCssOnce('/script/obsidian_edit/highlight.min.css');
            await this.loadScriptOnce('/script/obsidian_edit/highlight.min.js');
        }
        if (markdownText.includes('$') && typeof window.katex === 'undefined') {
            this.loadCssOnce('/script/obsidian_edit/katex.min.css');
            await this.loadScriptOnce('/script/obsidian_edit/katex.min.js');
        }
        if (markdownText.includes('.excalidraw') && typeof window.LZString === 'undefined') {
            await this.loadScriptOnce('/script/obsidian_edit/lz-string.min.js');
        }
    },

    // ------------------------------------------------------------------------
    // 3. ZERO-TRUST HTML SANITIZER & CLEAN TAG UNWRAPPER
    // ------------------------------------------------------------------------
    sanitizeUntrustedHTML: function(dirtyHtml) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(dirtyHtml, 'text/html');

        const forbiddenTags = [
            'script', 'iframe', 'frame', 'frameset', 'object', 'embed', 'applet',
            'form', 'meta', 'base', 'portal', 'link'
        ];
        doc.querySelectorAll(forbiddenTags.join(',')).forEach(el => el.remove());

        doc.querySelectorAll('style').forEach(styleEl => {
            if (styleEl.textContent) {
                styleEl.textContent = styleEl.textContent
                    .replace(/@import/gi, '/* @import blocked */')
                    .replace(/expression\s*\(/gi, '/* expression blocked */')
                    .replace(/url\s*\(\s*['"]?javascript:/gi, 'url( /* script blocked */');
            }
        });

        const allElements = doc.body.querySelectorAll('*');
        allElements.forEach(el => {
            const tag = el.tagName.toLowerCase();

            if (tag === 'input') {
                const type = (el.getAttribute('type') || '').toLowerCase();
                if (!['checkbox', 'radio', 'range'].includes(type)) {
                    el.remove();
                    return;
                }
            }

            Array.from(el.attributes).forEach(attr => {
                const name = attr.name.toLowerCase();
                const val = (attr.value || '').trim();

                if (name.startsWith('on') || name === 'srcdoc' || name === 'formaction') {
                    el.removeAttribute(attr.name);
                    return;
                }

                if (['href', 'src', 'action', 'xlink:href'].includes(name)) {
                    const cleanVal = val.replace(/[\x00-\x20]+/g, '').toLowerCase();
                    if (cleanVal.startsWith('javascript:') || cleanVal.startsWith('vbscript:') || cleanVal.startsWith('data:text/html')) {
                        el.removeAttribute(attr.name);
                        return;
                    }
                }

                if (name === 'style') {
                    if (/expression\s*\(|javascript\s*:|vbscript\s*:/i.test(val)) {
                        el.removeAttribute('style');
                    } else if (/position\s*:\s*fixed/i.test(val)) {
                        el.setAttribute('style', val.replace(/position\s*:\s*fixed/gi, 'position: absolute'));
                    }
                }
            });
        });

        return doc.body.innerHTML;
    },

    cleanInlineStyles: function(rootEl) {
        if (!rootEl) return;
        const isDefaultSize = (s) => {
            if (!s) return true;
            const v = s.trim().toLowerCase();
            return v === '15px' || v === '15pt' || v === '1em' || v === '100%' || v === 'medium' || v === 'var(--font-size-base, 15px)';
        };
        const isDefaultColor = (c) => {
            if (!c) return true;
            const v = c.replace(/\s+/g, '').toLowerCase();
            return v === 'inherit' || v === 'initial' || v === 'currentcolor' || v === 'var(--text-primary)';
        };
        const isDefaultBg = (b) => {
            if (!b) return true;
            const v = b.replace(/\s+/g, '').toLowerCase();
            return v === 'transparent' || v === 'none' || v === 'inherit' || v === 'initial' || v === 'rgba(0,0,0,0)';
        };

        rootEl.querySelectorAll('font').forEach(f => {
            const sz = f.getAttribute('size');
            const col = f.getAttribute('color');
            const sizeMap = { '1': '10px', '2': '13px', '3': '', '4': '18px', '5': '24px', '6': '32px', '7': '48px' };
            const span = document.createElement('span');
            if (sz && sizeMap[sz]) span.style.fontSize = sizeMap[sz];
            if (col && !isDefaultColor(col)) span.style.color = col;
            span.innerHTML = f.innerHTML;
            f.replaceWith(span);
        });

        rootEl.querySelectorAll('span').forEach(sp => {
            if (sp.classList.length > 0) return;
            if (isDefaultSize(sp.style.fontSize)) sp.style.removeProperty('font-size');
            if (isDefaultColor(sp.style.color)) sp.style.removeProperty('color');
            if (isDefaultBg(sp.style.backgroundColor)) {
                sp.style.removeProperty('background-color');
                sp.style.removeProperty('padding');
                sp.style.removeProperty('border-radius');
            }
            const styleAttr = (sp.getAttribute('style') || '').trim();
            if (!styleAttr) {
                const parent = sp.parentNode;
                while (sp.firstChild) parent.insertBefore(sp.firstChild, sp);
                parent.removeChild(sp);
            }
        });
        // Clean up zero-indent attributes
        rootEl.querySelectorAll('[data-indent]').forEach(el => {
            const lvl = parseInt(el.getAttribute('data-indent'), 10) || 0;
            if (lvl <= 0) {
                el.removeAttribute('data-indent');
                el.style.removeProperty('padding-inline-start');
                if (!(el.getAttribute('style') || '').trim()) el.removeAttribute('style');
            }
        });
    },

    // Unwraps all inline formatting tags (<del>, <s>, <strike>, <mark>, <u>, <b>, <strong>, <i>, <em>, <span>) and resets indentation in selection
    removeSelectedFormatting: function(wysiwygPane) {
        if (!wysiwygPane) return;
        document.execCommand('removeFormat');
        const root = this.shadowRoot || document;
        const sel = root.getSelection ? root.getSelection() : window.getSelection();
        if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            const tagsToUnwrap = ['DEL', 'S', 'STRIKE', 'MARK', 'U', 'B', 'STRONG', 'I', 'EM', 'FONT'];
            wysiwygPane.querySelectorAll(tagsToUnwrap.join(',')).forEach(el => {
                if (range.intersectsNode(el)) {
                    const parent = el.parentNode;
                    while (el.firstChild) parent.insertBefore(el.firstChild, el);
                    parent.removeChild(el);
                }
            });
            wysiwygPane.querySelectorAll('[data-indent]').forEach(el => {
                if (range.intersectsNode(el)) {
                    el.removeAttribute('data-indent');
                    el.style.removeProperty('padding-inline-start');
                    if (!(el.getAttribute('style') || '').trim()) el.removeAttribute('style');
                }
            });
        }
        this.cleanInlineStyles(wysiwygPane);
    },

    // Persistently increases or decreases block indentation in WYSIWYG mode
    adjustWysiwygIndent: function(wysiwygPane, delta) {
        if (!wysiwygPane) return;
        const root = this.shadowRoot || document;
        const sel = root.getSelection ? root.getSelection() : window.getSelection();
        if (!sel || sel.rangeCount === 0) return;

        const range = sel.getRangeAt(0);
        if (!wysiwygPane.contains(range.commonAncestorContainer)) return;

        const getTargetBlock = (node) => {
            let curr = (node.nodeType === Node.TEXT_NODE) ? node.parentElement : node;
            while (curr && curr !== wysiwygPane) {
                if (/^(P|DIV|LI|H[1-5]|BLOCKQUOTE)$/.test(curr.tagName)) return curr;
                curr = curr.parentElement;
            }
            return null;
        };

        const blocks = new Set();
        const startBlock = getTargetBlock(range.startContainer);
        if (startBlock) blocks.add(startBlock);

        if (!range.collapsed) {
            wysiwygPane.querySelectorAll('p, div, li, h1, h2, h3, h4, h5, blockquote').forEach(b => {
                if (range.intersectsNode(b)) blocks.add(b);
            });
        }

        // If typing directly in the root pane without a block wrapper, wrap current line in a <div>
        if (blocks.size === 0) {
            document.execCommand('formatBlock', false, 'DIV');
            const newBlock = getTargetBlock(sel.anchorNode);
            if (newBlock) blocks.add(newBlock);
        }

        blocks.forEach(b => {
            let currentIndent = parseInt(b.getAttribute('data-indent'), 10);
            if (isNaN(currentIndent)) {
                const pad = parseInt(b.style.paddingInlineStart || b.style.marginLeft || '0', 10);
                currentIndent = pad > 0 ? Math.round(pad / 28) : 0;
            }
            const nextIndent = Math.max(0, Math.min(10, currentIndent + delta));
            if (nextIndent === 0) {
                b.removeAttribute('data-indent');
                b.style.removeProperty('padding-inline-start');
                if (!(b.getAttribute('style') || '').trim()) b.removeAttribute('style');
            } else {
                b.setAttribute('data-indent', String(nextIndent));
                b.style.paddingInlineStart = (nextIndent * 28) + 'px';
            }
        });
    },

    // Opens the custom myCloudShowInputModal for Link / WikiLink insertion without losing editor selection
    promptInsertLink: function(wysiwygPane, textarea, insertWysiwygHTMLFn) {
        const isWysiwyg = (this.viewMode === 'wysiwyg');
        const root = this.shadowRoot || document;
        const sel = root.getSelection ? root.getSelection() : window.getSelection();
        let savedRange = null;
        let selectedText = '';

        if (isWysiwyg && sel && sel.rangeCount > 0) {
            savedRange = sel.getRangeAt(0).cloneRange();
            selectedText = savedRange.toString().trim();
        } else if (!isWysiwyg && textarea) {
            selectedText = textarea.value.substring(textarea.selectionStart, textarea.selectionEnd).trim();
        }

        myCloudShowInputModal(
            this.L('obs_tip_link', 'Insert Hyperlink or [[WikiLink]]'),
            this.L('obs_prompt_link', 'Enter URL or [[WikiLink]]:'),
            'https://',
            (rawUrl) => {
                const url = rawUrl.trim();
                if (!url) return;

                if (isWysiwyg && wysiwygPane) {
                    wysiwygPane.focus();
                    if (savedRange) {
                        const activeSel = root.getSelection ? root.getSelection() : window.getSelection();
                        activeSel.removeAllRanges();
                        activeSel.addRange(savedRange);
                    }
                    if (url.startsWith('[[') && url.endsWith(']]')) {
                        const inner = url.slice(2, -2);
                        const parts = inner.split('|');
                        const target = parts[0].trim().replace(/"/g, '&quot;');
                        const label = (parts[1] || selectedText || parts[0]).trim().replace(/\.md$/i, '');
                        insertWysiwygHTMLFn(`<a href="#" class="ce-obs-wikilink" data-target="${target}">${label}</a>`);
                    } else {
                        const safeHref = url.replace(/"/g, '&quot;');
                        const label = (selectedText || url).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                        insertWysiwygHTMLFn(`<a href="${safeHref}">${label}</a>`);
                    }
                } else if (textarea) {
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    const rep = url.startsWith('[[') ? url : `[${selectedText || url}](${url})`;
                    textarea.setRangeText(rep, start, end, 'select');
                    textarea.dispatchEvent(new Event('input'));
                    textarea.focus();
                }
            },
            false
        );
    },

    // ------------------------------------------------------------------------
    // 4. OPENING, ABORTING STALE FETCHES & MOBILE/TABLET NAVIGATION
    // ------------------------------------------------------------------------
    abortPendingFetches: function() {
        if (this.abortController) {
            try { this.abortController.abort(); } catch (e) {}
        }
        this.abortController = new AbortController();
        return this.abortController.signal;
    },

    flushPendingSave: function() {
        clearTimeout(this.idleSaveTimer);
        clearTimeout(this.forceSaveTimer);
        this.forceSaveTimer = null;

        if (!this.isDirty || !this.activeFile) return null;

        const textarea = document.getElementById('ceObsTextarea');
        if (this.viewMode === 'wysiwyg' && this.shadowRoot) {
            const wysiwygPane = this.shadowRoot.querySelector('#ceObsWysiwygPane');
            if (wysiwygPane) this.syncWysiwygToMarkdown(wysiwygPane);
        } else if (textarea) {
            this.activeContent = textarea.value;
        }

        const fileToSave = this.activeFile;
        const contentToSave = this.activeContent;
        this.originalContent = contentToSave;
        this.isDirty = false;
        const dot = document.getElementById('ceObsDirtyDot');
        if (dot) dot.classList.remove('active');

        return this.saveCurrentFile(fileToSave, contentToSave);
    },

    isPhoneDevice: function() {
        if (typeof myCloudGetCurrentDeviceKey === 'function') {
            return myCloudGetCurrentDeviceKey() === 'phone';
        }
        if (typeof myCloudDevice !== 'undefined') {
            return myCloudDevice.type === 'phone' || myCloudDevice.type === 'foldable-folded';
        }
        return window.innerWidth < 600;
        return false;
    },

    canGoBackNote: function() {
        return Array.isArray(this.noteHistory) && this.noteHistoryIdx > 0;
    },

    canGoForwardNote: function() {
        return Array.isArray(this.noteHistory) && this.noteHistoryIdx >= 0 && this.noteHistoryIdx < this.noteHistory.length - 1;
    },

    navigateNoteHistory: function(delta) {
        if (!Array.isArray(this.noteHistory)) return;
        const targetIdx = this.noteHistoryIdx + delta;
        if (targetIdx < 0 || targetIdx >= this.noteHistory.length) return;
        this.hideInstantTooltip();
        this._isHistoryNav = true;
        this.noteHistoryIdx = targetIdx;
        const targetFile = this.noteHistory[targetIdx];
        this.openFileInRightPane(targetFile).finally(() => {
            this._isHistoryNav = false;
        });
    },

    updateHistoryButtonsDOM: function(ws) {
        const root = ws || document;
        const backBtn = root.querySelector('#ceObsHistBackBtn');
        const fwdBtn = root.querySelector('#ceObsHistFwdBtn');
        if (backBtn) backBtn.disabled = !this.canGoBackNote();
        if (fwdBtn) fwdBtn.disabled = !this.canGoForwardNote();
    },

    handleBackNavigation: function() {
        this.hideInstantTooltip();
        this.abortPendingFetches();
        if (window.myCloudActionAllowed('edit_file')) {
            this.flushPendingSave();
        }
        this.activeFile = null;

        if (this.treeAutoHidden && !myCloudTreeVisible && typeof myCloudToggleTree === 'function') {
            myCloudToggleTree();
            this.treeAutoHidden = false;
        }

        myCloudState.forceObsidianFolderGrid = true;
        myCloudRenderUI();
        myCloudState.forceObsidianFolderGrid = false;
        if (typeof myCloudUpdateToolbarState === 'function') myCloudUpdateToolbarState();
    },

    openFileInRightPane: async function(filePath, targetContainer = null) {
        const container = targetContainer || document.querySelector('.myCloudDetails');
        if (!container) return;

        if (this.isDirty && this.activeFile && this.activeFile !== filePath) {
            this.flushPendingSave();
        }

        const signal = this.abortPendingFetches();

        if (this.isPhoneDevice() && typeof myCloudTreeVisible !== 'undefined' && myCloudTreeVisible && typeof myCloudToggleTree === 'function') {
            myCloudToggleTree();
            this.treeAutoHidden = true;
        }

        const vaultRoot = this.getVaultRoot(filePath);
        if (vaultRoot) {
            this.loadVaultPlugins(vaultRoot);
        }

        let content = '';
        const isEnc = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(filePath);
        try {
            if (isEnc) {
                const root = myCloudCrypto.getCryptoRoot(filePath);
                if (!myCloudCrypto.isDirUnlocked(root)) {
                    return myCloudAction_EncryptPrompt(root, true, () => this.openFileInRightPane(filePath, container));
                }
                const fd = new URLSearchParams({
                    myCloud_action: 'get_download_token',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: filePath,
                    filename: filePath.split('/').pop(),
                    preview: '0'
                });
                const tRes = await fetch('', { method: 'POST', body: fd, signal }).then(r => r.json());
                if (signal.aborted) return;
                if (tRes.status === 'OK') {
                    const encBlob = await fetch('?myCloud_token=' + tRes.token, { signal }).then(r => r.blob());
                    if (signal.aborted) return;
                    const decBlob = await myCloudCrypto.decryptFile(root, encBlob);
                    if (signal.aborted) return;
                    content = await decBlob.text();
                }
            } else {
                const fd = new URLSearchParams({
                    myCloud_action: 'edit-fetch',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: filePath
                });
                const res = await fetch('', { method: 'POST', body: fd, signal }).then(r => r.json());
                if (signal.aborted) return;
                if (res.status === 'OK') content = res.content || '';
            }
        } catch (err) {
            if (err && err.name === 'AbortError') return;
            console.error("Obsidian Read Error:", err);
        }

        if (signal.aborted) return;

        await this.ensureDependenciesForContent(content);
        if (signal.aborted) return;

        if (!Array.isArray(this.noteHistory)) {
            this.noteHistory = [];
            this.noteHistoryIdx = -1;
        }
        if (!this._isHistoryNav) {
            if (this.noteHistoryIdx < this.noteHistory.length - 1) {
                this.noteHistory = this.noteHistory.slice(0, this.noteHistoryIdx + 1);
            }
            if (this.noteHistory[this.noteHistory.length - 1] !== filePath) {
                this.noteHistory.push(filePath);
                this.noteHistoryIdx = this.noteHistory.length - 1;
            }
        }

        this.activeFile = filePath;
        this.activeContent = content;
        this.originalContent = content;
        this.isDirty = false;
        this.viewMode = 'wysiwyg';
        myCloudState.currentFile = filePath;
        myCloudState.selectedFiles = [filePath];
        if (typeof window.myCloudEnsureHistoryTrap === 'function') window.myCloudEnsureHistoryTrap();

        this.renderWorkspaceDOM(container, signal);
        if (typeof myCloudUpdateToolbarState === 'function') myCloudUpdateToolbarState();
    },

    renderWorkspaceDOM: function(container, signal = null) {
        const activeSignal = signal || (this.abortController ? this.abortController.signal : null);
        const canEdit = window.myCloudActionAllowed('edit_file');

        let displayName = (myCloudState.pathNames && myCloudState.pathNames[this.activeFile])
            ? myCloudState.pathNames[this.activeFile]
            : this.activeFile.split('/').pop().replace(/\.enc$/, '');
        displayName = displayName.replace(/\.md$/i, '');

        const safeTitle = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(displayName) : displayName;

        container.innerHTML = '';

        const isCodeMode = (this.viewMode === 'code' && canEdit);

        const ws = document.createElement('div');
        ws.className = 'ce-obs-workspace';
        ws.style.setProperty('--obs-zoom', this.zoomScale);

        ['mousedown', 'mouseup', 'click', 'dblclick', 'contextmenu', 'selectstart'].forEach(evtName => {
            ws.addEventListener(evtName, (e) => e.stopPropagation());
        });

        ws.addEventListener('contextmenu', (e) => {
            if (!e.defaultPrevented) {
                e.preventDefault();
            }
        });

        ws.innerHTML = `
            ${canEdit ? this.getToolbarHTML() : this.getReadonlyToolbarHTML()}
            <div id="ceObsFindBar" class="ce-obs-find-bar">
                <input type="text" id="ceObsFindInput" class="ce-obs-find-input" placeholder="${this.L('obs_find_placeholder', 'Find in note...')}">
                <input type="text" id="ceObsReplaceInput" class="ce-obs-find-input" placeholder="${this.L('obs_replace_placeholder', 'Replace with...')}">
                <button type="button" id="ceObsFindNextBtn" class="ce-obs-find-btn">${this.L('obs_find_next', 'Find')}</button>
                <button type="button" id="ceObsReplaceBtn" class="ce-obs-find-btn">${this.L('obs_replace_all', 'Replace All')}</button>
                <button type="button" id="ceObsVaultReplaceBtn" class="ce-obs-find-btn" title="${this.L('obs_vault_replace', 'Search & Replace in Vault...')}">🌐 ${this.L('obs_vault_btn', 'Vault...')}</button>
                <button type="button" id="ceObsFindCloseBtn" class="ce-obs-find-btn" style="margin-inline-start:auto;">✕</button>
            </div>
            <div class="ce-obs-body">
                <input type="text" class="ce-obs-title-input" value="${safeTitle}" placeholder="${this.L('obs_doc_title_placeholder', 'Document Title...')}" spellcheck="false" ${canEdit ? '' : 'readonly'}>
                <div id="ceObsShadowHost" style="display:${isCodeMode ? 'none' : 'flex'}; flex:1 0 auto; width:100%;"></div>
                <div id="ceObsEditorPane" class="ce-obs-editor-pane" style="display:${isCodeMode ? 'flex' : 'none'};">
                    <textarea id="ceObsTextarea" class="ce-obs-textarea" dir="auto" placeholder="${this.L('obs_editor_placeholder', 'Type Markdown, HTML, or paste Excel tables / images...')}"></textarea>
                </div>
            </div>
            <div class="ce-obs-statusbar">
                <span id="ceObsZoomBadge" class="ce-obs-zoom-badge" data-tip="${this.L('obs_tip_zoom_reset', 'Click to reset zoom to 100% (Ctrl+Scroll or Pinch to zoom)')}">${Math.round(this.zoomScale * 100)}%</span>
                <span id="ceObsStatsWords">0 ${this.L('obs_words', 'words')}</span>
                <span id="ceObsStatsChars">0 ${this.L('obs_chars', 'chars')}</span>
                <span id="ceObsStatsRead">1 ${this.L('obs_min_read', 'min read')}</span>
            </div>
        `;

        container.appendChild(ws);

        const tb = ws.querySelector('.ce-obs-toolbar');
        if (tb) tb.addEventListener('contextmenu', e => { e.preventDefault(); e.stopPropagation(); });
        const findBar = ws.querySelector('#ceObsFindBar');
        if (findBar) findBar.addEventListener('contextmenu', e => { e.preventDefault(); e.stopPropagation(); });

        const shadowHost = ws.querySelector('#ceObsShadowHost');
        this.shadowRoot = shadowHost.attachShadow({ mode: 'open' });

        // Track shift key for paste formatting preference
        ws.addEventListener('keydown', (e) => { this._shiftHeldPaste = e.shiftKey; }, {capture: true});
        ws.addEventListener('keyup', (e) => { this._shiftHeldPaste = e.shiftKey; }, {capture: true});

        this.shadowRoot.innerHTML = `
            <style>
                :host { display: flex; flex: 1 0 auto; width: 100%; }
                .ce-obs-wysiwyg-pane {
                    flex: 1 0 auto; min-height: 450px; width: 100%; padding: 6px 32px 48px;
                    box-sizing: border-box; outline: none; line-height: 1.55;
                    font-family: var(--font-family, "Segoe UI", sans-serif);
                    font-size: calc(var(--font-size-base, 15px) * var(--obs-zoom, 1));
                    color: var(--text-primary, #202020);
                    background: var(--gray-00, #ffffff); word-wrap: break-word;
                    user-select: text !important; -webkit-user-select: text !important; cursor: text;
                }
                .ce-obs-wysiwyg-pane p, .ce-obs-wysiwyg-pane div { margin: 0 0 0.45em 0; }
                .ce-obs-wysiwyg-pane h1, .ce-obs-wysiwyg-pane h2, .ce-obs-wysiwyg-pane h3, .ce-obs-wysiwyg-pane h4, .ce-obs-wysiwyg-pane h5 { margin: 0.65em 0 0.3em 0; line-height: 1.25; }
                .ce-obs-wysiwyg-pane ul, .ce-obs-wysiwyg-pane ol { margin: 0.35em 0 0.55em 0; padding-inline-start: 24px; }
                .ce-obs-wysiwyg-pane del, .ce-obs-wysiwyg-pane s, .ce-obs-wysiwyg-pane strike { text-decoration: line-through; opacity: 0.85; }
                .ce-obs-wysiwyg-pane a { color: var(--accent-primary, #0078d4); text-decoration: underline; cursor: pointer; }
                mark, .ce-obs-highlight { background-color: rgba(255, 208, 0, 0.4); color: inherit; padding: 1px 4px; border-radius: 3px; }
                .ce-obs-callout { margin: 10px 0; padding: 10px 14px; border-inline-start: 4px solid var(--accent-primary, #0078d4); background: rgba(0, 120, 212, 0.06); border-radius: 4px; }
                .ce-obs-callout-title { font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; text-transform: capitalize; }
                .ce-obs-callout[data-callout="warning"], .ce-obs-callout[data-callout="caution"] { border-inline-start-color: #f0ad4e; background: rgba(240, 173, 78, 0.1); }
                .ce-obs-callout[data-callout="danger"], .ce-obs-callout[data-callout="error"] { border-inline-start-color: #e81123; background: rgba(232, 17, 35, 0.1); }
                .ce-obs-callout[data-callout="success"], .ce-obs-callout[data-callout="check"] { border-inline-start-color: #107c10; background: rgba(16, 124, 16, 0.1); }
                .ce-obs-multicol { display: flex; flex-wrap: wrap; gap: 16px; margin: 10px 0; width: 100%; align-items: flex-start; }
                .ce-obs-col { flex: 1; min-width: 200px; background: var(--gray-05, #f8f8f8); padding: 12px; border-radius: 6px; border: 1px solid var(--border-default, #e0e0e0); }
                .ce-obs-code-block { margin: 10px 0; border-radius: 6px; overflow: hidden; border: 1px solid #3e3e42; background: #1e1e1e; color: #d4d4d4; direction: ltr; text-align: left; }
                .ce-obs-code-header { display: flex; justify-content: space-between; align-items: center; padding: 5px 12px; background: #2d2d30; font-size: 12px; font-family: monospace; color: #ccc; border-bottom: 1px solid #3e3e42; }
                .ce-obs-code-copy { background: transparent; border: 1px solid #555; color: #ccc; border-radius: 4px; padding: 2px 8px; font-size: 11px; cursor: pointer; }
                .ce-obs-code-lines { margin: 0; padding: 10px 0; overflow-x: auto; font-family: "Cascadia Code", Consolas, monospace; font-size: 13px; line-height: 1.45; }
                .ce-obs-code-line { display: flex; padding: 0 12px; }
                .ce-obs-code-line.highlighted { background: rgba(255, 215, 0, 0.18); border-inline-start: 3px solid #ffd700; }
                .ce-obs-line-num { user-select: none; color: #6e7681; min-width: 32px; padding-inline-end: 12px; text-align: right; }
                .ce-obs-table { border-collapse: collapse; width: 100%; margin: 10px 0; }
                .ce-obs-table th, .ce-obs-table td { border: 1px solid var(--border-default, #ccc); padding: 6px 10px; }
                .ce-obs-table th { background: var(--gray-10, #f0f0f0); font-weight: 600; cursor: pointer; }
                .ce-obs-wikilink { color: var(--accent-primary, #0078d4); text-decoration: none; border-bottom: 1px dashed var(--accent-primary, #0078d4); cursor: pointer; }
                .ce-obs-inline-tag { display: inline-block; background: rgba(0, 120, 212, 0.12); color: var(--accent-primary, #0078d4); padding: 1px 8px; border-radius: 12px; font-size: 0.85em; }
                img { max-width: 100%; height: auto; border-radius: 4px; }
                @media (max-width: 768px) {
                    .ce-obs-wysiwyg-pane { padding: 6px 16px 36px; }
                }
            </style>
            <div id="ceObsWysiwygPane" class="ce-obs-wysiwyg-pane" contenteditable="${canEdit ? 'true' : 'false'}" dir="auto"></div>
        `;

        const wysiwygPane = this.shadowRoot.querySelector('#ceObsWysiwygPane');
        const textarea = ws.querySelector('#ceObsTextarea');
        const autoResizeTextarea = () => {
            if (!textarea || textarea.offsetParent === null) return;
            textarea.style.height = 'auto';
            textarea.style.height = Math.max(480, textarea.scrollHeight) + 'px';
        };
        if (textarea) {
            textarea.value = this.activeContent;
            if (isCodeMode) setTimeout(autoResizeTextarea, 0);
        }

        this.bindZoomGestures(ws);
        this.bindFindReplaceBar(ws, wysiwygPane, textarea);
        this.initToolbarScrollIndicators(ws);
        this.bindInstantTooltips(ws);
        this.updateHistoryButtonsDOM(ws);

        const histBackBtn = ws.querySelector('#ceObsHistBackBtn');
        if (histBackBtn) {
            histBackBtn.onclick = () => this.navigateNoteHistory(-1);
        }
        const histFwdBtn = ws.querySelector('#ceObsHistFwdBtn');
        if (histFwdBtn) {
            histFwdBtn.onclick = () => this.navigateNoteHistory(1);
        }

        // Bind Save Needed Indicator Click (Manual Save)
        const dirtyIndicator = ws.querySelector('#ceObsDirtyDot');
        if (dirtyIndicator && canEdit) {
            dirtyIndicator.onclick = () => {
                this.hideInstantTooltip();
                if (this.viewMode === 'wysiwyg' && wysiwygPane) this.syncWysiwygToMarkdown(wysiwygPane);
                else if (textarea) this.activeContent = textarea.value;
                this.saveCurrentFile();
            };
        }

        // Auto-Rename Title Logic
        const titleInput = ws.querySelector('.ce-obs-title-input');
        if (titleInput) {
            titleInput.addEventListener('contextmenu', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (canEdit) this.showObsidianContextMenu(e, ws, titleInput);
            });
            if (canEdit) {
            let currentSafeTitle = safeTitle;
            const handleRename = async () => {
                const newTitle = titleInput.value.trim();
                if (!newTitle) { titleInput.value = currentSafeTitle; return; }
                if (newTitle !== currentSafeTitle) {
                    const newName = newTitle + '.md';
                    const parentDir = this.activeFile.substring(0, this.activeFile.lastIndexOf('/')) || '/';
                    let finalName = newName;
                    if (typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(parentDir)) {
                        const root = myCloudCrypto.getCryptoRoot(parentDir);
                        finalName = await myCloudCrypto.encryptName(root, newName);
                    }
                    const fd = new URLSearchParams({
                        myCloud_action: 'rename', myCloud_key: myCloudState.key, myCloud_token: window.myCloudCsrfToken || '',
                        src: this.activeFile, newName: finalName
                    });
                    const res = await fetch('', {method:'POST', body: fd}).then(r=>r.json());
                    if (res.status === 'OK') {
                        const oldFile = this.activeFile;
                        this.activeFile = res.newPath;
                        myCloudState.currentFile = this.activeFile;
                        myCloudState.selectedFiles = [this.activeFile];
                        if (!myCloudState.pathNames) myCloudState.pathNames = {};
                        myCloudState.pathNames[this.activeFile] = newTitle;
                        currentSafeTitle = newTitle;
                        
                        const item = myCloudState.allItems.find(i => i.name === oldFile);
                        if (item) item.name = this.activeFile;

                        const treeNode = document.querySelector(`.myCloudTreeList div[data-fullpath="${CSS.escape(oldFile)}"]`);
                        if (treeNode) {
                            treeNode.dataset.fullpath = this.activeFile;
                            const textSpan = treeNode.querySelector('span:not(.myCloudToggle):not(.myCloudIcon)');
                            if (textSpan) textSpan.textContent = newTitle;
                        }

                        if (typeof myCloudFetchDirectory === 'function') {
                            myCloudFetchDirectory(parentDir, 2, true);
                        }
                    } else {
                        myCloudShowAlert(this.L('error_lbl', 'Error'), (this.L('obs_rename_failed', 'Rename failed:') + ' ' + res.msg));
                        titleInput.value = currentSafeTitle;
                    }
                }
            };
            
            titleInput.addEventListener('blur', handleRename);
            titleInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    titleInput.blur();
                }
            });
			}
        }

        const folderBtn = ws.querySelector('#ceObsFolderGridBtn');
        if (folderBtn) {
            folderBtn.onclick = () => this.handleBackNavigation();
        }

        const newNoteBtn = ws.querySelector('#ceObsNewNoteBtn');
        if (newNoteBtn) {
            newNoteBtn.onclick = () => {
                this.hideInstantTooltip();
                this.promptNewNote();
            };
        }

        ws.querySelectorAll('.ce-obs-delete-note-btn').forEach(btn => {
            btn.onclick = () => {
                this.hideInstantTooltip();
                if (!window.myCloudActionAllowed('delete')) return;
                
                const isRecycleBin = (myCloudState.currentDir === '/.recycle_bin');
                const settings = myCloudState.settings || {};
                const useRecycle = (typeof settings.enableRecycleBin !== 'undefined') ? settings.enableRecycleBin : true;
                const isPermanent = isRecycleBin || !useRecycle;
                
                if (typeof window.myCloudShowDeleteConfirm === 'function') {
                    window.myCloudShowDeleteConfirm(1, isPermanent, () => {
                        if (typeof window.myCloudShowLoading === 'function') window.myCloudShowLoading();
                        
                        const fd = new URLSearchParams();
                        fd.append('myCloud_action', 'delete');
                        fd.append('myCloud_key', myCloudState.key);
                        fd.append('myCloud_token', window.myCloudCsrfToken || '');
                        fd.append('src', this.activeFile);
                        if (isPermanent) fd.append('permanent', 'true');
                        if (useRecycle && !isRecycleBin) fd.append('useRecycleBin', 'true');
                        
                        fetch('', {method:'POST', body:fd})
                        .then(r => r.json())
                        .then(res => {
                            if (typeof window.myCloudHideLoading === 'function') window.myCloudHideLoading();
                            if (res.status !== 'OK') throw new Error(res.msg || 'Delete Failed');
                            if (res.recycled && typeof window.myCloudShowUndoToast === 'function') window.myCloudShowUndoToast([res.recycled]);
                            if (typeof window.myCloudSurgicalRemove === 'function') window.myCloudSurgicalRemove([this.activeFile]);
                            
                            const parentDir = this.activeFile.substring(0, this.activeFile.lastIndexOf('/')) || '/';
                            if (typeof window.myCloudFetchDirectory === 'function') window.myCloudFetchDirectory(parentDir, 2, true);
                            
                            this.isDirty = false;
                            this.handleBackNavigation();
                        }).catch(err => {
                            if (typeof window.myCloudHideLoading === 'function') window.myCloudHideLoading();
                            if (typeof window.myCloudShowAlert === 'function') window.myCloudShowAlert(this.L('error_prefix', 'Error'), err.message);
                        });
                    });
                }
            };
        });

        if (wysiwygPane && canEdit) {
            const updateSelectionUI = () => this.updateToolbarActiveStates(ws, wysiwygPane);
            wysiwygPane.addEventListener('keyup', updateSelectionUI);
            wysiwygPane.addEventListener('mouseup', updateSelectionUI);

            wysiwygPane.addEventListener('input', () => {
                this.isDirty = true;
                const dot = document.getElementById('ceObsDirtyDot');
                if (dot) dot.classList.add('active');
                this.updateStatusBar(wysiwygPane.innerText || '');
                this.checkWikiLinkTrigger(ws, wysiwygPane, null);
                this.scheduleSave(wysiwygPane, textarea);
            });
            wysiwygPane.addEventListener('paste', (e) => this.handlePaste(e, textarea, wysiwygPane));

            wysiwygPane.addEventListener('dragover', (e) => e.preventDefault());
            wysiwygPane.addEventListener('drop', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    for (let file of e.dataTransfer.files) {
                        await this.uploadToZAttachments(file, textarea, wysiwygPane);
                    }
                }
            });

            wysiwygPane.addEventListener('keydown', (e) => {
                e.stopPropagation();
				if (this.handleWikiLinkKeydown(e, ws)) return;
                this.handleWysiwygKeydown(e, ws, wysiwygPane);
            });

            wysiwygPane.addEventListener('contextmenu', (e) => {
				e.preventDefault();
                this.showObsidianContextMenu(e, ws, wysiwygPane);
            });
        }

        if (textarea && canEdit) {
            textarea.addEventListener('contextmenu', (e) => {
                e.preventDefault();
                e.stopPropagation();
                this.showObsidianContextMenu(e, ws, textarea);
            });
            textarea.addEventListener('input', () => {
                this.activeContent = textarea.value;
                this.isDirty = (this.activeContent !== this.originalContent);
                const dot = document.getElementById('ceObsDirtyDot');
                if (dot) dot.classList.toggle('active', this.isDirty);
                autoResizeTextarea();
                this.updateStatusBar(textarea.value);
                this.checkWikiLinkTrigger(ws, null, textarea);
                this.scheduleSave(wysiwygPane, textarea);
            });
            textarea.addEventListener('paste', (e) => this.handlePaste(e, textarea, wysiwygPane));

            textarea.addEventListener('dragover', (e) => e.preventDefault());
            textarea.addEventListener('drop', async (e) => {
                e.preventDefault(); e.stopPropagation();
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    for (let file of e.dataTransfer.files) {
                        await this.uploadToZAttachments(file, textarea, wysiwygPane);
                    }
                }
            });

            textarea.addEventListener('keydown', (e) => {
                e.stopPropagation();
				if (this.handleWikiLinkKeydown(e, ws)) return;
                this.handleEditorKeydown(e, textarea);
            });
        }

        this.bindToolbarActions(ws, textarea, wysiwygPane, autoResizeTextarea);
        this.updatePreview(wysiwygPane, activeSignal);
        this.updateStatusBar(this.activeContent);
    },

    // ------------------------------------------------------------------------
    // 4.5 INSTANT TOOLTIPS, SCROLL INDICATORS, ZOOM GESTURES & STATUS BAR
    // ------------------------------------------------------------------------
    hideInstantTooltip: function() {
        clearTimeout(this.tipTimer);
        const existing = document.getElementById('ceObsFloatingTip');
        if (existing) existing.remove();
    },

    bindInstantTooltips: function(ws) {
        ws.querySelectorAll('[data-tip]').forEach(el => {
            let lastX = 0, lastY = 0;
            const onMouseMove = (ev) => {
                lastX = ev.clientX;
                lastY = ev.clientY;
            };
            el.addEventListener('mouseenter', (e) => {
                this.hideInstantTooltip();
                lastX = e.clientX;
                lastY = e.clientY;
                el.addEventListener('mousemove', onMouseMove, { passive: true });
                const text = el.getAttribute('data-tip');
                if (!text) return;
                this.tipTimer = setTimeout(() => {
                    if (!document.body.contains(el)) return;
                    const tip = document.createElement('div');
                    tip.id = 'ceObsFloatingTip';
                    tip.className = 'ce-obs-instant-tip';
                    tip.textContent = text;
                    document.body.appendChild(tip);

                    const rect = el.getBoundingClientRect();
                    let left = rect.left + (rect.width / 2) - (tip.offsetWidth / 2);
                    // Place tooltip ABOVE the button by default so the downward-pointing cursor never covers it
                    let top = rect.top - tip.offsetHeight - 8;

                    // If there is insufficient room above the toolbar, place it BELOW with full clearance past the cursor
                    if (top < 6) {
                        top = Math.max(rect.bottom + 14, lastY + 22);
                    }
                    if (left < 8) left = 8;
                    if (left + tip.offsetWidth > window.innerWidth - 8) {
                        left = window.innerWidth - tip.offsetWidth - 8;
                    }
                    if (top + tip.offsetHeight > window.innerHeight - 8) {
                        top = window.innerHeight - tip.offsetHeight - 8;
                    }
					if (top < 4) top = 4;
                    tip.style.left = left + 'px';
                    tip.style.top = top + 'px';
                    requestAnimationFrame(() => tip.classList.add('show'));
                }, 40);
            });
            const cleanup = () => {
                el.removeEventListener('mousemove', onMouseMove);
                this.hideInstantTooltip();
            };
            el.addEventListener('mouseleave', cleanup);
            el.addEventListener('mousedown', cleanup);
            el.addEventListener('click', cleanup);
            el.addEventListener('touchstart', cleanup, { passive: true });
        });
    },

    initToolbarScrollIndicators: function(ws) {
        ws.querySelectorAll('.ce-obs-toolbar-row-wrap').forEach(wrap => {
            const row = wrap.querySelector('.ce-obs-toolbar-row');
            const leftHint = wrap.querySelector('.ce-obs-row-scroll-hint.left');
            const rightHint = wrap.querySelector('.ce-obs-row-scroll-hint.right');
            if (!row || !leftHint || !rightHint) return;

            const updateHints = () => {
                const maxScroll = row.scrollWidth - row.clientWidth;
                if (maxScroll <= 4) {
                    leftHint.classList.remove('visible');
                    rightHint.classList.remove('visible');
                    return;
                }
                const sl = Math.abs(row.scrollLeft);
                leftHint.classList.toggle('visible', sl > 4);
                rightHint.classList.toggle('visible', sl < maxScroll - 4);
            };

            row.addEventListener('scroll', updateHints, { passive: true });
            row.addEventListener('wheel', (e) => {
                if (e.deltaY !== 0 && !e.ctrlKey && row.scrollWidth > row.clientWidth) {
                    e.preventDefault();
                    row.scrollLeft += e.deltaY;
                }
            }, { passive: false });
            window.addEventListener('resize', updateHints, { passive: true });
            setTimeout(updateHints, 60);
        });
    },

    bindZoomGestures: function(ws) {
        const applyZoom = (newScale) => {
            this.zoomScale = Math.min(2.5, Math.max(0.5, Math.round(newScale * 20) / 20));
            localStorage.setItem('myCloudObsidianZoom', this.zoomScale);
			ws.style.setProperty('--obs-zoom', this.zoomScale);
            const badge = ws.querySelector('#ceObsZoomBadge');
            if (badge) badge.textContent = Math.round(this.zoomScale * 100) + '%';
        };

        const badge = ws.querySelector('#ceObsZoomBadge');
        if (badge) {
            badge.onclick = () => applyZoom(1.0);
        }

        ws.addEventListener('wheel', (e) => {
            if (e.ctrlKey || e.metaKey) {
                e.preventDefault();
                e.stopPropagation();
                const delta = e.deltaY < 0 ? 0.1 : -0.1;
                applyZoom(this.zoomScale + delta);
            }
        }, { passive: false });

        let initialPinchDist = null;
        let startZoom = 1.0;
        ws.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
                const dx = e.touches[0].clientX - e.touches[1].clientX;
                const dy = e.touches[0].clientY - e.touches[1].clientY;
                initialPinchDist = Math.hypot(dx, dy);
                startZoom = this.zoomScale;
            }
        }, { passive: true });

        ws.addEventListener('touchmove', (e) => {
            if (e.touches.length === 2 && initialPinchDist) {
                e.preventDefault();
                const dx = e.touches[0].clientX - e.touches[1].clientX;
                const dy = e.touches[0].clientY - e.touches[1].clientY;
                const dist = Math.hypot(dx, dy);
                const ratio = dist / initialPinchDist;
                applyZoom(startZoom * ratio);
            }
        }, { passive: false });

        ws.addEventListener('touchend', () => { initialPinchDist = null; }, { passive: true });
    },

    updateStatusBar: function(rawText) {
        const clean = (rawText || '').replace(/^---\r?\n[\s\S]*?\r?\n---/, '').trim();
        const words = clean ? clean.split(/\s+/).filter(Boolean).length : 0;
        const chars = clean.length;
        const mins = Math.max(1, Math.ceil(words / 200));

        const wEl = document.getElementById('ceObsStatsWords');
        const cEl = document.getElementById('ceObsStatsChars');
        const rEl = document.getElementById('ceObsStatsRead');
        if (wEl) wEl.textContent = `${words} ${this.L('obs_words', 'words')}`;
        if (cEl) cEl.textContent = `${chars} ${this.L('obs_chars', 'chars')}`;
        if (rEl) rEl.textContent = `${mins} ${this.L('obs_min_read', 'min read')}`;
    },

    scheduleSave: function(wysiwygPane, textarea) {
        clearTimeout(this.idleSaveTimer);
        this.idleSaveTimer = setTimeout(() => {
            if (this.viewMode === 'wysiwyg') this.syncWysiwygToMarkdown(wysiwygPane);
            else if (textarea) this.activeContent = textarea.value;
            this.saveCurrentFile();
        }, 5000);

        if (!this.forceSaveTimer) {
            this.forceSaveTimer = setTimeout(() => {
                if (this.viewMode === 'wysiwyg') this.syncWysiwygToMarkdown(wysiwygPane);
                else if (textarea) this.activeContent = textarea.value;
                this.saveCurrentFile();
            }, 120000);
        }
    },

    // ------------------------------------------------------------------------
    // 5. TWO-LINE RUBBER TOOLBAR (ROW 1: NAV/INSERT, ROW 2: STYLES)
    // ------------------------------------------------------------------------
    getReadonlyToolbarHTML: function() {
        const backSvg = '<svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>';
        const histBackSvg = '<svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>';
        const histFwdSvg = '<svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>';
        const printSvg = '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-2-9H7v3h10V3z"/></svg>';
		const deleteSvg = '<svg viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1v13c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V6h1V4h-5zm2 15H7V6h10v13z"/><path d="M9 8h2v9H9zm4 0h2v9h-2z"/></svg>';
		
 
       return `
            <div class="ce-obs-toolbar">
                <div class="ce-obs-toolbar-row-wrap">
                    <div class="ce-obs-row-scroll-hint left">‹</div>
                    <div class="ce-obs-toolbar-row">
                        <button id="ceObsFolderGridBtn" class="ce-obs-tool-btn ce-obs-primary-btn" data-tip="${this.L('obs_tip_back', 'Back to Folder / Tree View')}">
                            ${backSvg}
                        </button>
                        <button id="ceObsHistBackBtn" class="ce-obs-tool-btn" data-tip="${this.L('obs_tip_hist_back', 'Previous Note in History (Alt+Left)')}" ${this.canGoBackNote() ? '' : 'disabled'}>
                            ${histBackSvg}
                        </button>
                        <button id="ceObsHistFwdBtn" class="ce-obs-tool-btn" data-tip="${this.L('obs_tip_hist_fwd', 'Next Note in History (Alt+Right)')}" ${this.canGoForwardNote() ? '' : 'disabled'}>
                            ${histFwdSvg}
                        </button>
                        <div style="margin-inline-start:auto; display:flex; gap:4px;">
                            <button class="ce-obs-tool-btn ce-obs-delete-note-btn" data-tip="${this.L('delete', 'Delete')}" style="color:var(--danger, #e81123);">
                                ${deleteSvg}
                            </button>
                            <button class="ce-obs-tool-btn" data-cmd="print" data-tip="${this.L('obs_tip_print', 'Print or Export Note as PDF (Ctrl+P)')}">
                                ${printSvg}
                            </button>
                        </div>
                    </div>
                    <div class="ce-obs-row-scroll-hint right">›</div>
                </div>
            </div>
        `;
    },

    getToolbarHTML: function() {
        const svgs = {
            back: '<svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>',
            histBack: '<svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>',
            histFwd: '<svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>',
            newNote: '<svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 14h-3v3h-2v-3H8v-2h3v-3h2v3h3v2zm-3-7V3.5L18.5 9H13z"/></svg>',
            delete: '<svg viewBox="0 0 24 24"><path d="M15 4V3H9v1H4v2h1v13c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V6h1V4h-5zm2 15H7V6h10v13z"/><path d="M9 8h2v9H9zm4 0h2v9h-2z"/></svg>',
            print: '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-2-9H7v3h10V3z"/></svg>',
            saveNeeded: '<svg viewBox="0 0 24 24"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>',
            undo: '<svg viewBox="0 0 24 24"><path d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg>',
            redo: '<svg viewBox="0 0 24 24"><path d="M18.4 10.6C16.55 9 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z"/></svg>',
            bold: '<svg viewBox="0 0 24 24"><path d="M15.6 10.79c.97-.67 1.65-1.77 1.65-2.79 0-2.26-1.75-4-4-4H7v14h7.04c2.09 0 3.71-1.7 3.71-3.79 0-1.52-.86-2.82-2.15-3.42zM10 6.5h3c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-3v-3zm3.5 9H10v-3h3.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5z"/></svg>',
            italic: '<svg viewBox="0 0 24 24"><path d="M10 4v3h2.21l-3.42 8H6v3h8v-3h-2.21l3.42-8H18V4z"/></svg>',
            cut: '<svg viewBox="0 0 24 24"><path d="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm0 12c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z"/></svg>',
            copy: '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>',
            pastePlain: '<svg viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-.9-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/></svg>',
            pasteFmt: '<svg viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-.9-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/><text x="8" y="16" font-family="sans-serif" font-size="10" fill="currentColor">A</text></svg>',
            timestamp: '<svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>',
            foldSection: '<svg viewBox="0 0 24 24"><path d="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"/><path d="M4 4h16v2H4zm0 14h16v2H4z"/></svg>',
            onenoteTag: '<svg viewBox="0 0 24 24"><path d="M17.63 5.84C17.27 5.33 16.67 5 16 5L5 5.01C3.9 5.01 3 5.9 3 7v10c0 1.1.9 1.99 2 1.99L16 19c.67 0 1.27-.33 1.63-.84L22 12l-4.37-6.16z"/></svg>',
            underline: '<svg viewBox="0 0 24 24"><path d="M12 17c3.31 0 6-2.69 6-6V3h-2.5v8c0 1.93-1.57 3.5-3.5 3.5S8.5 12.93 8.5 11V3H6v8c0 3.31 2.69 6 6 6zm-7 2v2h14v-2H5z"/></svg>',
            strike: '<svg viewBox="0 0 24 24"><path d="M10 19h4v-3h-4v3zM5 4v3h5v3h4V7h5V4H5zM3 14h18v-2H3v2z"/></svg>',
            clearFmt: '<svg viewBox="0 0 24 24"><path d="M3.27 5L2 6.27l6.97 6.97L6.5 19h3l1.57-3.66L16.73 21 18 19.73 3.55 5.27 3.27 5zM6 5v.18L8.82 8h2.4l-.72 1.68 2.1 2.1L14.21 8H20V5H6z"/></svg>',
            indent: '<svg viewBox="0 0 24 24"><path d="M3 21h18v-2H3v2zM3 8v8l4-4-4-4zm8 9h10v-2H11v2zM3 3v2h18V3H3zm8 6h10V7H11v2z"/></svg>',
            outdent: '<svg viewBox="0 0 24 24"><path d="M11 17h10v-2H11v2zm-8-5l4 4V8l-4 4zm0 9h18v-2H3v2zM3 3v2h18V3H3zm8 6h10V7H11v2z"/></svg>',
            alignL: '<svg viewBox="0 0 24 24"><path d="M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z"/></svg>',
            alignC: '<svg viewBox="0 0 24 24"><path d="M7 15v2h10v-2H7zM3 13h18v-2H3v2zm4-8v2h10V7H7zM3 21h18v-2H3v2zM3 3v2h18V3H3z"/></svg>',
            alignR: '<svg viewBox="0 0 24 24"><path d="M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z"/></svg>',
            ul: '<svg viewBox="0 0 24 24"><path d="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/></svg>',
            ol: '<svg viewBox="0 0 24 24"><path d="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/></svg>',
            task: '<svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>',
            hr: '<svg viewBox="0 0 24 24"><path d="M4 11h16v2H4z"/></svg>',
            link: '<svg viewBox="0 0 24 24"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>',
            callout: '<svg viewBox="0 0 24 24"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>',
            multicol: '<svg viewBox="0 0 24 24"><path d="M4 5v13h7V5H4zm9 0v13h7V5h-7z"/></svg>',
            code: '<svg viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>',
            // Clear 3x3 Grid Table Icon with header and cell dividers
            table: '<svg viewBox="0 0 24 24"><path d="M3 3h18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm1 5v3h4V8H4zm6 0v3h4V8h-4zm6 0v3h4V8h-4zM4 13v3h4v-3H4zm6 0v3h4v-3h-4zm6 0v3h4v-3h-4zM4 18v1h4v-1H4zm6 0v1h4v-1h-4zm6 0v1h4v-1h-4z"/></svg>',
            align: '<svg viewBox="0 0 24 24"><path d="M7.5 5.6L10 7 8.6 4.5 10 2 7.5 3.4 5 2l1.4 2.5L5 7l2.5-1.4zm12.04 1.5l-1.04-1.04c-.39-.39-1.02-.39-1.41 0l-9.84 9.84-2.2 4.39a.998.998 0 0 0 1.09 1.39l4.28-1.57 9.84-9.84c.39-.39.39-1.02 0-1.41zM8.88 16.89l-.54-.54L15.67 9.01l.54.54-7.33 7.34z"/></svg>',
            attach: '<svg viewBox="0 0 24 24"><path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5a2.5 2.5 0 0 0 5 0V5c0-3.31-2.69-6-6-6S3 4.69 3 8v9.5c0 3.31 2.69 6 6 6s6-2.69 6-6V6h-1.5z"/></svg>',
            find: '<svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>',
            modeWysiwyg: '<svg viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>',
            modeCode: '<svg viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>',
            textColor: '<svg viewBox="0 0 24 24"><path d="M2 21h20v3H2zm2.06-4h4.08l1.4 3h2.15l-4.78-11h-2.12l-4.8 11h2.17l1.4-3zm2.54-1.85L8.6 11l1.5 4.15H7.1z"/></svg>',
            bgColor: '<svg viewBox="0 0 24 24"><path d="M19.36 7.58l-1.9-1.9-1.34-1.35c-.78-.78-2.05-.78-2.83 0L4.35 13.26c-.39.39-.39 1.02 0 1.41l4.24 4.24c.39.39 1.02.39 1.41 0l8.94-8.94c.78-.78.78-2.05 0-2.83zm-13.6 7.08l1.41-1.41 2.83 2.83-1.41 1.41-2.83-2.83z"/><path d="M3 21h18v3H3z"/></svg>'
        };

        const colors = [
            '#000000', '#2b2b2b', '#595959', '#808080', '#a6a6a6', '#cccccc', '#e6e6e6', '#f2f2f2', '#fafafa', '#ffffff',
            '#4b0000', '#732600', '#734c00', '#264b00', '#004b26', '#004b4b', '#002673', '#260073', '#4b004b', '#73004b',
            '#ff0000', '#ff7300', '#ffb900', '#73ff00', '#00ff00', '#00ffff', '#0078d4', '#0000ff', '#8a2be2', '#ff00ff',
            '#ff8080', '#ffb380', '#ffe680', '#b3ff80', '#80ff80', '#80ffff', '#80c4ff', '#8080ff', '#d280ff', '#ff80ff',
            '#ffcccc', '#ffe6cc', '#fff6cc', '#e6ffcc', '#ccffcc', '#ccffff', '#cce8ff', '#ccccff', '#eed2ff', '#ffccff'
        ];
        
        const generateColorDrop = (isBg) => {
            return `
                <div class="ce-obs-color-dropdown">
                    <button type="button" class="ce-obs-color-reset" data-reset="${isBg ? 'bg' : 'fg'}">${isBg ? this.L('obs_no_highlight', 'No Highlight / Default') : this.L('obs_default_color', 'Default Text Color')}</button>
                    <div class="ce-obs-swatch-grid">
                        ${colors.map(c => `<div class="ce-obs-swatch" style="background:${c};" data-color="${c}"></div>`).join('')}
                    </div>
                    <div style="display:flex; align-items:center; gap:6px; font-size:12px;">
                        <span>${this.L('obs_custom_color', 'Custom:')}</span>
                        <input type="color" class="ce-obs-color-picker" value="${isBg ? this.lastBgColor : this.lastTextColor}">
                    </div>
                </div>
            `;
        };

        return `
            <div class="ce-obs-toolbar">
                <!-- ROW 1: Back, New Note, Undo/Redo, small space, Insert Items, Find/Mode & Save-Needed Icon at Right Margin -->
                <div class="ce-obs-toolbar-row-wrap">
                    <div class="ce-obs-row-scroll-hint left">‹</div>
                    <div class="ce-obs-toolbar-row">
                        <div class="ce-obs-toolbar-section">
                            <button id="ceObsFolderGridBtn" class="ce-obs-tool-btn ce-obs-primary-btn" data-tip="${this.L('obs_tip_back', 'Back to Folder / Tree View')}">${svgs.back}</button>
                            <button id="ceObsHistBackBtn" class="ce-obs-tool-btn" data-tip="${this.L('obs_tip_hist_back', 'Previous Note in History (Alt+Left)')}" ${this.canGoBackNote() ? '' : 'disabled'}>${svgs.histBack}</button>
                            <button id="ceObsHistFwdBtn" class="ce-obs-tool-btn" data-tip="${this.L('obs_tip_hist_fwd', 'Next Note in History (Alt+Right)')}" ${this.canGoForwardNote() ? '' : 'disabled'}>${svgs.histFwd}</button>
                            <button id="ceObsNewNoteBtn" class="ce-obs-tool-btn ce-obs-primary-btn" data-tip="${this.L('obs_tip_new_note', 'Create a New Note in Vault')}">${svgs.newNote}</button>
                            <button class="ce-obs-tool-btn ce-obs-primary-btn ce-obs-delete-note-btn" data-tip="${this.L('delete', 'Delete')}" style="color:var(--danger, #e81123);">${svgs.delete}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="undo" data-tip="${this.L('obs_tip_undo', 'Undo Last Action (Ctrl+Z)')}">${svgs.undo}</button>
                            <button class="ce-obs-tool-btn" data-cmd="redo" data-tip="${this.L('obs_tip_redo', 'Redo Last Action (Ctrl+Y)')}">${svgs.redo}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="copy" data-tip="${this.L('copy', 'Copy')}">${svgs.copy}</button>
                            <button class="ce-obs-tool-btn" data-cmd="pastePlain" data-tip="${this.L('paste', 'Paste')}">${svgs.pastePlain}</button>
                            <button class="ce-obs-tool-btn" data-cmd="pasteFmt" data-tip="${this.L('paste_fmt', 'Paste (Keep Formatting)')}">${svgs.pasteFmt}</button>
                            <button class="ce-obs-tool-btn" data-cmd="cut" data-tip="${this.L('cut', 'Cut')}">${svgs.cut}</button>
                        </div>
                        <div class="ce-obs-tool-spacer"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="task" data-tip="${this.L('obs_tip_task', 'Insert Interactive Task Checkbox')}">${svgs.task}</button>
                            <button class="ce-obs-tool-btn" data-cmd="quicktag" data-tip="${this.L('obs_tip_quicktag', 'OneNote Quick Tag: ⭐ Important (Ctrl+2), ❓ Question (Ctrl+3), 💡 Idea (Ctrl+4), ⚠️ Warning (Ctrl+5)')}">${svgs.onenoteTag}</button>
                            <button class="ce-obs-tool-btn" data-cmd="timestamp" data-tip="${this.L('obs_tip_timestamp', 'Insert Date & Time Stamp (Alt+Shift+D)')}">${svgs.timestamp}</button>
                            <button class="ce-obs-tool-btn" data-cmd="foldsection" data-tip="${this.L('obs_tip_fold', 'Insert Collapsible Outline Section')}">${svgs.foldSection}</button>
                            <button class="ce-obs-tool-btn" data-cmd="hr" data-tip="${this.L('obs_tip_hr', 'Insert Horizontal Divider Line')}">${svgs.hr}</button>
                            <button class="ce-obs-tool-btn" data-cmd="link" data-tip="${this.L('obs_tip_link', 'Insert Hyperlink or [[WikiLink]] (Ctrl+K)')}">${svgs.link}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="callout" data-tip="${this.L('obs_tip_callout', 'Insert Obsidian Callout Box')}">${svgs.callout}</button>
                            <button class="ce-obs-tool-btn" data-cmd="multicol" data-tip="${this.L('obs_tip_multicol', 'Insert Side-by-Side Multi-Column Layout')}">${svgs.multicol}</button>
                            <button class="ce-obs-tool-btn" data-cmd="code" data-tip="${this.L('obs_tip_code', 'Insert Syntax-Highlighted Code Block')}">${svgs.code}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="table" data-tip="${this.L('obs_tip_table', 'Insert Data Table')}">${svgs.table}</button>
                            <button class="ce-obs-tool-btn" data-cmd="table_format" data-tip="${this.L('obs_tip_table_format', 'Auto-Format & Align Markdown Tables')}">${svgs.align}</button>
                            <button class="ce-obs-tool-btn" data-cmd="attach" data-tip="${this.L('obs_tip_attach', 'Upload & Embed Image or Attachment')}">${svgs.attach}</button>
                        </div>
                        <div class="ce-obs-tool-sep" style="margin-inline-start:auto;"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="print" data-tip="${this.L('obs_tip_print', 'Print or Export Note as PDF (Ctrl+P)')}">${svgs.print}</button>
                            <button class="ce-obs-tool-btn" data-cmd="find" data-tip="${this.L('obs_tip_find', 'Find & Replace Text in Note (Ctrl+F)')}">${svgs.find}</button>
                            <button id="ceObsToggleModeBtn" class="ce-obs-tool-btn ce-obs-primary-btn" data-tip="${this.viewMode === 'code' ? this.L('obs_tip_wysiwyg', 'Switch to Visual WYSIWYG Editor') : this.L('obs_tip_code_mode', 'Switch to Raw Markdown Code Editor')}">
                                ${this.viewMode === 'code' ? svgs.modeWysiwyg : svgs.modeCode}
                            </button>
                            <span id="ceObsDirtyDot" class="ce-obs-dirty-indicator ${this.isDirty ? 'active' : ''}" data-tip="${this.L('obs_tip_save_needed', 'Unsaved changes — Click to save now (Ctrl+S)')}">
                                ${svgs.saveNeeded}
                            </span>
                        </div>
                    </div>
                    <div class="ce-obs-row-scroll-hint right">›</div>
                </div>

                <!-- ROW 2: All Style Controls starting with Paragraph Style Dropdown -->
                <div class="ce-obs-toolbar-row-wrap">
                    <div class="ce-obs-row-scroll-hint left">‹</div>
                    <div class="ce-obs-toolbar-row">
                        <div class="ce-obs-toolbar-section">
                            <select id="ceObsBlockSelect" class="ce-obs-block-select" data-cmd="formatBlock" data-tip="${this.L('obs_tip_block_style', 'Paragraph & Heading Level (P, H1–H5)')}">
                                <option value="" disabled hidden></option>
                                <option value="P" selected>P</option>
                                <option value="H1">H1</option>
                                <option value="H2">H2</option>
                                <option value="H3">H3</option>
                                <option value="H4">H4</option>
                                <option value="H5">H5</option>
                            </select>
                            <select id="ceObsFontSizeSelect" class="ce-obs-font-size-select" data-cmd="fontSize" data-tip="${this.L('obs_tip_font_size', 'Text Font Size (15pt is default)')}">
                                <option value="" disabled hidden></option>
                                <option value="10px">10pt</option>
                                <option value="13px">13pt</option>
                                <option value="15px" selected>15pt</option>
                                <option value="18px">18pt</option>
                                <option value="24px">24pt</option>
                                <option value="32px">32pt</option>
                                <option value="48px">48pt</option>
                            </select>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="bold" data-tip="${this.L('obs_tip_bold', 'Bold Text (Ctrl+B)')}">${svgs.bold}</button>
                            <button class="ce-obs-tool-btn" data-cmd="italic" data-tip="${this.L('obs_tip_italic', 'Italic Text (Ctrl+I)')}">${svgs.italic}</button>
                            <button class="ce-obs-tool-btn" data-cmd="underline" data-tip="${this.L('obs_tip_underline', 'Underline Text (Ctrl+U)')}">${svgs.underline}</button>
                            <button class="ce-obs-tool-btn" data-cmd="strike" data-tip="${this.L('obs_tip_strike', 'Strikethrough Text')}">${svgs.strike}</button>
                            <button class="ce-obs-tool-btn" data-cmd="removeFormat" data-tip="${this.L('obs_tip_clear_fmt', 'Remove Formatting & Reset to Clean Markdown')}">${svgs.clearFmt}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <div class="ce-obs-split-btn">
                                <button class="ce-obs-split-main" data-cmd="color" data-tip="${this.L('obs_tip_text_color', 'Apply Text Color')}" style="--btn-color: ${this.lastTextColor};">
                                    ${svgs.textColor}<div class="ce-obs-color-indicator"></div>
                                </button>
                                <button class="ce-obs-split-drop" data-drop="color" data-tip="${this.L('obs_tip_choose_color', 'Choose Text Color')}">▾</button>
                                ${generateColorDrop(false)}
                            </div>
                            <div class="ce-obs-split-btn">
                                <button class="ce-obs-split-main" data-cmd="bgcolor" data-tip="${this.L('obs_tip_bg_color', 'Apply Highlight / Background Color')}" style="--btn-color: ${this.lastBgColor};">
                                    ${svgs.bgColor}<div class="ce-obs-color-indicator"></div>
                                </button>
                                <button class="ce-obs-split-drop" data-drop="bgcolor" data-tip="${this.L('obs_tip_choose_bg', 'Choose Highlight Color')}">▾</button>
                                ${generateColorDrop(true)}
                            </div>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="justifyLeft" data-tip="${this.L('obs_tip_align_l', 'Align Text Left')}">${svgs.alignL}</button>
                            <button class="ce-obs-tool-btn" data-cmd="justifyCenter" data-tip="${this.L('obs_tip_align_c', 'Center Text')}">${svgs.alignC}</button>
                            <button class="ce-obs-tool-btn" data-cmd="justifyRight" data-tip="${this.L('obs_tip_align_r', 'Align Text Right')}">${svgs.alignR}</button>
                        </div>
                        <div class="ce-obs-tool-sep"></div>
                        <div class="ce-obs-toolbar-section">
                            <button class="ce-obs-tool-btn" data-cmd="ul" data-tip="${this.L('obs_tip_ul', 'Insert Bulleted List')}">${svgs.ul}</button>
                            <button class="ce-obs-tool-btn" data-cmd="ol" data-tip="${this.L('obs_tip_ol', 'Insert Numbered List')}">${svgs.ol}</button>
                            <button class="ce-obs-tool-btn" data-cmd="outdent" data-tip="${this.L('obs_tip_outdent', 'Decrease Indentation')}">${svgs.outdent}</button>
                            <button class="ce-obs-tool-btn" data-cmd="indent" data-tip="${this.L('obs_tip_indent', 'Increase Indentation')}">${svgs.indent}</button>
                        </div>
                    </div>
                    <div class="ce-obs-row-scroll-hint right">›</div>
                </div>
            </div>
        `;
    },

    updateToolbarActiveStates: function(ws, wysiwygPane) {
        if (!ws || !wysiwygPane || this.viewMode !== 'wysiwyg') return;
        const blockSelect = ws.querySelector('#ceObsBlockSelect');
        const sizeSelect = ws.querySelector('#ceObsFontSizeSelect');
        if (!blockSelect || !sizeSelect) return;

        const root = this.shadowRoot || document;
        const sel = root.getSelection ? root.getSelection() : window.getSelection();
        if (!sel || sel.rangeCount === 0) {
            blockSelect.value = 'P';
            sizeSelect.value = '15px';
            return;
        }

        const range = sel.getRangeAt(0);
        if (!wysiwygPane.contains(range.commonAncestorContainer)) return;

        const getBlockTag = (node) => {
            let curr = (node.nodeType === Node.TEXT_NODE) ? node.parentElement : node;
            while (curr && curr !== wysiwygPane) {
                if (/^(H[1-5]|P)$/.test(curr.tagName)) return curr.tagName;
                curr = curr.parentElement;
            }
            return 'P';
        };

        const startBlock = getBlockTag(range.startContainer);
        const endBlock = getBlockTag(range.endContainer);
        blockSelect.value = (startBlock === endBlock) ? startBlock : '';

        const getEffectiveSize = (node) => {
            let curr = (node.nodeType === Node.TEXT_NODE) ? node.parentElement : node;
            while (curr && curr !== wysiwygPane) {
                if (curr.style && curr.style.fontSize) {
                    return curr.style.fontSize.trim();
                }
                curr = curr.parentElement;
            }
            return '15px';
        };

        if (range.collapsed) {
            const sz = getEffectiveSize(range.startContainer);
            sizeSelect.value = ['10px', '13px', '15px', '18px', '24px', '32px', '48px'].includes(sz) ? sz : '15px';
        } else {
            const sizes = new Set();
            const walker = document.createTreeWalker(
                range.commonAncestorContainer.nodeType === Node.TEXT_NODE ? range.commonAncestorContainer.parentElement : range.commonAncestorContainer,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: (n) => {
                        if (!n.nodeValue.trim()) return NodeFilter.FILTER_SKIP;
                        return range.intersectsNode(n) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
                    }
                }
            );
            let n;
            while ((n = walker.nextNode())) {
                sizes.add(getEffectiveSize(n));
                if (sizes.size > 1) break;
            }
            if (sizes.size === 0) {
                sizeSelect.value = getEffectiveSize(range.startContainer);
            } else if (sizes.size === 1) {
                const onlySize = Array.from(sizes)[0];
                sizeSelect.value = ['10px', '13px', '15px', '18px', '24px', '32px', '48px'].includes(onlySize) ? onlySize : '15px';
            } else {
                sizeSelect.value = '';
            }
        }
    },

    bindToolbarActions: function(ws, textarea, wysiwygPane, autoResizeTextarea) {
        const isWysiwyg = () => this.viewMode === 'wysiwyg';

        const modeWysiwygSvg = '<svg viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>';
        const modeCodeSvg = '<svg viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>';

        const toggleBtn = ws.querySelector('#ceObsToggleModeBtn');
        const shadowHost = ws.querySelector('#ceObsShadowHost');
        const editorPane = ws.querySelector('#ceObsEditorPane');
        if (toggleBtn && shadowHost && editorPane) {
            toggleBtn.onclick = async () => {
                this.hideInstantTooltip();
                if (this.viewMode === 'wysiwyg') {
                    if (wysiwygPane) this.syncWysiwygToMarkdown(wysiwygPane);
                    if (textarea) textarea.value = this.activeContent;
                    this.viewMode = 'code';
                    shadowHost.style.display = 'none';
                    editorPane.style.display = 'flex';
                    toggleBtn.innerHTML = modeWysiwygSvg;
                    toggleBtn.setAttribute('data-tip', this.L('obs_tip_wysiwyg', 'Switch to Visual WYSIWYG Editor'));
                    if (typeof autoResizeTextarea === 'function') autoResizeTextarea();
                    if (textarea) textarea.focus();
                } else {
                    if (textarea) this.activeContent = textarea.value;
                    this.viewMode = 'wysiwyg';
                    editorPane.style.display = 'none';
                    shadowHost.style.display = 'flex';
                    toggleBtn.innerHTML = modeCodeSvg;
                    toggleBtn.setAttribute('data-tip', this.L('obs_tip_code_mode', 'Switch to Raw Markdown Code Editor'));
                    await this.updatePreview(wysiwygPane);
                    if (wysiwygPane) wysiwygPane.focus();
                }
            };
        }

        const wrapCodeSelection = (prefix, suffix = prefix) => {
            if (!textarea) return;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const sel = textarea.value.substring(start, end) || this.L('obs_sample_text', 'text');
            const rep = prefix + sel + suffix;
            textarea.setRangeText(rep, start, end, 'select');
            textarea.dispatchEvent(new Event('input'));
            textarea.focus();
        };

        const insertWysiwygHTML = (html) => {
            if (!wysiwygPane) return;
            wysiwygPane.focus();
            const sanitized = this.sanitizeUntrustedHTML(html);
            
            const root = this.shadowRoot || document;
            const sel = root.getSelection ? root.getSelection() : window.getSelection();
            
            if (sel && sel.getRangeAt && sel.rangeCount > 0) {
                let range = sel.getRangeAt(0);
                if (!wysiwygPane.contains(range.commonAncestorContainer)) {
                    range = document.createRange();
                    range.selectNodeContents(wysiwygPane);
                    range.collapse(false);
                }
                range.deleteContents();
                const el = document.createElement('div');
                el.innerHTML = sanitized;
                
                const frag = document.createDocumentFragment();
                let node, lastNode;
                while ((node = el.firstChild)) {
                    lastNode = frag.appendChild(node);
                }
                range.insertNode(frag);
                if (lastNode) {
                    range = range.cloneRange();
                    range.setStartAfter(lastNode);
                    range.collapse(true);
                    sel.removeAllRanges();
                    sel.addRange(range);
                }
            } else {
                document.execCommand('insertHTML', false, sanitized);
            }
            
            this.postProcessPreviewDOM(wysiwygPane);
            wysiwygPane.dispatchEvent(new Event('input'));
        };

        ws.querySelectorAll('.ce-obs-tool-btn[data-cmd], .ce-obs-split-main[data-cmd], .ce-obs-block-select, .ce-obs-font-size-select').forEach(btn => {
            if (btn.tagName !== 'SELECT') {
                btn.onmousedown = (e) => e.preventDefault();
            }

            const handler = () => {
                this.hideInstantTooltip();
                const cmd = btn.dataset.cmd;
                let val = null;
                if (cmd === 'color') val = this.lastTextColor;
                if (cmd === 'bgcolor') val = this.lastBgColor;
                if (cmd === 'fontSize' || cmd === 'formatBlock') val = btn.value;

                if (cmd === 'find') {
                    this.toggleFindBar();
                    return;
                }
                
                if (cmd === 'print') {
                    this.promptPrintOrPdf();
                    return;
                }

                if (isWysiwyg()) {
                    wysiwygPane.focus();
                    switch (cmd) {
                        case 'undo': document.execCommand('undo'); break;
                        case 'redo': document.execCommand('redo'); break;
                        case 'bold': document.execCommand('bold'); break;
                        case 'italic': document.execCommand('italic'); break;
                        case 'strike': document.execCommand('strikeThrough'); break;
                        case 'underline': document.execCommand('underline'); break;
                        case 'cut': document.execCommand('cut'); break;
                        case 'copy': document.execCommand('copy'); break;
                        case 'pastePlain': 
                            navigator.clipboard.readText().then(text => { document.execCommand('insertText', false, text); wysiwygPane.dispatchEvent(new Event('input')); }).catch(() => myCloudShowAlert(this.L('error_lbl', 'Error'), "Browser blocked programmatic clipboard read. Use Ctrl+V."));
                            break;
                        case 'pasteFmt':
                            try {
                                navigator.clipboard.read().then(async items => {
                                    let pasted = false;
                                    for (const item of items) {
                                        if (item.types.includes('text/html')) {
                                            const blob = await item.getType('text/html');
                                            document.execCommand('insertHTML', false, this.sanitizeUntrustedHTML(await blob.text()));
                                            wysiwygPane.dispatchEvent(new Event('input'));
                                            pasted = true; break;
                                        }
                                    }
                                    if (!pasted) {
                                        const text = await navigator.clipboard.readText();
                                        document.execCommand('insertText', false, text);
                                        wysiwygPane.dispatchEvent(new Event('input'));
                                    }
                                }).catch(() => myCloudShowAlert(this.L('error_lbl', 'Error'), "Clipboard API blocked. Use Shift+Paste."));
                            } catch (e) { myCloudShowAlert(this.L('error_lbl', 'Error'), "Clipboard API not supported. Use Shift+Paste."); }
                            break;
                        case 'removeFormat':
                            this.removeSelectedFormatting(wysiwygPane);;
                            break;
                        case 'indent': this.adjustWysiwygIndent(wysiwygPane, 1); break;
                        case 'outdent': this.adjustWysiwygIndent(wysiwygPane, -1); break;
                        case 'justifyLeft': document.execCommand('justifyLeft'); break;
                        case 'justifyCenter': document.execCommand('justifyCenter'); break;
                        case 'justifyRight': document.execCommand('justifyRight'); break;
                        case 'formatBlock':
                            if (val) document.execCommand('formatBlock', false, val);
                            break;
                        case 'fontSize':
                            if (val) {
                                document.execCommand('fontSize', false, '7');
                                wysiwygPane.querySelectorAll('font[size="7"]').forEach(f => {
                                    if (val === '15px') {
                                        const parent = f.parentNode;
                                        while (f.firstChild) parent.insertBefore(f.firstChild, f);
                                        parent.removeChild(f);
                                    } else {
                                        const span = document.createElement('span');
                                        span.style.fontSize = val;
                                        span.innerHTML = f.innerHTML;
                                        f.replaceWith(span);
                                    }
                                });
                                this.cleanInlineStyles(wysiwygPane);
                            }
                            break;
                        case 'color':
                            document.execCommand('foreColor', false, val);
                            this.cleanInlineStyles(wysiwygPane);
                            break;
                        case 'bgcolor':
                            document.execCommand('hiliteColor', false, val);
                            this.cleanInlineStyles(wysiwygPane);
                            break;
                        case 'ul': document.execCommand('insertUnorderedList'); break;
                        case 'ol': document.execCommand('insertOrderedList'); break;
                        case 'hr': insertWysiwygHTML('<hr><p><br></p>'); break;
                        case 'link':
                            this.promptInsertLink(wysiwygPane, textarea, insertWysiwygHTML);
                            return;
                        case 'task':
                            insertWysiwygHTML(`<div><input type="checkbox"> ${this.L('obs_default_task', 'Task item')}</div>`);
                            break;
                        case 'quicktag':
                            this.showQuickTagMenu(btn, wysiwygPane, null, insertWysiwygHTML);
                            return;
                        case 'timestamp':
                            insertWysiwygHTML(`<span class="ce-obs-timestamp">${this.getFormattedTimestamp()}</span>&nbsp;`);
                            break;
                        case 'foldsection':
                            insertWysiwygHTML(`<details class="ce-obs-fold" open><summary style="font-weight:600; cursor:pointer;">${this.L('obs_section_title', 'Collapsible Section')}</summary><p>${this.L('obs_section_body', 'Details...')}</p></details><p><br></p>`);
                            break;
                        case 'callout':
                            insertWysiwygHTML(`<div class="ce-obs-callout" data-callout="info"><div class="ce-obs-callout-title">📌 Info</div><p>${this.L('obs_default_callout', 'Callout text...')}</p></div><p><br></p>`);
                            break;
                        case 'multicol':
                            insertWysiwygHTML(`<div class="ce-obs-multicol"><div class="ce-obs-col"><p>${this.L('obs_col_1', 'Column 1')}</p></div><div class="ce-obs-col"><p>${this.L('obs_col_2', 'Column 2')}</p></div></div><p><br></p>`);
                            break;
                        case 'code':
                            insertWysiwygHTML(this.renderCodeStylerBlock('javascript', 'title:"script.js"', '// code') + '<p><br></p>');
                            break;
                        case 'table':
                            insertWysiwygHTML(`<table class="ce-obs-table"><thead><tr><th>${this.L('obs_tbl_h1', 'Header 1')}</th><th>${this.L('obs_tbl_h2', 'Header 2')}</th></tr></thead><tbody><tr><td>${this.L('obs_tbl_c1', 'Cell 1')}</td><td>${this.L('obs_tbl_c2', 'Cell 2')}</td></tr></tbody></table><p><br></p>`);
                            break;
                        case 'table_format':
                            this.syncWysiwygToMarkdown(wysiwygPane);
                            this.activeContent = this.formatAllMarkdownTables(this.activeContent);
                            this.updatePreview(wysiwygPane);
                            break;
                        case 'attach':
                            this.triggerAttachmentUpload(textarea, wysiwygPane);
                            break;
                    }
                    wysiwygPane.dispatchEvent(new Event('input'));
                    this.updateToolbarActiveStates(ws, wysiwygPane);
                } else {
                    const mdPrefixMap = { 'P': '', 'H1': '# ', 'H2': '## ', 'H3': '### ', 'H4': '#### ', 'H5': '##### ' };
                    switch (cmd) {
                        case 'undo': document.execCommand('undo'); break;
                        case 'redo': document.execCommand('redo'); break;
                        case 'bold': wrapCodeSelection('**'); break;
                        case 'italic': wrapCodeSelection('*'); break;
                        case 'strike': wrapCodeSelection('~~'); break;
                        case 'underline': wrapCodeSelection('<u>', '</u>'); break;
                        case 'removeFormat': {
                            const start = textarea.selectionStart, end = textarea.selectionEnd;
                            const cleaned = textarea.value.substring(start, end)
                                .replace(/<\/?[^>]+(>|$)/g, '')
                                .replace(/~~([^~]+)~~/g, '$1')
                                .replace(/==([^=]+)==/g, '$1')
                                .replace(/\*\*([^*]+)\*\*/g, '$1')
                                .replace(/\*([^*]+)\*/g, '$1');
                            textarea.setRangeText(cleaned, start, end, 'select');
                            textarea.dispatchEvent(new Event('input'));
                            break;
                        }
                        case 'indent':
                        case 'outdent': {
                            const start = textarea.selectionStart, end = textarea.selectionEnd;
                            const lineStart = textarea.value.lastIndexOf('\n', start - 1) + 1;
                            const block = textarea.value.substring(lineStart, end);
                            const updated = block.split('\n').map(l => {
                                if (cmd === 'indent') return '\t' + l;
                                return l.replace(/^(\t| {1,4})/, '');
                            }).join('\n');
                            textarea.setRangeText(updated, lineStart, end, 'select');
                            textarea.dispatchEvent(new Event('input'));
                            break;
                        }
                        case 'justifyCenter': wrapCodeSelection('<div align="center">', '</div>'); break;
                        case 'justifyRight': wrapCodeSelection('<div align="right">', '</div>'); break;
                        case 'formatBlock':
                            if (val && mdPrefixMap[val] !== undefined) wrapCodeSelection('\n' + mdPrefixMap[val], '');
                            break;
                        case 'fontSize':
                            if (val && val !== '15px') wrapCodeSelection(`<span style="font-size:${val};">`, `</span>`);
                            break;
                        case 'color': wrapCodeSelection(`<span style="color:${val}">`, `</span>`); break;
                        case 'bgcolor': wrapCodeSelection(`<span style="background-color:${val}; padding:0 4px; border-radius:3px;">`, `</span>`); break;
                        case 'ul': wrapCodeSelection('\n- ', ''); break;
                        case 'ol': wrapCodeSelection('\n1. ', ''); break;
                        case 'hr': wrapCodeSelection('\n---\n', ''); break;
                        case 'link':
                            this.promptInsertLink(wysiwygPane, textarea, insertWysiwygHTML);
                            return;
                        case 'task': wrapCodeSelection('\n- [ ] ', ''); break;
                        case 'quicktag':
                            this.showQuickTagMenu(btn, null, textarea, null);
                            return;
                        case 'timestamp':
                            wrapCodeSelection(this.getFormattedTimestamp() + ' ', '');
                            break;
                        case 'foldsection':
                            wrapCodeSelection(`\n<details open>\n<summary>${this.L('obs_section_title', 'Collapsible Section')}</summary>\n\n${this.L('obs_section_body', 'Details...')}\n\n</details>\n`, '');
                            break;
                        case 'callout': wrapCodeSelection('\n> [!info] Title\n> ', '\n'); break;
                        case 'multicol':
                            wrapCodeSelection(`\n--- start-multi-column: ID_${Math.floor(Math.random()*999)}\n\`\`\`column-settings\nnumber of columns: 2\n\`\`\`\n\n${this.L('obs_col_1', 'Column 1')}\n\n--- end-column ---\n\n${this.L('obs_col_2', 'Column 2')}\n\n--- end-multi-column\n`, '');
                            break;
                        case 'code': wrapCodeSelection('\n```javascript title:"script.js" hl:1\n', '\n```\n'); break;
                        case 'table': wrapCodeSelection(`\n| ${this.L('obs_tbl_h1', 'Header 1')} | ${this.L('obs_tbl_h2', 'Header 2')} |\n| :--- | :--- |\n| ${this.L('obs_tbl_c1', 'Cell 1')} | ${this.L('obs_tbl_c2', 'Cell 2')} |\n`, ''); break;
                        case 'table_format':
                            textarea.value = this.formatAllMarkdownTables(textarea.value);
                            textarea.dispatchEvent(new Event('input'));
                            break;
                        case 'attach':
                            this.triggerAttachmentUpload(textarea, wysiwygPane);
                            break;
                    }
                }
            };
            if (btn.tagName === 'SELECT') btn.onchange = handler;
            else btn.onclick = handler;
        });

        // Bind Split Dropdowns (Positioned fixed so overflow-x on mobile never clips them)
        ws.querySelectorAll('.ce-obs-split-drop').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                this.hideInstantTooltip();
                const drop = btn.nextElementSibling;
                const isShowing = drop.classList.contains('show');
                ws.querySelectorAll('.ce-obs-color-dropdown').forEach(d => d.classList.remove('show'));
                if (!isShowing) {
                    const rect = btn.parentElement.getBoundingClientRect();
                    drop.style.top = (rect.bottom + 4) + 'px';
                    let left = rect.left;
                    if (left + 190 > window.innerWidth) left = window.innerWidth - 195;
                    if (left < 6) left = 6;
                    drop.style.left = left + 'px';
                    drop.classList.add('show');
                }
            };
        });

        ws.querySelectorAll('.ce-obs-color-reset').forEach(resetBtn => {
            resetBtn.onmousedown = (e) => e.preventDefault();
            resetBtn.onclick = (e) => {
                e.stopPropagation();
                const type = resetBtn.dataset.reset;
                resetBtn.closest('.ce-obs-color-dropdown').classList.remove('show');
                if (isWysiwyg() && wysiwygPane) {
                    wysiwygPane.focus();
                    if (type === 'bg') {
                        document.execCommand('hiliteColor', false, 'transparent');
                    } else {
                        document.execCommand('foreColor', false, 'inherit');
                    }
                    this.cleanInlineStyles(wysiwygPane);
                    wysiwygPane.dispatchEvent(new Event('input'));
                }
            };
        });

        const updateColor = (btnContainer, color, isBg) => {
            if (isBg) this.lastBgColor = color;
            else this.lastTextColor = color;
            
            const mainBtn = btnContainer.querySelector('.ce-obs-split-main');
            mainBtn.style.setProperty('--btn-color', color);
            btnContainer.querySelector('.ce-obs-color-picker').value = color;
            btnContainer.querySelector('.ce-obs-color-dropdown').classList.remove('show');
            
            mainBtn.click();
        };

        ws.querySelectorAll('.ce-obs-swatch').forEach(sw => {
            sw.onmousedown = (e) => e.preventDefault();
            sw.onclick = (e) => {
                e.stopPropagation();
                const container = sw.closest('.ce-obs-split-btn');
                updateColor(container, sw.dataset.color, container.querySelector('.ce-obs-split-main').dataset.cmd === 'bgcolor');
            };
        });

        ws.querySelectorAll('.ce-obs-color-picker').forEach(inp => {
            inp.onchange = (e) => {
                e.stopPropagation();
                const container = inp.closest('.ce-obs-split-btn');
                updateColor(container, inp.value, container.querySelector('.ce-obs-split-main').dataset.cmd === 'bgcolor');
            };
        });

        document.addEventListener('mousedown', (e) => {
            if (!e.target.closest('.ce-obs-split-btn')) {
                ws.querySelectorAll('.ce-obs-color-dropdown').forEach(d => d.classList.remove('show'));
            }
        }, true);
    },

    // ------------------------------------------------------------------------
    // 5.5 CONTEXT MENU (EXTERNAL SEARCH & CSP-SAFE TRANSLATION POPUP)
    // ------------------------------------------------------------------------
    openExternalUrl: function(rawUrl) {
        const a = document.createElement('a');
        a.href = rawUrl;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        document.body.appendChild(a);
        a.click();
        a.remove();
    },

    showObsidianContextMenu: function(e, ws, wysiwygPane) {
        e.preventDefault();
        e.stopPropagation();

        let ctx = ws.querySelector('#ceObsContextMenu');
        if (ctx) ctx.remove();

        const isInput = wysiwygPane.tagName === 'INPUT' || wysiwygPane.tagName === 'TEXTAREA';
        let selectedText = '';
        if (isInput) {
            selectedText = wysiwygPane.value.substring(wysiwygPane.selectionStart, wysiwygPane.selectionEnd).trim();
        } else {
            const root = this.shadowRoot || document;
            const sel = root.getSelection ? root.getSelection() : window.getSelection();
            selectedText = sel ? sel.toString().trim() : '';
        }

        ctx = document.createElement('div');
        ctx.id = 'ceObsContextMenu';
        ctx.className = 'ce-obs-context-menu';

        const svgs = {
            cut: '<svg viewBox="0 0 24 24"><path d="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm0 12c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z"/></svg>',
            copy: '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>',
            pastePlain: '<svg viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-.9-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/></svg>',
            pasteFmt: '<svg viewBox="0 0 24 24"><path d="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-.9-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z"/><text x="8" y="16" font-family="sans-serif" font-size="10" fill="currentColor">A</text></svg>'
        };

        const closeCtx = (ev) => { 
            if (!ctx.contains(ev.target)) { 
                ctx.remove(); 
                ws.removeEventListener('mousedown', closeCtx, true);
                document.removeEventListener('mousedown', closeCtx, true); 
            } 
        };

        const topActions = document.createElement('div');
        topActions.style.display = 'flex';
        topActions.style.gap = '8px';
        topActions.style.padding = '8px';
        topActions.style.borderBottom = '1px solid var(--border-subtle)';
        topActions.style.justifyContent = 'space-between';

        const createIconBtn = (icon, title, actionFn) => {
            const btn = document.createElement('button');
            btn.className = 'ce-obs-tool-btn ce-obs-primary-btn';
            btn.style.width = '36px';
            btn.style.height = '36px';
            btn.style.padding = '6px';
            btn.style.display = 'flex';
            btn.style.justifyContent = 'center';
            btn.style.alignItems = 'center';
            btn.title = title;
            btn.innerHTML = icon.includes('<svg') ? icon.replace('<svg', '<svg style="width:20px;height:20px;fill:currentColor;"') : icon;
            btn.onmousedown = ev => ev.preventDefault();
            btn.onclick = async () => {
                ctx.remove();
                document.removeEventListener('mousedown', closeCtx, true);
                ws.removeEventListener('mousedown', closeCtx, true);
                wysiwygPane.focus();
                await actionFn();
            };
            return btn;
        };

        topActions.appendChild(createIconBtn(svgs.copy, this.L('copy', 'Copy'), () => { document.execCommand('copy'); }));
        topActions.appendChild(createIconBtn(svgs.pastePlain, this.L('paste', 'Paste'), async () => {
            try {
                const text = await navigator.clipboard.readText();
                if (isInput) {
                    wysiwygPane.setRangeText(text, wysiwygPane.selectionStart, wysiwygPane.selectionEnd, 'end');
                } else {
                    document.execCommand('insertText', false, text);
                }
                wysiwygPane.dispatchEvent(new Event('input'));
            } catch(err) {
                myCloudShowAlert(this.L('error_lbl', 'Error'), this.L('obs_paste_shortcut_msg', 'Paste blocked by browser. Please use Ctrl+V.'));
            }
        }));
        if (!isInput) {
            topActions.appendChild(createIconBtn(svgs.pasteFmt, this.L('paste_fmt', 'Paste (Keep Formatting)'), async () => {
                try {
                    const items = await navigator.clipboard.read();
                    let pasted = false;
                    for (const item of items) {
                        if (item.types.includes('text/html')) {
                            const blob = await item.getType('text/html');
                            document.execCommand('insertHTML', false, this.sanitizeUntrustedHTML(await blob.text()));
                            wysiwygPane.dispatchEvent(new Event('input'));
                            pasted = true; break;
                        }
                    }
                    if (!pasted) {
                        const text = await navigator.clipboard.readText();
                        document.execCommand('insertText', false, text);
                        wysiwygPane.dispatchEvent(new Event('input'));
                    }
                } catch (err) { myCloudShowAlert(this.L('error_lbl', 'Error'), "Clipboard API not supported. Use Shift+Paste."); }
            }));
        }
        topActions.appendChild(createIconBtn(svgs.cut, this.L('cut', 'Cut'), () => { document.execCommand('cut'); wysiwygPane.dispatchEvent(new Event('input')); }));


        ctx.appendChild(topActions);

        const createItem = (label, icon, actionFn) => {
            const div = document.createElement('div');
            div.className = 'ce-obs-ctx-item';
            const safeIcon = icon.includes('<svg') ? icon.replace('<svg', '<svg style="width:16px;height:16px;fill:currentColor;"') : icon;
            div.innerHTML = `<span class="ce-obs-ctx-icon">${safeIcon}</span><span>${label}</span>`;
            div.onmousedown = (ev) => ev.preventDefault();
            div.onclick = async () => {
                ctx.remove();
                document.removeEventListener('mousedown', closeCtx, true);
                wysiwygPane.focus();
                await actionFn();
            };
            return div;
        };
     
        if (!isInput) {
			ctx.appendChild(createItem(this.L('obs_bold', 'Bold'), '<b>B</b>', () => { document.execCommand('bold'); wysiwygPane.dispatchEvent(new Event('input')); }));
			ctx.appendChild(createItem(this.L('obs_italic', 'Italic'), '<i>I</i>', () => { document.execCommand('italic'); wysiwygPane.dispatchEvent(new Event('input')); }));
			ctx.appendChild(createItem(this.L('obs_underline', 'Underline'), '<u>U</u>', () => { document.execCommand('underline'); wysiwygPane.dispatchEvent(new Event('input')); }));
			ctx.appendChild(createItem(this.L('obs_highlight', 'Highlight'), '🖍️', () => { document.execCommand('hiliteColor', false, '#ffd700'); wysiwygPane.dispatchEvent(new Event('input')); }));
			ctx.appendChild(createItem(this.L('obs_clear_format', 'Clear Formatting'), '🧹', () => {
				this.removeSelectedFormatting(wysiwygPane);
				wysiwygPane.dispatchEvent(new Event('input'));
			}));
		}

        if (selectedText) {
            ctx.insertAdjacentHTML('beforeend', '<div class="ce-obs-ctx-sep"></div>');
            ctx.appendChild(createItem(this.L('obs_search_web', 'Search the Web'), '🔍', () => {
                const searchUrl = new URL('[https://www.google.com/search](https://www.google.com/search)');
                searchUrl.searchParams.set('q', selectedText);
                this.openExternalUrl(searchUrl.href);
            }));
            ctx.appendChild(createItem(this.L('obs_translate_sel', 'Translate Selection'), '🌐', () => {
                this.showTranslatePopup(ws, wysiwygPane, selectedText, e.clientX, e.clientY);
            }));
        }

        ws.appendChild(ctx);
        
        const rect = ws.getBoundingClientRect();
        let x = Math.min(e.clientX - rect.left, rect.width - ctx.offsetWidth - 10);
        let y = Math.min(e.clientY - rect.top, rect.height - ctx.offsetHeight - 10);
        if (x < 6) x = 6;
        if (y < 6) y = 6;
        
        ctx.style.left = x + 'px';
        ctx.style.top = y + 'px';
        
        ws.addEventListener('mousedown', closeCtx, true);
        document.addEventListener('mousedown', closeCtx, true);
    },

    showTranslatePopup: function(ws, wysiwygPane, text, clientX, clientY) {
        const existing = ws.querySelector('#ceObsTranslatePopup');
        if (existing) existing.remove();

        const defaultLang = (myCloudState.settings && myCloudState.settings.language)
            ? myCloudState.settings.language.split('-')[0]
            : ((typeof myCloudDetectedLang !== 'undefined' && myCloudDetectedLang) ? myCloudDetectedLang.split('-')[0] : 'en');

        const popup = document.createElement('div');
        popup.id = 'ceObsTranslatePopup';
        popup.className = 'ce-obs-translate-popup';

        const langs = [
            { code: 'en', name: 'English' },
            { code: 'de', name: 'Deutsch' },
            { code: 'fr', name: 'Français' },
            { code: 'es', name: 'Español' },
            { code: 'it', name: 'Italiano' },
            { code: 'pt', name: 'Português' },
            { code: 'nl', name: 'Nederlands' },
            { code: 'pl', name: 'Polski' },
            { code: 'ru', name: ' усский' },
            { code: 'uk', name: 'Українська' },
            { code: 'tr', name: 'Türkçe' },
            { code: 'ar', name: 'العربية' },
            { code: 'zh-CN', name: '中文 (简体)' },
            { code: 'ja', name: '日本語' },
            { code: 'ko', name: '한국어' }
        ];

        popup.innerHTML = `
            <div class="ce-obs-translate-header">
                <span>🌐 ${this.L('obs_translate', 'Translate')}</span>
                <select id="ceObsTransLang" class="ce-obs-find-input" style="padding:2px 6px;">
                    ${langs.map(l => `<option value="${l.code}" ${l.code.toLowerCase() === defaultLang.toLowerCase() ? 'selected' : ''}>${l.name}</option>`).join('')}
                </select>
                <span id="ceObsTransClose" style="cursor:pointer; font-size:16px; line-height:1;">✕</span>
            </div>
            <div id="ceObsTransResult" class="ce-obs-translate-body">${this.L('obs_translating', 'Translating...')}</div>
            <div style="display:flex; justify-content:space-between; gap:6px;">
                <button type="button" id="ceObsTransCopy" class="ce-obs-find-btn">${this.L('copy', 'Copy')}</button>
                <button type="button" id="ceObsTransReplace" class="ce-obs-find-btn">${this.L('obs_replace_selection', 'Replace Selection')}</button>
                <button type="button" id="ceObsTransExt" class="ce-obs-find-btn" title="${this.L('obs_open_gtranslate', 'Open in Google Translate')}">↗</button>
            </div>
        `;

        ws.appendChild(popup);
        const rect = ws.getBoundingClientRect();
        let x = Math.min(clientX - rect.left, rect.width - popup.offsetWidth - 12);
        let y = Math.min(clientY - rect.top + 10, rect.height - popup.offsetHeight - 12);
        if (x < 8) x = 8;
        if (y < 8) y = 8;
        popup.style.left = x + 'px';
        popup.style.top = y + 'px';

        const resultEl = popup.querySelector('#ceObsTransResult');
        const langSelect = popup.querySelector('#ceObsTransLang');
        let lastTranslated = '';

        // Uses same-origin PHP proxy action 'obs_translate' so browser CSP never blocks it
        const runTranslate = async (targetLang) => {
            resultEl.textContent = this.L('obs_translating', 'Translating...');
            try {
                const fd = new URLSearchParams({
                    myCloud_action: 'obs_translate',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    tl: targetLang,
                    text: text
                });
                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                if (res && res.status === 'OK' && res.translated) {
                    lastTranslated = res.translated;
                    resultEl.textContent = lastTranslated;
                } else {
                    throw new Error(res.msg || 'Translation error');
                }
            } catch (err) {
                resultEl.textContent = this.L('obs_translate_unavailable', 'Inline translation unavailable. Click ↗ to open Google Translate.');
            }
        };

        runTranslate(langSelect.value);
        langSelect.onchange = () => runTranslate(langSelect.value);

        popup.querySelector('#ceObsTransClose').onclick = () => popup.remove();
        popup.querySelector('#ceObsTransCopy').onclick = () => {
            if (lastTranslated) navigator.clipboard.writeText(lastTranslated);
            popup.remove();
        };
        popup.querySelector('#ceObsTransReplace').onclick = () => {
            if (lastTranslated && wysiwygPane) {
                wysiwygPane.focus();
                document.execCommand('insertText', false, lastTranslated);
                wysiwygPane.dispatchEvent(new Event('input'));
            }
            popup.remove();
        };
        popup.querySelector('#ceObsTransExt').onclick = () => {
            const tl = langSelect.value;
            const extUrl = new URL('[https://translate.google.com/](https://translate.google.com/)');
            extUrl.searchParams.set('sl', 'auto');
            extUrl.searchParams.set('tl', tl);
            extUrl.searchParams.set('text', text);
            extUrl.searchParams.set('op', 'translate');
            this.openExternalUrl(extUrl.href);
            popup.remove();
        };
    },

    // ------------------------------------------------------------------------
    // 5.8 FORMATTING-AGNOSTIC FIND & REPLACE + [[WIKILINK]] AUTOCOMPLETE
    // ------------------------------------------------------------------------
    toggleFindBar: function() {
        const bar = document.getElementById('ceObsFindBar');
        if (!bar) return;
        const isShowing = bar.classList.toggle('show');
        if (isShowing) {
            const inp = document.getElementById('ceObsFindInput');
            if (inp) { inp.focus(); inp.select(); }
        }
    },

    // Collects all visible text nodes inside WYSIWYG (ignoring YAML frontmatter) so searches match across bold/italic/color tags
    getWysiwygTextMap: function(wysiwygPane) {
        const nodes = [];
        let fullText = '';
        const walker = document.createTreeWalker(wysiwygPane, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) => {
                if (n.parentElement && n.parentElement.closest('details.ce-obs-frontmatter')) {
                    return NodeFilter.FILTER_REJECT;
                }
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        let n;
        while ((n = walker.nextNode())) {
            const len = n.nodeValue.length;
            if (len > 0) {
                nodes.push({ node: n, start: fullText.length, end: fullText.length + len });
                fullText += n.nodeValue;
            }
        }
        return { nodes, fullText };
    },

    createRangeFromCharOffsets: function(nodes, startChar, endChar) {
        let startNode = null, startOffset = 0, endNode = null, endOffset = 0;
        for (let info of nodes) {
            if (!startNode && startChar >= info.start && startChar < info.end) {
                startNode = info.node;
                startOffset = startChar - info.start;
            }
            if (!endNode && endChar >= info.start && endChar <= info.end) {
                endNode = info.node;
                endOffset = endChar - info.start;
                break;
            }
        }
        if (startNode && endNode) {
            const r = document.createRange();
            r.setStart(startNode, startOffset);
            r.setEnd(endNode, endOffset);
            return r;
        }
        return null;
    },

    bindFindReplaceBar: function(ws, wysiwygPane, textarea) {
        const bar = ws.querySelector('#ceObsFindBar');
        const findInp = ws.querySelector('#ceObsFindInput');
        const repInp = ws.querySelector('#ceObsReplaceInput');
        const findBtn = ws.querySelector('#ceObsFindNextBtn');
        const repBtn = ws.querySelector('#ceObsReplaceBtn');
        const closeBtn = ws.querySelector('#ceObsFindCloseBtn');
        const vaultRepBtn = ws.querySelector('#ceObsVaultReplaceBtn');
        if (vaultRepBtn) {
            vaultRepBtn.onclick = () => {
                this.promptVaultSearchReplace(this.activeFile || myCloudState.currentDir, findInp.value, repInp ? repInp.value : '');
            };
        }
        if (!bar || !findInp) return;

        let lastMatchIndex = -1;

        const doFind = () => {
            const q = findInp.value;
            if (!q) return;
            const qLower = q.toLowerCase();

            if (this.viewMode === 'code' && textarea) {
                const start = textarea.selectionEnd || 0;
                let idx = textarea.value.toLowerCase().indexOf(qLower, start);
                if (idx === -1) idx = textarea.value.toLowerCase().indexOf(qLower, 0);
                if (idx !== -1) {
                    textarea.focus();
                    textarea.setSelectionRange(idx, idx + q.length);
                }
            } else if (wysiwygPane) {
                const { nodes, fullText } = this.getWysiwygTextMap(wysiwygPane);
                const lowerFull = fullText.toLowerCase();
                let idx = lowerFull.indexOf(qLower, lastMatchIndex + 1);
                if (idx === -1) idx = lowerFull.indexOf(qLower, 0);
                if (idx !== -1) {
                    lastMatchIndex = idx;
                    const range = this.createRangeFromCharOffsets(nodes, idx, idx + q.length);
                    if (range) {
                        const root = this.shadowRoot || document;
                        const sel = root.getSelection ? root.getSelection() : window.getSelection();
                        sel.removeAllRanges();
                        sel.addRange(range);
                        const el = range.startContainer.parentElement;
                        if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                }
            }
        };

        findInp.addEventListener('input', () => { lastMatchIndex = -1; });
        findBtn.onclick = doFind;
        findInp.onkeydown = (e) => {
            if (e.key === 'Enter') { e.preventDefault(); doFind(); }
            if (e.key === 'Escape') { e.preventDefault(); bar.classList.remove('show'); }
        };

        repBtn.onclick = () => {
            const q = findInp.value;
            const r = repInp.value || '';
            if (!q) return;
            const qLower = q.toLowerCase();

            if (this.viewMode === 'wysiwyg' && wysiwygPane) {
                // Formatting-agnostic replacement across DOM text nodes (even when split across bold/italic/color spans)
                const { nodes, fullText } = this.getWysiwygTextMap(wysiwygPane);
                const lowerFull = fullText.toLowerCase();
                const matches = [];
                let pos = 0;
                while ((pos = lowerFull.indexOf(qLower, pos)) !== -1) {
                    matches.push({ start: pos, end: pos + q.length });
                    pos += q.length;
                }
                // Replace from end to start so character offsets remain valid
                for (let i = matches.length - 1; i >= 0; i--) {
                    const m = matches[i];
                    const range = this.createRangeFromCharOffsets(nodes, m.start, m.end);
                    if (range) {
                        range.deleteContents();
                        range.insertNode(document.createTextNode(r));
                    }
                }
                if (matches.length > 0) {
                    this.cleanInlineStyles(wysiwygPane);
                    wysiwygPane.dispatchEvent(new Event('input'));
                }
            } else if (textarea) {
                const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                textarea.value = textarea.value.replace(new RegExp(escaped, 'gi'), r);
                textarea.dispatchEvent(new Event('input'));
            }
        };

        closeBtn.onclick = () => bar.classList.remove('show');
    },

    handleWysiwygKeydown: function(e, ws, wysiwygPane) {
        if (e.altKey && !e.ctrlKey && !e.metaKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
            e.preventDefault();
            this.navigateNoteHistory(e.key === 'ArrowLeft' ? -1 : 1);
            return;
        }
        const mod = e.ctrlKey || e.metaKey;
        if (mod && e.key.toLowerCase() === 's') {
            e.preventDefault();
            this.syncWysiwygToMarkdown(wysiwygPane);
            this.saveCurrentFile();
            return;
        }
        if (mod && e.key.toLowerCase() === 'f') {
            e.preventDefault();
            this.toggleFindBar();
            return;
        }
        if (mod && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            this.promptInsertLink(wysiwygPane, document.getElementById('ceObsTextarea'), (html) => {
                document.execCommand('insertHTML', false, this.sanitizeUntrustedHTML(html));
                this.postProcessPreviewDOM(wysiwygPane);
                wysiwygPane.dispatchEvent(new Event('input'));
            });
            return;
        }
    },
	
	ensureVaultIndexLoaded: async function(vaultRoot) {
        if (!vaultRoot) return;
        if (!this._vaultFullLoaded) this._vaultFullLoaded = new Set();
        if (this._vaultFullLoaded.has(vaultRoot)) return;
        this._vaultFullLoaded.add(vaultRoot);
        if (typeof myCloudFetchDirectory === 'function') {
            try {
                await myCloudFetchDirectory(vaultRoot, 100, true);
            } catch (e) {
                this._vaultFullLoaded.delete(vaultRoot);
            }
        }
    },
	
	handleWikiLinkKeydown: function(e, ws) {
        const popup = ws ? ws.querySelector('#ceObsWikiPopup') : document.getElementById('ceObsWikiPopup');
        if (!popup) return false;
        const items = Array.from(popup.querySelectorAll('.ce-obs-wikilink-item'));
        if (items.length === 0) return false;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            this._wikiSelectedIndex = (this._wikiSelectedIndex + 1) % items.length;
            this.updateWikiPopupSelection(items);
            return true;
        }
        if (e.key === 'ArrowUp') {
            e.preventDefault();
            this._wikiSelectedIndex = (this._wikiSelectedIndex - 1 + items.length) % items.length;
            this.updateWikiPopupSelection(items);
            return true;
        }
        if (e.key === 'Enter' || e.key === 'Tab') {
            e.preventDefault();
            const targetItem = items[this._wikiSelectedIndex] || items[0];
            if (targetItem) targetItem.click();
            return true;
        }
        if (e.key === 'Escape') {
            e.preventDefault();
            popup.remove();
            return true;
        }
        return false;
    },

    updateWikiPopupSelection: function(items) {
        items.forEach((el, idx) => {
            if (idx === this._wikiSelectedIndex) {
                el.classList.add('active');
                el.style.background = 'var(--hover-bg-medium, rgba(0, 120, 212, 0.14))';
                el.scrollIntoView({ block: 'nearest' });
            } else {
                el.classList.remove('active');
                el.style.background = '';
            }
        });
    },

    checkWikiLinkTrigger: async function(ws, wysiwygPane, textarea) {
        let existing = ws.querySelector('#ceObsWikiPopup');
        let rawTrigger = null;
        let caretRect = null;

        if (wysiwygPane && this.shadowRoot) {
            const sel = this.shadowRoot.getSelection ? this.shadowRoot.getSelection() : window.getSelection();
            if (sel && sel.rangeCount > 0 && sel.isCollapsed) {
                const node = sel.anchorNode;
                if (node && node.nodeType === Node.TEXT_NODE) {
                    const before = node.nodeValue.substring(0, sel.anchorOffset);
                    const m = before.match(/\[\[([^\[\]\n]*)$/);
                    if (m) {
                        rawTrigger = m[1];
                        try {
                            const r = sel.getRangeAt(0).cloneRange();
                            const rects = r.getClientRects();
                            if (rects && rects.length > 0) caretRect = rects[0];
                        } catch (e) {}
                    }
                }
            }
        } else if (textarea) {
            const before = textarea.value.substring(0, textarea.selectionStart);
            const m = before.match(/\[\[([^\[\]\n]*)$/);
            if (m) rawTrigger = m[1];
        }

        if (rawTrigger === null) {
            if (existing) existing.remove();
            return;
        }

        const vaultRoot = this.getVaultRoot(this.activeFile);
        if (!vaultRoot) return;

        // Ensure all subdirectories in the vault are indexed in memory for large knowledge bases
        await this.ensureVaultIndexLoaded(vaultRoot);

        // Parse optional #heading and |alias inside [[query#heading|alias
        let noteQuery = rawTrigger;
        let aliasPart = '';
        let headingPart = '';

        const pipeIdx = noteQuery.indexOf('|');
        if (pipeIdx !== -1) {
            aliasPart = noteQuery.substring(pipeIdx + 1);
            noteQuery = noteQuery.substring(0, pipeIdx);
        }
        const hashIdx = noteQuery.indexOf('#');
        if (hashIdx !== -1) {
            headingPart = noteQuery.substring(hashIdx + 1);
            noteQuery = noteQuery.substring(0, hashIdx);
        }

        const qClean = noteQuery.trim().toLowerCase();
        const qTokens = qClean.split(/\s+/).filter(Boolean);
        const recentSet = new Set(this.noteHistory || []);

        // Count basename occurrences across the vault to know when relative path disambiguation is needed
        const nameFrequency = {};
        const allVaultNotes = [];

        (myCloudState.allItems || []).forEach(i => {
            if (i.size === 'DIR') return;
            if (vaultRoot !== '/' && i.name !== vaultRoot && !i.name.startsWith(vaultRoot + '/')) return;
            if (this.isHiddenFolder(i.name)) return;

            const rawName = (i.displayName || (myCloudState.pathNames && myCloudState.pathNames[i.name]) || i.name.split('/').pop()).replace(/\.enc$/, '');
            if (!rawName.toLowerCase().endsWith('.md')) return;

            const baseTitle = rawName.slice(0, -3);
            const relFull = (vaultRoot === '/' ? i.name.substring(1) : i.name.substring(vaultRoot.length + 1)).replace(/\.enc$/, '').replace(/\.md$/i, '');
            const lastSlash = relFull.lastIndexOf('/');
            const folderRel = lastSlash !== -1 ? relFull.substring(0, lastSlash) : '';

            const lowerBase = baseTitle.toLowerCase();
            nameFrequency[lowerBase] = (nameFrequency[lowerBase] || 0) + 1;

            allVaultNotes.push({
                fullPath: i.name,
                title: baseTitle,
                relPath: relFull,
                folder: folderRel,
                date: i.date || ''
            });
        });

        // Score and filter notes
        const scored = [];
        for (let n of allVaultNotes) {
            const tLower = n.title.toLowerCase();
            const pLower = n.relPath.toLowerCase();

            let score = 0;
            if (qTokens.length === 0) {
                score = recentSet.has(n.fullPath) ? 500 : 100;
            } else {
                const allMatch = qTokens.every(tok => pLower.includes(tok));
                if (!allMatch) continue;

                if (tLower === qClean) score += 1000;
                else if (tLower.startsWith(qClean)) score += 600;
                else if (tLower.includes(qClean)) score += 350;
                else score += 150;

                // Boost word-boundary matches
                for (let tok of qTokens) {
                    if (tLower.startsWith(tok)) score += 80;
                    else if (tLower.includes(' ' + tok) || tLower.includes('-' + tok) || tLower.includes('_' + tok)) score += 50;
                }
                if (recentSet.has(n.fullPath)) score += 120;
                // Slightly prefer shorter titles on ties
                score -= Math.min(40, n.title.length * 0.5);
            }
            scored.push({ note: n, score });
        }

        scored.sort((a, b) => {
            if (b.score !== a.score) return b.score - a.score;
            return a.note.title.localeCompare(b.note.title, undefined, { numeric: true, sensitivity: 'base' });
        });

        const topMatches = scored.slice(0, 40).map(s => s.note);

        if (!existing) {
            existing = document.createElement('div');
            existing.id = 'ceObsWikiPopup';
            existing.className = 'ce-obs-wikilink-popup';
            existing.style.cssText = 'position:absolute; z-index:9500; width:420px; max-width:calc(100vw - 32px); max-height:340px; display:flex; flex-direction:column; background:var(--gray-00, #fff); border:1px solid var(--border-default, #ccc); border-radius:8px; box-shadow:0 8px 28px rgba(0,0,0,0.22); overflow:hidden; font-family:var(--font-family, sans-serif);';
            ws.appendChild(existing);
        }

        // Position near caret if available, otherwise sensible default
        const wsRect = ws.getBoundingClientRect();
        if (caretRect && caretRect.top > 0) {
            let topPos = caretRect.bottom - wsRect.top + 8;
            let leftPos = caretRect.left - wsRect.left;
            if (topPos + 340 > wsRect.height) {
                topPos = Math.max(50, caretRect.top - wsRect.top - 345);
            }
            if (leftPos + 420 > wsRect.width) {
                leftPos = Math.max(12, wsRect.width - 432);
            }
            existing.style.top = topPos + 'px';
            existing.style.left = Math.max(12, leftPos) + 'px';
        } else {
            existing.style.top = '95px';
            existing.style.left = '36px';
        }

        this._wikiSelectedIndex = 0;

        const highlightMatch = (text) => {
            const safe = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(text) : text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            if (!qClean) return safe;
            const escQ = qClean.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return safe.replace(new RegExp(`(${escQ})`, 'ig'), '<mark style="background:rgba(255,208,0,0.45); color:inherit; padding:0 2px; border-radius:2px;">$1</mark>');
        };

        const insertResolvedWikiLink = (noteObj, isNewCreate = false) => {
            existing.remove();
            let targetSpec = noteObj.title;
            let displayLabel = noteObj.title;

            if (!isNewCreate) {
                const isAmbiguous = (nameFrequency[noteObj.title.toLowerCase()] || 0) > 1;
                if (isAmbiguous && noteObj.folder) {
                    targetSpec = noteObj.relPath;
                }
            }
            if (headingPart) {
                targetSpec += '#' + headingPart.trim();
                displayLabel += ' › ' + headingPart.trim();
            }
            if (aliasPart) {
                displayLabel = aliasPart.trim();
            }

            // 100% Obsidian-compliant WikiLink markdown output
            const needsExplicitPipe = (aliasPart !== '') || (targetSpec !== displayLabel && !headingPart);
            const finalMarkdown = needsExplicitPipe ? `[[${targetSpec}|${displayLabel}]]` : `[[${targetSpec}]]`;

            if (wysiwygPane && this.shadowRoot) {
                const sel = this.shadowRoot.getSelection ? this.shadowRoot.getSelection() : window.getSelection();
                if (sel && sel.rangeCount > 0) {
                    const node = sel.anchorNode;
                    const offset = sel.anchorOffset;
                    const before = node.nodeValue.substring(0, offset);
                    const startIdx = before.lastIndexOf('[[');
                    if (startIdx !== -1) {
                        const r = document.createRange();
                        r.setStart(node, startIdx);
                        r.setEnd(node, offset);
                        sel.removeAllRanges();
                        sel.addRange(r);
                        const safeTarget = targetSpec.replace(/"/g, '&quot;');
                        const safeLabel = displayLabel.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                        document.execCommand('insertHTML', false, `<a href="#" class="ce-obs-wikilink" data-target="${safeTarget}">${safeLabel}</a>&nbsp;`);
                        this.postProcessPreviewDOM(wysiwygPane);
                        wysiwygPane.dispatchEvent(new Event('input'));
                    }
                }
            } else if (textarea) {
                const pos = textarea.selectionStart;
                const before = textarea.value.substring(0, pos);
                const startIdx = before.lastIndexOf('[[');
                if (startIdx !== -1) {
                    textarea.setRangeText(finalMarkdown + ' ', startIdx, pos, 'end');
                    textarea.dispatchEvent(new Event('input'));
                    textarea.focus();
                }
            }
        };

        let headerText = qClean
            ? `${scored.length} ${this.L('obs_matches', 'notes found')}`
            : `${this.L('obs_recent_all_notes', 'Recent & Vault Notes')} (${allVaultNotes.length})`;

        existing.innerHTML = `
            <div style="padding:6px 12px; font-size:11px; font-weight:600; color:var(--text-secondary, #666); background:var(--gray-05, #f5f5f5); border-bottom:1px solid var(--border-subtle, #e5e5e5); display:flex; justify-content:space-between; align-items:center;">
                <span>🔗 ${headerText}</span>
                <span style="font-weight:400; opacity:0.85;">↑↓ ${this.L('obs_nav', 'Navigate')} · ↵ ${this.L('obs_insert', 'Insert')} · | ${this.L('obs_alias', 'Alias')}</span>
            </div>
            <div class="ce-obs-wikilink-list" style="overflow-y:auto; flex:1; max-height:295px; padding:4px 0;"></div>
        `;

        const listEl = existing.querySelector('.ce-obs-wikilink-list');

        topMatches.forEach((n, idx) => {
            const item = document.createElement('div');
            item.className = 'ce-obs-wikilink-item' + (idx === 0 ? ' active' : '');
            item.style.cssText = 'padding:6px 12px; cursor:pointer; display:flex; flex-direction:column; gap:2px; border-bottom:1px solid var(--border-subtle, rgba(0,0,0,0.04));' + (idx === 0 ? 'background:var(--hover-bg-medium, rgba(0, 120, 212, 0.14));' : '');

            const folderBadge = n.folder
                ? `<span style="font-size:11px; color:var(--text-secondary, #777); display:flex; align-items:center; gap:4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">📁 ${typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(n.folder) : n.folder}</span>`
                : `<span style="font-size:11px; color:var(--text-secondary, #777); opacity:0.7;">/ (Vault Root)</span>`;

            item.innerHTML = `
                <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
                    <span style="font-size:13.5px; font-weight:600; color:var(--text-primary, #202020); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">📄 ${highlightMatch(n.title)}</span>
                    ${recentSet.has(n.fullPath) ? '<span style="font-size:10px; padding:1px 6px; border-radius:10px; background:rgba(122,85,203,0.14); color:#7a55cb; flex-shrink:0;">Recent</span>' : ''}
                </div>
                ${folderBadge}
            `;

            item.onmousedown = (ev) => ev.preventDefault();
            item.onmouseenter = () => {
                this._wikiSelectedIndex = idx;
                this.updateWikiPopupSelection(Array.from(listEl.querySelectorAll('.ce-obs-wikilink-item')));
            };
            item.onclick = () => insertResolvedWikiLink(n, false);
            listEl.appendChild(item);
        });

        // Option to link to a not-yet-created note if no exact title match exists
        const exactExists = allVaultNotes.some(n => n.title.toLowerCase() === qClean);
        if (qClean && !exactExists) {
            const createItem = document.createElement('div');
            const newIdx = topMatches.length;
            createItem.className = 'ce-obs-wikilink-item' + (newIdx === 0 ? ' active' : '');
            createItem.style.cssText = 'padding:8px 12px; cursor:pointer; display:flex; align-items:center; gap:8px; color:var(--accent-primary, #0078d4); font-size:13px; font-weight:600;' + (newIdx === 0 ? 'background:var(--hover-bg-medium, rgba(0, 120, 212, 0.14));' : '');
            const cleanNewTitle = noteQuery.trim();
            const safeNew = typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(cleanNewTitle) : cleanNewTitle;
            createItem.innerHTML = `<span>➕ ${this.L('obs_link_new_note', 'Link to new note:')} <b>"${safeNew}"</b></span>`;
            createItem.onmousedown = (ev) => ev.preventDefault();
            createItem.onclick = () => insertResolvedWikiLink({ title: cleanNewTitle, relPath: cleanNewTitle, folder: '' }, true);
            listEl.appendChild(createItem);
        }
    },

    // ------------------------------------------------------------------------
    // 6. WYSIWYG HTML -> OBSIDIAN MARKDOWN SERIALIZER (WITH CLEAN TAG STRIPPING)
    // ------------------------------------------------------------------------
    syncWysiwygToMarkdown: function(wysiwygEl) {
        if (!wysiwygEl) return;
        const clone = wysiwygEl.cloneNode(true);

        const fmDetails = clone.querySelector('details.ce-obs-frontmatter');
        if (fmDetails) fmDetails.remove();

        this.cleanInlineStyles(clone);

        const fontSizeMap = { '1': '10px', '2': '13px', '3': '', '4': '18px', '5': '24px', '6': '32px', '7': '48px' };

        const serializeNode = (node, isHtmlCtx = false) => {
            if (node.nodeType === Node.TEXT_NODE) return node.nodeValue;
            if (node.nodeType !== Node.ELEMENT_NODE) return '';

            const tag = node.tagName.toLowerCase();
            const align = node.style.textAlign || node.getAttribute('align');
            const indentLvl = parseInt(node.getAttribute('data-indent'), 10);
            
            let enforcesHtml = true;
            if (align || indentLvl > 0 || node.classList.contains('ce-obs-multicol') || tag === 'table' || tag === 'details') {
                enforcesHtml = true;
            }

            if (node.dataset && node.dataset.rawMd) {
                const isBlock = node.classList.contains('ce-obs-excalidraw-embed') || node.classList.contains('ce-obs-code-block');
                return decodeURIComponent(node.dataset.rawMd) + (isBlock ? '\n\n' : '');
            }
            if (node.classList.contains('ce-obs-wikilink')) {
                const target = node.dataset.target || node.innerText;
                const label = node.innerText;
                return target === label ? `[[${target}]]` : `[[${target}|${label}]]`;
            }
            if (node.classList.contains('ce-obs-async-img')) {
                const rawName = node.getAttribute('alt') || node.dataset.path.split('/').pop();
                return `![[${rawName}]]`;
            }
            if (node.classList.contains('ce-obs-multicol')) {
                const cols = Array.from(node.querySelectorAll('.ce-obs-col')).map(c => serializeChildren(c, true).trim());
                return `\n--- start-multi-column: ID_${Math.floor(Math.random()*999)}\n\`\`\`column-settings\nnumber of columns: ${cols.length}\n\`\`\`\n\n` +
                       cols.join('\n\n--- end-column ---\n\n') +
                       `\n\n--- end-multi-column\n\n`;
            }
            if (node.classList.contains('ce-obs-callout')) {
                const cType = node.dataset.callout || 'info';
                const titleEl = node.querySelector('.ce-obs-callout-title');
                const titleTxt = titleEl ? titleEl.innerText.replace(/^📌\s*/, '').trim() : cType;
                const bodyClone = node.cloneNode(true);
                const tRemove = bodyClone.querySelector('.ce-obs-callout-title');
                if (tRemove) tRemove.remove();
                const lines = serializeChildren(bodyClone, enforcesHtml).trim().split('\n').map(l => `> ${l}`).join('\n');
                return `\n> [!${cType}] ${titleTxt}\n${lines}\n\n`;
            }

            switch (tag) {
                case 'h1': return isHtmlCtx ? `<h1>${serializeChildren(node, true)}</h1>` : `# ${serializeChildren(node).trim()}\n\n`;
                case 'h2': return isHtmlCtx ? `<h2>${serializeChildren(node, true)}</h2>` : `## ${serializeChildren(node).trim()}\n\n`;
                case 'h3': return isHtmlCtx ? `<h3>${serializeChildren(node, true)}</h3>` : `### ${serializeChildren(node).trim()}\n\n`;
                case 'h4': return isHtmlCtx ? `<h4>${serializeChildren(node, true)}</h4>` : `#### ${serializeChildren(node).trim()}\n\n`;
                case 'h5': return isHtmlCtx ? `<h5>${serializeChildren(node, true)}</h5>` : `##### ${serializeChildren(node).trim()}\n\n`;
                case 'p':
                case 'div': {
                    const cb = node.querySelector(':scope > input[type="checkbox"]');
                    if (cb) {
                        const checked = cb.checked ? 'x' : ' ';
                        return `- [${checked}] ${serializeChildren(node, enforcesHtml).trim()}\n`;
                    }
                    const inner = serializeChildren(node, enforcesHtml).trim();
                    if (!inner) return '\n';
                    if (indentLvl > 0 || (align && (align === 'center' || align === 'right'))) {
                        const attrs = [];
                        if (align && (align === 'center' || align === 'right')) attrs.push(`align="${align}"`);
                        if (indentLvl > 0) attrs.push(`data-indent="${indentLvl}" style="padding-inline-start:${indentLvl * 28}px;"`);
                        return `<div ${attrs.join(' ')}>${inner}</div>\n\n`;
                    }
                    return isHtmlCtx ? `<div>${inner}</div>` : `${inner}\n\n`;
                }
                case 'br': return isHtmlCtx ? '<br>' : '\n';
                case 'hr': return isHtmlCtx ? '<hr>' : '\n---\n\n';
                case 'strong':
                case 'b': return isHtmlCtx ? `<strong>${serializeChildren(node, true)}</strong>` : `**${serializeChildren(node)}**`;
                case 'em':
                case 'i': return isHtmlCtx ? `<em>${serializeChildren(node, true)}</em>` : `*${serializeChildren(node)}*`;
                case 'del':
                case 's':
                case 'strike': return isHtmlCtx ? `<del>${serializeChildren(node, true)}</del>` : `~~${serializeChildren(node)}~~`;
                case 'u': return `<u>${serializeChildren(node, true)}</u>`;
                case 'mark': return isHtmlCtx ? `<mark>${serializeChildren(node, true)}</mark>` : `==${serializeChildren(node)}==`;
                case 'a': {
                    const href = node.getAttribute('href') || '';
                    if (href && !isHtmlCtx) {
                        return `[${serializeChildren(node, false)}](${href})`;
                    }
                    return `<a href="${href}">${serializeChildren(node, true)}</a>`;
					}
                case 'span':
                case 'font': {
                    const color = node.style.color || node.getAttribute('color') || '';
                    const bg = node.style.backgroundColor || '';
                    let fSize = node.style.fontSize || (node.getAttribute('size') ? fontSizeMap[node.getAttribute('size')] : '');
                    if (fSize === '15px' || fSize === '15pt') fSize = '';

                    if (!color && !fSize && (bg === 'rgb(255, 215, 0)' || bg === '#ffd700')) {
                        return isHtmlCtx ? `<mark>${serializeChildren(node, true)}</mark>` : `==${serializeChildren(node, false)}==`;
                    }

                    if (color || bg || fSize) {
                        let styleStr = '';
                        if (color) styleStr += `color:${color};`;
                        if (bg) styleStr += `background-color:${bg}; padding:0 4px; border-radius:3px;`;
                        if (fSize) styleStr += `font-size:${fSize};`;
                        return `<span style="${styleStr}">${serializeChildren(node, true)}</span>`;
                    }
                    return serializeChildren(node, enforcesHtml);
                }
                case 'ul': {
                    return isHtmlCtx ? `<ul>${serializeChildren(node, true)}</ul>` : Array.from(node.children).map(li => {
                        const cb = li.querySelector('input[type="checkbox"]');
                        if (cb) return `- [${cb.checked ? 'x' : ' '}] ${serializeChildren(li, false).trim()}`;
                        return `- ${serializeChildren(li, false).trim()}`;
                    }).join('\n') + '\n\n';
                }
                case 'ol': {
                    return isHtmlCtx ? `<ol>${serializeChildren(node, true)}</ol>` : Array.from(node.children).map((li, idx) => `${idx + 1}. ${serializeChildren(li, false).trim()}`).join('\n') + '\n\n';
                }
                case 'li': return isHtmlCtx ? `<li>${serializeChildren(node, true)}</li>` : serializeChildren(node, false);
                case 'table': return isHtmlCtx ? `<table>${serializeChildren(node, true)}</table>` : '\n' + this.htmlTableToMarkdown(node) + '\n';
                case 'details': {
                    if (node.classList.contains('ce-obs-frontmatter')) return '';
                    const sumEl = node.querySelector(':scope > summary');
                    const sumTxt = sumEl ? serializeChildren(sumEl, true).trim() : 'Details';
                    const bodyClone = node.cloneNode(true);
                    const sRem = bodyClone.querySelector(':scope > summary');
                    if (sRem) sRem.remove();
                    const innerMd = serializeChildren(bodyClone, false).trim();
                    const openAttr = node.hasAttribute('open') ? ' open' : '';
                    return `\n<details${openAttr}>\n<summary>${sumTxt}</summary>\n\n${innerMd}\n\n</details>\n\n`;
                }
                case 'input': return '';
                default: return serializeChildren(node, enforcesHtml);
            }
        };

        const serializeChildren = (parent, ctx = false) => Array.from(parent.childNodes).map(n => serializeNode(n, ctx)).join('');

        const bodyMd = serializeChildren(clone, false).replace(/\n{3,}/g, '\n\n').trim();
		this.activeContent = (this.frontmatterRaw ? this.frontmatterRaw + '\n' : '') + bodyMd + '\n';
    },

    // ------------------------------------------------------------------------
    // 7. EXCEL PASTE, TABLE EDITOR, MULTI-COLUMN, CODE-STYLER
    // ------------------------------------------------------------------------
    handlePaste: async function(e, textarea, wysiwygPane) {
        const clipboard = e.clipboardData || window.clipboardData;
        if (!clipboard) return;

        const isWysiwyg = (this.viewMode === 'wysiwyg');
        const wantFormatted = this._shiftHeldPaste;

        if (clipboard.files && clipboard.files.length > 0) {
            e.preventDefault();
            for (let file of clipboard.files) {
                await this.uploadToZAttachments(file, textarea, wysiwygPane);
            }
            return;
        }

        const htmlData = clipboard.getData('text/html');
        const plainData = clipboard.getData('text/plain');
        const trimmedPlain = (plainData || '').trim();

        // Automatically convert pasted URLs into hyperlinks
        if (trimmedPlain && /^(https?:\/\/[^\s<>"]+|mailto:[^\s<>"]+)$/i.test(trimmedPlain)) {
            e.preventDefault();
            const safeUrl = trimmedPlain.replace(/"/g, '&quot;');
            if (isWysiwyg && wysiwygPane) {
                const root = this.shadowRoot || document;
                const sel = root.getSelection ? root.getSelection() : window.getSelection();
                const selText = sel ? sel.toString().trim() : '';
                const label = selText
                    ? (typeof myCloudEscapeHtml === 'function' ? myCloudEscapeHtml(selText) : selText.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'))
                    : safeUrl;
                document.execCommand('insertHTML', false, `<a href="${safeUrl}">${label}</a>`);
                this.postProcessPreviewDOM(wysiwygPane);
                wysiwygPane.dispatchEvent(new Event('input'));
            } else if (textarea) {
                const start = textarea.selectionStart;
                const end = textarea.selectionEnd;
                const selText = textarea.value.substring(start, end).trim();
                const mdLink = selText ? `[${selText}](${trimmedPlain})` : `[${trimmedPlain}](${trimmedPlain})`;
                textarea.setRangeText(mdLink, start, end, 'end');
                textarea.dispatchEvent(new Event('input'));
            }
            return;
        }

        if (htmlData && wantFormatted && htmlData.includes('<table')) {
            const doc = new DOMParser().parseFromString(htmlData, 'text/html');
            const table = doc.querySelector('table');
            if (table) {
                e.preventDefault();
                const mdTable = this.htmlTableToMarkdown(table);
                if (isWysiwyg && wysiwygPane) {
                    const renderedTbl = this.sanitizeUntrustedHTML(this.parseBasicMarkdown(mdTable));
                    document.execCommand('insertHTML', false, renderedTbl);
                    this.postProcessPreviewDOM(wysiwygPane);
                } else if (textarea) {
                    textarea.setRangeText(mdTable, textarea.selectionStart, textarea.selectionEnd, 'end');
                    textarea.dispatchEvent(new Event('input'));
                }
                return;
            }
        } else if (htmlData && wantFormatted) {
            e.preventDefault();
            if (isWysiwyg && wysiwygPane) {
                const sanitized = this.sanitizeUntrustedHTML(htmlData);
                document.execCommand('insertHTML', false, sanitized);
                this.postProcessPreviewDOM(wysiwygPane);
            } else if (textarea) {
                textarea.setRangeText(plainData, textarea.selectionStart, textarea.selectionEnd, 'end');
                textarea.dispatchEvent(new Event('input'));
            }
            return;
        } else if (plainData && plainData.includes('\t') && plainData.includes('\n')) {
            const rows = plainData.trim().split(/\r?\n/).map(r => r.split('\t'));
            if (rows.length >= 2 && rows[0].length >= 2) {
                e.preventDefault();
                const mdTable = this.arrayToMarkdownTable(rows);
                if (isWysiwyg && wysiwygPane) {
                    const renderedTbl = this.sanitizeUntrustedHTML(this.parseBasicMarkdown(mdTable));
                    document.execCommand('insertHTML', false, renderedTbl);
                    this.postProcessPreviewDOM(wysiwygPane);
                } else if (textarea) {
                    textarea.setRangeText(mdTable, textarea.selectionStart, textarea.selectionEnd, 'end');
                    textarea.dispatchEvent(new Event('input'));
                }
                return;
            }
        }
        
        if (plainData) {
            e.preventDefault();
            if (isWysiwyg && wysiwygPane) {
                document.execCommand('insertText', false, plainData);
                wysiwygPane.dispatchEvent(new Event('input'));
            } else if (textarea) {
                textarea.setRangeText(plainData, textarea.selectionStart, textarea.selectionEnd, 'end');
                textarea.dispatchEvent(new Event('input'));
            }
        }
    },

    htmlTableToMarkdown: function(tableEl) {
        const rows = [];
        tableEl.querySelectorAll('tr').forEach(tr => {
            const row = [];
            tr.querySelectorAll('th, td').forEach(cell => {
                row.push(cell.innerText.replace(/\r?\n/g, ' ').replace(/\|/g, '\\|').trim());
            });
            if (row.length > 0) rows.push(row);
        });
        return this.arrayToMarkdownTable(rows);
    },

    arrayToMarkdownTable: function(rows) {
        if (!rows || rows.length === 0) return '';
        const colCount = Math.max(...rows.map(r => r.length));
        const normRows = rows.map(r => {
            while (r.length < colCount) r.push('');
            return r;
        });

        let md = '| ' + normRows[0].join(' | ') + ' |\n';
        md += '| ' + normRows[0].map(() => ':---').join(' | ') + ' |\n';
        for (let i = 1; i < normRows.length; i++) {
            md += '| ' + normRows[i].join(' | ') + ' |\n';
        }
        return this.formatAllMarkdownTables(md);
    },

    formatAllMarkdownTables: function(text) {
        return text.replace(/((?:^\s*\|.*\|\s*\r?\n)+)/gm, (tableBlock) => {
            const lines = tableBlock.trim().split(/\r?\n/);
            if (lines.length < 2) return tableBlock;

            const matrix = lines.map(l => l.trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim()));
            const colCount = Math.max(...matrix.map(r => r.length));
            const colWidths = new Array(colCount).fill(3);

            matrix.forEach((row, rIdx) => {
                for (let c = 0; c < colCount; c++) {
                    const val = row[c] || '';
                    if (rIdx === 1 && /^:?-{3,}:?$/.test(val)) continue;
                    colWidths[c] = Math.max(colWidths[c], val.length);
                }
            });

            return matrix.map((row, rIdx) => {
                const padded = [];
                for (let c = 0; c < colCount; c++) {
                    let val = row[c] || '';
                    if (rIdx === 1 && /^:?-+/.test(val)) {
                        const left = val.startsWith(':') ? ':' : '-';
                        const right = val.endsWith(':') ? ':' : '-';
                        padded.push(left + '-'.repeat(Math.max(1, colWidths[c] - 2)) + right);
                    } else {
                        padded.push(val.padEnd(colWidths[c], ' '));
                    }
                }
                return '| ' + padded.join(' | ') + ' |';
            }).join('\n') + '\n';
        });
    },

    handleEditorKeydown: function(e, textarea) {
        if (e.altKey && !e.ctrlKey && !e.metaKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
            e.preventDefault();
            this.navigateNoteHistory(e.key === 'ArrowLeft' ? -1 : 1);
            return;
        }
        const mod = e.ctrlKey || e.metaKey;
        if (mod && e.key.toLowerCase() === 's') {
            e.preventDefault();
            this.activeContent = textarea.value;
            this.saveCurrentFile();
            return;
        }
        if (mod && e.key.toLowerCase() === 'f') {
            e.preventDefault();
            this.toggleFindBar();
            return;
        }
        const pairs = { '[': ']', '(': ')', '{': '}', '"': '"', "'": "'", '`': '`' };
        if (pairs[e.key] && !mod && !e.altKey) {
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            if (start !== end) {
                e.preventDefault();
                const sel = textarea.value.substring(start, end);
                textarea.setRangeText(e.key + sel + pairs[e.key], start, end, 'select');
                textarea.dispatchEvent(new Event('input'));
                return;
            }
        }
        if (e.key === 'Tab') {
            const pos = textarea.selectionStart;
            const lineStart = textarea.value.lastIndexOf('\n', pos - 1) + 1;
            const lineEnd = textarea.value.indexOf('\n', pos);
            const currentLine = textarea.value.substring(lineStart, lineEnd === -1 ? textarea.value.length : lineEnd);

            if (currentLine.trim().startsWith('|')) {
                e.preventDefault();
                textarea.value = this.formatAllMarkdownTables(textarea.value);
                const nextPipe = textarea.value.indexOf('|', pos + 1);
                if (nextPipe !== -1) {
                    textarea.setSelectionRange(nextPipe + 2, nextPipe + 2);
                }
            }
        }
    },

    // ------------------------------------------------------------------------
    // 8. ATTACHMENT MANAGEMENT (DYNAMICALLY CONFIGURED VIA .obsidian/app.json)
    // ------------------------------------------------------------------------
    getConfiguredAttachmentDir: function() {
        const parentDir = this.activeFile ? (this.activeFile.substring(0, this.activeFile.lastIndexOf('/')) || '/') : (myCloudState.currentDir || '/');
        const vaultRoot = this.getVaultRoot(this.activeFile || parentDir) || '/';
        const appCfg = this.getAppConfig(this.activeFile || parentDir);
        const rawSetting = (appCfg.attachmentFolderPath !== undefined) ? String(appCfg.attachmentFolderPath).trim() : './z_attachments';

        if (rawSetting === '' || rawSetting === '/') {
            return { targetDir: vaultRoot, parentToCreateIn: null, folderToCreate: null };
        }
        if (rawSetting === '.' || rawSetting === './') {
            return { targetDir: parentDir, parentToCreateIn: null, folderToCreate: null };
        }
        if (rawSetting.startsWith('./')) {
            const subName = rawSetting.substring(2).replace(/^\/+|\/+$/g, '');
            const targetDir = (parentDir === '/' ? '' : parentDir) + '/' + subName;
            return { targetDir, parentToCreateIn: parentDir, folderToCreate: subName };
        }
        const cleanRel = rawSetting.replace(/^\/+|\/+$/g, '');
        const targetDir = (vaultRoot === '/' ? '' : vaultRoot) + '/' + cleanRel;
        const lastSlash = targetDir.lastIndexOf('/');
        const parentToCreateIn = targetDir.substring(0, lastSlash) || '/';
        const folderToCreate = targetDir.substring(lastSlash + 1);
        return { targetDir, parentToCreateIn, folderToCreate };
    },

    triggerAttachmentUpload: function(textarea, wysiwygPane) {
        const inp = document.createElement('input');
        inp.type = 'file';
        inp.multiple = true;
        inp.onchange = async (e) => {
            if (e.target.files) {
                for (let f of e.target.files) {
                    await this.uploadToZAttachments(f, textarea, wysiwygPane);
                }
            }
        };
        inp.click();
    },

    uploadToZAttachments: async function(file, textarea, wysiwygPane) {
        if (!this.activeFile) return;
        const { targetDir, parentToCreateIn, folderToCreate } = this.getConfiguredAttachmentDir();

        if (parentToCreateIn && folderToCreate) {
            const mkdirFd = new URLSearchParams({
                myCloud_action: 'mkdir',
                myCloud_key: myCloudState.key,
                myCloud_token: window.myCloudCsrfToken || '',
                parent: parentToCreateIn,
                name: folderToCreate
            });
            await fetch('', { method: 'POST', body: mkdirFd }).catch(() => {});
        }

        let uploadBlob = file;
        let plainName = file.name;

        if (/^image\.(png|jpe?g|gif|webp)$/i.test(plainName)) {
            let safeTitle = 'Image';
            if (this.activeFile) {
                let dName = (myCloudState.pathNames && myCloudState.pathNames[this.activeFile]) 
                    ? myCloudState.pathNames[this.activeFile] 
                    : this.activeFile.split('/').pop().replace(/\.enc$/, '');
                dName = dName.replace(/\.md$/i, '');
                safeTitle = dName.replace(/[<>:"\/\\\\|?*\x00-\x1F]/g, '_').trim() || 'Image';
            }
            plainName = `${safeTitle} - Pasted image ${new Date().getTime()}.${ext}`;
        }
        let uploadName = plainName;

        if (typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirUnlocked(targetDir)) {
            uploadBlob = await myCloudCrypto.encryptFile(targetDir, new File([file], plainName, { type: file.type }));
            uploadName = await myCloudCrypto.encryptName(targetDir, plainName);
        }

        const upFd = new FormData();
        upFd.append('myCloud_action', 'upload');
        upFd.append('dir', targetDir);
        upFd.append('myCloud_key', myCloudState.key);
        upFd.append('myCloud_token', window.myCloudCsrfToken || '');
        upFd.append('file', uploadBlob, uploadName);
        upFd.append('resolution', 'keep_both');

        const res = await fetch('', { method: 'POST', body: upFd }).then(r => r.json());
        if (res.status === 'OK') {
            let finalName = plainName;
            if (res.file) {
                const serverName = res.file.split('/').pop();
                if (serverName.endsWith('.enc') && typeof myCloudCrypto !== 'undefined') {
                    const root = myCloudCrypto.getCryptoRoot(targetDir);
                    try { finalName = await myCloudCrypto.decryptName(root, serverName); } catch(e) { finalName = serverName.replace(/\.enc$/, ''); }
                } else {
                    finalName = serverName;
                }
            }
            const embedSyntax = `![[${finalName}]]`;
            if (this.viewMode === 'wysiwyg' && wysiwygPane) {
                const resolvedPath = this.resolveAttachmentPath(finalName);
                const safeName = finalName.replace(/"/g, '&quot;');
                document.execCommand('insertHTML', false, `<img class="ce-obs-async-img" data-path="${resolvedPath}" alt="${safeName}" style="max-width:100%;">`);
                this.postProcessPreviewDOM(wysiwygPane);
                wysiwygPane.dispatchEvent(new Event('input'));
            } else if (textarea) {
                textarea.setRangeText(embedSyntax, textarea.selectionStart, textarea.selectionEnd, 'end');
                textarea.dispatchEvent(new Event('input'));
            }
        }
    },

    resolveAttachmentPath: function(rawTarget, explicitRef = null) {
        const cleanTarget = rawTarget.split('|')[0].split('#')[0].trim();
        const referenceFile = explicitRef || this.activeFile;
        const activeParent = referenceFile ? (referenceFile.substring(0, referenceFile.lastIndexOf('/')) || '/') : myCloudState.currentDir;
        const vaultRoot = this.getVaultRoot(referenceFile || activeParent) || '/';

        if (cleanTarget.startsWith('/')) return cleanTarget;
        if (cleanTarget.includes('/')) {
            const relCandidate = (activeParent === '/' ? '' : activeParent) + '/' + cleanTarget;
            if (myCloudState.allItems && myCloudState.allItems.some(i => i.name === relCandidate)) {
                return relCandidate;
            }
            return (vaultRoot === '/' ? '' : vaultRoot) + '/' + cleanTarget;
        }

        const { targetDir } = this.getConfiguredAttachmentDir();
        return (targetDir === '/' ? '' : targetDir) + '/' + cleanTarget;
    },

    // ------------------------------------------------------------------------
    // 9. ZERO-TRUST PARSER & SHADOW DOM RENDERER
    // ------------------------------------------------------------------------
    updatePreview: async function(previewEl, signal = null) {
        if (!previewEl) return;
        const activeSignal = signal || (this.abortController ? this.abortController.signal : null);
        let md = this.convertMarkdownInsideHTML(this.activeContent || '');
        this.frontmatterRaw = '';

        // --- 1. ASYNC IMAGE SANITIZATION (Resolves 404s & fixes external Markdown images) ---
        const localRefs = [];
        const imgRegex = /<img\s+[^>]*src=["']([^"']+)["'][^>]*>/gi;
        const mdRegex = /!\[([^\]]*)\]\(([^)]+)\)/g;
        const obsRegex = /!\[\[([^\]]+)\]\]/g;
        let match;
        
        while ((match = imgRegex.exec(md)) !== null) localRefs.push({ fullMatch: match[0], src: match[1], type: 'html' });
        while ((match = mdRegex.exec(md)) !== null) localRefs.push({ fullMatch: match[0], src: match[2], alt: match[1], type: 'md' });
        while ((match = obsRegex.exec(md)) !== null) {
            const parts = match[1].split('|');
            localRefs.push({ fullMatch: match[0], src: parts[0].trim(), type: 'obs', width: parts[1] });
        }
        
        const uniqueRefs = [];
        const seen = new Set();
        for (let r of localRefs) {
            if (!seen.has(r.fullMatch)) { seen.add(r.fullMatch); uniqueRefs.push(r); }
        }
        
        for (let ref of uniqueRefs) {
            let src = ref.src.trim();
            if (!src || src.match(/^(https?:\/\/|data:|blob:|#|\?myCloud_token=)/i)) continue;
            
            try { src = decodeURIComponent(src); } catch(e) {}
            
            const plainBase = src.split('/').pop().split('?')[0].split('#')[0];
            const resolvedCandidate = this.resolveAttachmentPath(src, this.activeFile);
            const actualPath = await this.findActualAttachmentItem(resolvedCandidate, plainBase);
            
            if (activeSignal && activeSignal.aborted) return;

            if (!actualPath) {
                // DOES NOT EXIST IN VAULT -> Outside the cloud (e.g. Word export artifacts). Silently remove to prevent 404s!
                md = md.split(ref.fullMatch).join('');
            } else {
                // EXISTS IN VAULT. Convert to secure async image so it loads via PHP Token API.
                let safeAlt = '', widthStyle = 'max-width:100%;';
                if (ref.type === 'html') {
                    const altMatch = ref.fullMatch.match(/alt=["']([^"']*)["']/i), widthMatch = ref.fullMatch.match(/width=["']([^"']*)["']/i);
                    safeAlt = altMatch ? altMatch[1].replace(/"/g, '&quot;') : plainBase;
                    if (widthMatch) widthStyle = `max-width:${widthMatch[1]}px;`;
                } else if (ref.type === 'md') {
                    safeAlt = (ref.alt || plainBase).replace(/"/g, '&quot;');
                } else if (ref.type === 'obs') {
                    safeAlt = plainBase;
                    if (ref.width && /^\d+$/.test(ref.width.trim())) widthStyle = `max-width:${ref.width.trim()}px;`;
                }
                const rawMdAttr = encodeURIComponent(ref.fullMatch);
                const replacement = (plainBase.endsWith('.excalidraw') || plainBase.endsWith('.excalidraw.md')) 
                    ? `<div class="ce-obs-excalidraw-embed" contenteditable="false" data-path="${actualPath}" data-raw-md="${rawMdAttr}">🎨 ${this.L('obs_loading_excalidraw', 'Loading Excalidraw:')} ${plainBase}...</div>`
                    : `<img class="ce-obs-async-img" data-path="${actualPath}" alt="${safeAlt}" style="${widthStyle}" data-raw-md="${rawMdAttr}">`;
                md = md.split(ref.fullMatch).join(replacement);
            }
        }

        await this.ensureDependenciesForContent(md);
        if (activeSignal && activeSignal.aborted) return;

        const appCfg = this.getAppConfig(this.activeFile);
        const showFrontmatter = appCfg.showFrontmatter !== false;

        let frontmatterHtml = '';
        md = md.replace(/^(---\r?\n[\s\S]*?\r?\n---)\r?\n/, (_, rawBlock) => {
            this.frontmatterRaw = rawBlock;
            if (!showFrontmatter) return '';
            const innerYaml = rawBlock.replace(/^---\r?\n|\r?\n---$/g, '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            frontmatterHtml = `<details class="ce-obs-frontmatter" contenteditable="false" style="margin-bottom:12px; font-size:12px; color:var(--text-secondary); background:var(--gray-05); padding:6px 12px; border-radius:4px; border:1px solid var(--border-subtle);"><summary style="cursor:pointer; font-weight:600;">${this.L('obs_yaml_frontmatter', 'YAML Frontmatter')}</summary><pre style="margin:6px 0 0; white-space:pre-wrap;">${innerYaml}</pre></details>`;
            return '';
        });

        md = md.replace(/%%[\s\S]*?%%/g, '');

        md = md.replace(/---\s*start-multi-column[\s\S]*?---\s*end-multi-column/g, (block) => {
            let inner = block
                .replace(/---\s*start-multi-column[^\n]*\n?/g, '')
                .replace(/---\s*end-multi-column[^\n]*\n?/g, '')
                .replace(/```column-settings[\s\S]*?```/g, '');
            const cols = inner.split(/---\s*(?:column-break|end-column)\s*---/g);
            return `<div class="ce-obs-multicol">` + cols.map(c => `<div class="ce-obs-col">${this.parseBasicMarkdown(c)}</div>`).join('') + `</div>`;
        });

        md = md.replace(/````col\r?\n([\s\S]*?)````/g, (_, inner) => {
            const cols = inner.split(/```col-md\r?\n([\s\S]*?)```/g).filter(s => s.trim() !== '');
            return `<div class="ce-obs-multicol">` + cols.map(c => `<div class="ce-obs-col">${this.parseBasicMarkdown(c)}</div>`).join('') + `</div>`;
        });

        const trustedCodeBlocks = [];
        md = md.replace(/```([a-zA-Z0-9_-]*)([^\r\n]*)\r?\n([\s\S]*?)```/g, (fullMatch, lang, meta, code) => {
            const idx = trustedCodeBlocks.length;
            trustedCodeBlocks.push(this.renderCodeStylerBlock(lang, meta, code, fullMatch));
            return `<!--OBS_CODE_BLOCK_${idx}-->`;
        });

        // 5. Highlights ==text== & Strikethrough ~~text~~ (Pre-parsed so marked.js never leaves raw ~~)
        md = md.replace(/==([^=\n]+)==/g, '<mark class="ce-obs-highlight">$1</mark>');
        md = md.replace(/~~([^~\n]+)~~/g, '<del>$1</del>');

        md = md.replace(/\[\[([^\]]+)\]\]/g, (_, inner) => {
            const parts = inner.split('|');
            const target = parts[0].trim().replace(/"/g, '&quot;');
            const label = (parts[1] || parts[0]).trim().replace(/\.md$/i, '').replace(/</g, '&lt;');
            return `<a href="#" class="ce-obs-wikilink" data-target="${target}">${label}</a>`;
        });

        md = md.replace(/(^|\s)#([a-zA-Z0-9_\-\/]+)/g, '$1<span class="ce-obs-inline-tag">#$2</span>');

        let sanitizedBody = this.sanitizeUntrustedHTML(this.parseBasicMarkdown(md));
        sanitizedBody = sanitizedBody.replace(/<!--OBS_CODE_BLOCK_(\d+)-->/g, (_, idx) => trustedCodeBlocks[Number(idx)] || '');

        previewEl.innerHTML = frontmatterHtml + sanitizedBody;

        this.postProcessPreviewDOM(previewEl, activeSignal);
    },

    parseBasicMarkdown: function(mdText) {
        const appCfg = this.getAppConfig(this.activeFile);
        const breaks = appCfg.strictLineBreaks ? false : true;
        if (typeof window.marked !== 'undefined') {
            return window.marked.parse(mdText, { breaks: breaks, gfm: true });
        }
        return mdText
            .replace(/^##### (.*$)/gim, '<h5>$1</h5>')
            .replace(/^#### (.*$)/gim, '<h4>$1</h4>')
            .replace(/^### (.*$)/gim, '<h3>$1</h3>')
            .replace(/^## (.*$)/gim, '<h2>$1</h2>')
            .replace(/^# (.*$)/gim, '<h1>$1</h1>')
            .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/gim, '<em>$1</em>')
            .replace(/~~(.*?)~~/gim, '<del>$1</del>')
            .replace(/\n/gim, '<br>');
    },

    renderCodeStylerBlock: function(lang, meta, code, rawMatch = null) {
        meta = meta || '';
        const titleMatch = meta.match(/title:\s*"([^"]+)"/i) || meta.match(/title:(\S+)/i);
        const rawTitle = titleMatch ? titleMatch[1] : (lang || 'TEXT').toUpperCase();
        const safeTitle = rawTitle.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

        const hlSet = new Set();
        const hlMatch = meta.match(/hl:([0-9,\-]+)/i);
        if (hlMatch) {
            hlMatch[1].split(',').forEach(part => {
                if (part.includes('-')) {
                    const [s, e] = part.split('-').map(Number);
                    for (let i = s; i <= e; i++) hlSet.add(i);
                } else {
                    hlSet.add(Number(part));
                }
            });
        }

        const lines = code.replace(/\r?\n$/, '').split(/\r?\n/);
        const linesHtml = lines.map((lineText, idx) => {
            const lineNum = idx + 1;
            const isHl = hlSet.has(lineNum) ? 'highlighted' : '';
            const escaped = lineText.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return `<div class="ce-obs-code-line ${isHl}"><span class="ce-obs-line-num">${lineNum}</span><span>${escaped || ' '}</span></div>`;
        }).join('');

        const encodedRaw = encodeURIComponent(code);
        const fullMd = rawMatch || ('```' + lang + (meta ? ' ' + meta : '') + '\n' + code + '\n```');
        return `
            <div class="ce-obs-code-block" contenteditable="false" data-raw-md="${encodeURIComponent(fullMd)}" data-raw-code="${encodedRaw}">
                <div class="ce-obs-code-header">
                    <span>${safeTitle}</span>
                    <button class="ce-obs-code-copy">${this.L('copy', 'Copy')}</button>
                </div>
                <pre class="ce-obs-code-lines">${linesHtml}</pre>
            </div>
        `;
    },

    postProcessPreviewDOM: function(previewEl, signal = null) {
        const activeSignal = signal || (this.abortController ? this.abortController.signal : null);

        previewEl.querySelectorAll('.ce-obs-code-copy').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                const block = btn.closest('.ce-obs-code-block');
                if (block && block.dataset.rawCode) {
                    navigator.clipboard.writeText(decodeURIComponent(block.dataset.rawCode));
                    btn.textContent = this.L('obs_copied', 'Copied!');
                    setTimeout(() => btn.textContent = this.L('copy', 'Copy'), 1200);
                }
            };
        });

        previewEl.querySelectorAll('blockquote').forEach(bq => {
            const firstP = bq.querySelector('p');
            if (!firstP) return;
            const m = firstP.innerHTML.match(/^\[!([a-zA-Z0-9_-]+)\]([+-]?)\s*(.*)/);
            if (m) {
                const type = m[1].toLowerCase().replace(/[^a-z0-9_-]/g, '');
                const title = this.sanitizeUntrustedHTML(m[3] || type);
                firstP.innerHTML = firstP.innerHTML.replace(/^\[![^\]]+\][+-]?\s*[^\n<]*(\n|<br>)?/, '');
                const callout = document.createElement('div');
                callout.className = 'ce-obs-callout';
                callout.dataset.callout = type;
                callout.innerHTML = `<div class="ce-obs-callout-title">📌 ${title}</div>` + bq.innerHTML;
                bq.replaceWith(callout);
            }
        });

        previewEl.querySelectorAll('input[type="checkbox"]').forEach(cb => {
            cb.removeAttribute('disabled');
            cb.onchange = () => {
                this.isDirty = true;
                const dot = document.getElementById('ceObsDirtyDot');
                if (dot) dot.classList.add('active');
                this.scheduleSave(previewEl, document.getElementById('ceObsTextarea'));
            };
        });

        previewEl.querySelectorAll('table').forEach(tbl => {
            tbl.classList.add('ce-obs-table');
        });

        previewEl.querySelectorAll('img.ce-obs-async-img').forEach(async (img) => {
            const path = img.dataset.path;
            if (this.blobCache[path]) {
                img.src = this.blobCache[path];
                return;
            }
            if (activeSignal && activeSignal.aborted) return;

            const isEnc = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(path);
            const fd = new URLSearchParams({
                myCloud_action: 'get_download_token',
                myCloud_key: myCloudState.key,
                myCloud_token: window.myCloudCsrfToken || '',
                path: path,
                filename: path.split('/').pop(),
                preview: '1'
            });
            try {
                const res = await fetch('', { method: 'POST', body: fd, signal: activeSignal }).then(r => r.json());
                if (activeSignal && activeSignal.aborted) return;
                if (res.status === 'OK') {
                    const dlResp = await fetch('?myCloud_token=' + res.token, { signal: activeSignal });
                    if (activeSignal && activeSignal.aborted) return;
                    let blob = await dlResp.blob();
                    if (isEnc) {
                        const root = myCloudCrypto.getCryptoRoot(path);
                        blob = await myCloudCrypto.decryptFile(root, blob);
                    }
                    if (activeSignal && activeSignal.aborted) return;
                    const objUrl = URL.createObjectURL(blob);
                    this.blobCache[path] = objUrl;
                    img.src = objUrl;
                }
            } catch (e) {}
        });

        previewEl.querySelectorAll('.ce-obs-excalidraw-embed').forEach(async (el) => {
            await this.renderExcalidrawEmbed(el, el.dataset.path, activeSignal);
        });

        // G. Word-Processor Link Following (Ctrl/Cmd+Click, Hover Popover, and Touch Tap Popover)
        this.bindWordProcessorLinks(previewEl);
    },

    followObsidianLink: async function(linkEl) {
        if (!linkEl) return;
        if (linkEl.classList.contains('ce-obs-wikilink')) {
            let rawTarget = (linkEl.dataset.target || linkEl.textContent || '').split('#')[0].trim();
            if (!rawTarget) return;
            const vaultRoot = this.getVaultRoot(this.activeFile) || '/';
            await this.ensureVaultIndexLoaded(vaultRoot);

            const cleanTargetNoExt = rawTarget.replace(/\.md$/i, '');
            const targetWithExt = cleanTargetNoExt + '.md';
            const activeParent = this.activeFile ? (this.activeFile.substring(0, this.activeFile.lastIndexOf('/')) || '/') : vaultRoot;

            // 1. Check relative to current folder or vault root
            const directCandidates = [
                rawTarget.startsWith('/') ? targetWithExt : (activeParent === '/' ? '' : activeParent) + '/' + targetWithExt,
                (vaultRoot === '/' ? '' : vaultRoot) + '/' + targetWithExt.replace(/^\/+/, '')
            ];
            for (let cand of directCandidates) {
                if ((myCloudState.allItems || []).some(i => i.name === cand)) {
                    this.openFileInRightPane(cand);
                    return;
                }
            }

            // 2. Search across the entire vault by decrypted/plain filename or relative path
            const lowerTarget = cleanTargetNoExt.toLowerCase();
            const match = (myCloudState.allItems || []).find(i => {
                if (i.size === 'DIR') return false;
                if (vaultRoot !== '/' && !i.name.startsWith(vaultRoot + '/')) return false;
                const dName = (i.displayName || (myCloudState.pathNames && myCloudState.pathNames[i.name]) || i.name.split('/').pop()).replace(/\.enc$/, '').replace(/\.md$/i, '');
                const relVault = (vaultRoot === '/' ? i.name.substring(1) : i.name.substring(vaultRoot.length + 1)).replace(/\.enc$/, '').replace(/\.md$/i, '');
                return dName.toLowerCase() === lowerTarget || relVault.toLowerCase() === lowerTarget;
            });

            if (match) {
                this.openFileInRightPane(match.name);
            } else {
                this.openFileInRightPane(directCandidates[0]);
            }
        } else {
            const href = linkEl.getAttribute('href');
            if (href && href !== '#') {
                this.openExternalUrl(href);
            }
        }
    },

    showLinkPopover: function(linkEl, previewEl) {
        const ws = document.querySelector('.ce-obs-workspace');
        if (!ws || !linkEl) return;
        let pop = ws.querySelector('#ceObsLinkPopover');
        if (pop) pop.remove();

        const isWiki = linkEl.classList.contains('ce-obs-wikilink');
        const targetLabel = isWiki ? ('[[' + (linkEl.dataset.target || linkEl.textContent) + ']]') : (linkEl.getAttribute('href') || '');
        if (!targetLabel) return;

        pop = document.createElement('div');
        pop.id = 'ceObsLinkPopover';
        pop.className = 'ce-obs-link-popover';

        const safeLabel = targetLabel.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        pop.innerHTML = `
            <span class="ce-obs-link-popover-url" id="ceObsLinkPopOpen" title="${safeLabel}">${safeLabel} ↗</span>
            <button type="button" class="ce-obs-link-popover-btn" id="ceObsLinkPopCopy">${this.L('copy', 'Copy')}</button>
            <button type="button" class="ce-obs-link-popover-btn" id="ceObsLinkPopUnlink">✕</button>
        `;

        ws.appendChild(pop);

        const wsRect = ws.getBoundingClientRect();
        const linkRect = linkEl.getBoundingClientRect();
        let left = linkRect.left - wsRect.left;
        let top = linkRect.bottom - wsRect.top + 6;
        if (left + pop.offsetWidth > wsRect.width - 10) left = wsRect.width - pop.offsetWidth - 10;
        if (left < 8) left = 8;
        if (top + pop.offsetHeight > wsRect.height - 10) top = linkRect.top - wsRect.top - pop.offsetHeight - 6;

        pop.style.left = left + 'px';
        pop.style.top = top + 'px';

        pop.querySelector('#ceObsLinkPopOpen').onclick = (e) => {
            e.stopPropagation();
            pop.remove();
            this.followObsidianLink(linkEl);
        };
        pop.querySelector('#ceObsLinkPopCopy').onclick = (e) => {
            e.stopPropagation();
            navigator.clipboard.writeText(isWiki ? (linkEl.dataset.target || linkEl.textContent) : (linkEl.getAttribute('href') || ''));
            pop.remove();
        };
        pop.querySelector('#ceObsLinkPopUnlink').onclick = (e) => {
            e.stopPropagation();
            const parent = linkEl.parentNode;
            while (linkEl.firstChild) parent.insertBefore(linkEl.firstChild, linkEl);
            parent.removeChild(linkEl);
            pop.remove();
            if (previewEl) previewEl.dispatchEvent(new Event('input'));
        };
    },

    bindWordProcessorLinks: function(previewEl) {
        let hideTimer = null;
        previewEl.querySelectorAll('a').forEach(link => {
            // 1. Desktop Ctrl+Click / Cmd+Click (or click when read-only) follows link immediately; normal click edits text & shows popover
            link.onclick = (e) => {
                e.preventDefault();
                const canEdit = window.myCloudActionAllowed('edit_file');
                if (e.ctrlKey || e.metaKey || !canEdit) {
                    this.followObsidianLink(link);
                } else {
                    this.showLinkPopover(link, previewEl);
                }
            };

            // 2. Desktop Hover shows the word-processor link pill
            link.addEventListener('mouseenter', () => {
                clearTimeout(hideTimer);
                this.showLinkPopover(link, previewEl);
            });
            link.addEventListener('mouseleave', () => {
                hideTimer = setTimeout(() => {
                    const pop = document.getElementById('ceObsLinkPopover');
                    if (pop && !pop.matches(':hover')) pop.remove();
                }, 350);
            });

            // 3. Touch / Mobile tap opens the link popover immediately so user can tap "Open ↗" or edit
            link.addEventListener('touchend', (e) => {
                e.stopPropagation();
                this.showLinkPopover(link, previewEl);
            }, { passive: true });
        });
    },

    renderExcalidrawEmbed: async function(containerEl, path, signal = null) {
        try {
            if (signal && signal.aborted) return;
            await this.ensureDependenciesForContent('.excalidraw');
            if (signal && signal.aborted) return;

            const fd = new URLSearchParams({
                myCloud_action: 'edit-fetch',
                myCloud_key: myCloudState.key,
                myCloud_token: window.myCloudCsrfToken || '',
                path: path
            });
            const res = await fetch('', { method: 'POST', body: fd, signal }).then(r => r.json());
            if (signal && signal.aborted) return;

            if (res.status !== 'OK' || !res.content) {
                containerEl.textContent = ' ️ ' + this.L('obs_excalidraw_missing', 'Excalidraw file not found:') + ' ' + path;
                return;
            }

            let raw = res.content;
            const jsonMatch = raw.match(/```json\r?\n([\s\S]*?)```/);
            const compMatch = raw.match(/```compressed-json\r?\n([\s\S]*?)```/);

            let scene = null;
            if (jsonMatch) {
                scene = JSON.parse(jsonMatch[1]);
            } else if (compMatch && typeof window.LZString !== 'undefined') {
                scene = JSON.parse(window.LZString.decompressFromBase64(compMatch[1].replace(/\s+/g, '')));
            } else {
                scene = JSON.parse(raw);
            }

            if (scene && Array.isArray(scene.elements)) {
                containerEl.innerHTML = this.excalidrawElementsToSVG(scene.elements);
            }
        } catch (e) {
            if (e && e.name === 'AbortError') return;
            containerEl.textContent = ' ️ ' + this.L('obs_excalidraw_err', 'Unable to render Excalidraw drawing.');
        }
    },

    excalidrawElementsToSVG: function(elements) {
        const visible = elements.filter(e => !e.isDeleted);
        if (visible.length === 0) return `<div>${this.L('obs_excalidraw_empty', 'Empty Excalidraw Canvas')}</div>`;

        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        visible.forEach(el => {
            minX = Math.min(minX, Number(el.x) || 0);
            minY = Math.min(minY, Number(el.y) || 0);
            maxX = Math.max(maxX, (Number(el.x) || 0) + (Number(el.width) || 100));
            maxY = Math.max(maxY, (Number(el.y) || 0) + (Number(el.height) || 60));
        });

        const pad = 20;
        const w = Math.max(200, (maxX - minX) + pad * 2);
        const h = Math.max(100, (maxY - minY) + pad * 2);

        const escAttr = (v) => String(v || '').replace(/[^a-zA-Z0-9#(),.\-%\s]/g, '');
        let svgShapes = '';
        visible.forEach(el => {
            const x = (Number(el.x) || 0) - minX + pad;
            const y = (Number(el.y) || 0) - minY + pad;
            const stroke = escAttr(el.strokeColor || '#1e1e1e');
            const fill = (el.backgroundColor && el.backgroundColor !== 'transparent') ? escAttr(el.backgroundColor) : 'none';

            if (el.type === 'rectangle') {
                svgShapes += `<rect x="${x}" y="${y}" width="${Number(el.width) || 80}" height="${Number(el.height) || 50}" rx="4" stroke="${stroke}" fill="${fill}" stroke-width="${Number(el.strokeWidth) || 2}"/>`;
            } else if (el.type === 'ellipse') {
                const rx = (Number(el.width) || 60) / 2, ry = (Number(el.height) || 60) / 2;
                svgShapes += `<ellipse cx="${x + rx}" cy="${y + ry}" rx="${rx}" ry="${ry}" stroke="${stroke}" fill="${fill}" stroke-width="${Number(el.strokeWidth) || 2}"/>`;
            } else if (el.type === 'text') {
                const safeTxt = String(el.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                svgShapes += `<text x="${x}" y="${y + (Number(el.fontSize) || 16)}" fill="${stroke}" font-size="${Number(el.fontSize) || 16}" font-family="sans-serif">${safeTxt}</text>`;
            }
        });

        return `<svg viewBox="0 0 ${w} ${h}" style="max-width:100%; height:auto; background:#fff; border:1px solid var(--border-default); border-radius:6px; margin:10px 0;">${svgShapes}</svg>`;
    },

    // ------------------------------------------------------------------------
    // 10. SAVING MARKDOWN FILE (SUPPORTS BACKGROUND AUTOSAVE SNAPSHOTS)
    // ------------------------------------------------------------------------
    saveCurrentFile: async function(explicitPath = null, explicitContent = null) {
        const targetFile = explicitPath || this.activeFile;
        let targetContent = explicitContent !== null ? explicitContent : this.activeContent;
        targetContent = this.convertMarkdownInsideHTML(targetContent);
        if (!targetFile) return;

        if (!explicitPath) {
            clearTimeout(this.idleSaveTimer);
            clearTimeout(this.forceSaveTimer);
            this.forceSaveTimer = null;
        }

        const isEnc = typeof myCloudCrypto !== 'undefined' && myCloudCrypto.isDirEncrypted(targetFile);
        try {
            if (isEnc) {
                const root = myCloudCrypto.getCryptoRoot(targetFile);
                const filename = targetFile.split('/').pop();
                const parentDir = targetFile.substring(0, targetFile.lastIndexOf('/')) || '/';
                const plainFile = new File([new Blob([targetContent], { type: 'text/markdown' })], filename);
                const encBlob = await myCloudCrypto.encryptFile(root, plainFile);

                const upFd = new FormData();
                upFd.append('myCloud_action', 'upload');
                upFd.append('dir', parentDir);
                upFd.append('myCloud_key', myCloudState.key);
                upFd.append('myCloud_token', window.myCloudCsrfToken || '');
                upFd.append('file', encBlob, filename);
                upFd.append('resolution', 'overwrite');

                const res = await fetch('', { method: 'POST', body: upFd, keepalive: true }).then(r => r.json());
                if (res.status !== 'OK') throw new Error(res.msg || this.L('upload_failed', 'Upload error'));
            } else {
                const fd = new URLSearchParams({
                    myCloud_action: 'edit-save',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    path: targetFile,
                    content: targetContent
                });
                const res = await fetch('', { method: 'POST', body: fd, keepalive: true }).then(r => r.json());
                if (res.status !== 'OK') throw new Error(res.msg || this.L('obs_save_error', 'Save error'));
            }

            if (targetFile === this.activeFile) {
                this.originalContent = targetContent;
                this.isDirty = false;
                const dot = document.getElementById('ceObsDirtyDot');
                if (dot) dot.classList.remove('active');
            }
        } catch (e) {
            if (typeof myCloudShowAlert === 'function') myCloudShowAlert(this.L('error_lbl', 'Error'), e.message);
        }
    },

    promptNewVault: function(parentDir) {
        myCloudShowInputModal(
            this.L('obs_new_vault', 'New Knowledge Base (Vault)'),
            this.L('name', 'Name:'),
            'My Knowledge Base',
            async (rawTitle) => {
                let title = rawTitle.trim();
                if (!title) return;

                const fd = new URLSearchParams({
                    myCloud_action: 'mkobsvault',
                    myCloud_key: myCloudState.key,
                    myCloud_token: window.myCloudCsrfToken || '',
                    parent: parentDir,
                    name: title
                });

                const res = await fetch('', { method: 'POST', body: fd }).then(r => r.json());
                if (res.status === 'OK') {
                    await myCloudFetchDirectory(parentDir, 2, true);
                    if (typeof myCloudRenderUI === 'function') myCloudRenderUI();
                } else {
                    myCloudShowAlert(this.L('error_lbl', 'Error'), res.msg || 'Failed to create vault.');
                }
            },
            true
        );
    },	
};
</script>